.venv/
.idea/

# emulator e2e (Playwright)
emulator/node_modules/
emulator/e2e/test-results/
emulator/e2e/screens/
emulator/playwright-report/
__pycache__/
.pytest_cache/

# Bought Meshy boss files the titan does not use (task ids in art/boss/meshy_tasks.json)
art/boss/unused/

# Meshy cannon sources besides the imported FBX (task ids in art/cannon/meshy_tasks.json)
art/cannon/raw/*
!art/cannon/raw/cannon.fbx

# Playwright MCP session logs/snapshots (created when agents browse)
.playwright-mcp/

# Meshy mascot sources besides the clip FBX files tools/import_mascot.py reads (task ids in art/mascot/meshy_tasks.json)
art/mascot/raw/rig.fbx
art/mascot/raw/volt_tpose.glb
art/mascot/raw/volt_tpose_base_color.png
art/mascot/raw/*.fbm/

# Mint audio: the processed wavs (about 100 MB) are rebuilt byte for byte from the tracked art/audio/mint/*.mp3 by
# tools/make_mint_audio.py; tools/audio/mint/LISTEN.md says which take is in.
tools/audio/mint/*.wav

# Titan Peak, volcano, trophy (2026-10-13; task ids in each folder's meshy_tasks.json): the importers read the GLBs (re-exported
# to *_blender.fbx by headless Blender), the arch skins' base colours and the Mint maps' base / normal / roughness PNGs;
# everything else here is derived or unread.
art/titanpeak/**/*_blender.fbx
art/titanpeak/**/*.fbm/
art/titanpeak/arch/raw/arch_t[2-5].glb
art/titanpeak/materials/*.zip
art/titanpeak/materials/**/04-metalness-*
art/titanpeak/materials/**/05-height-*
art/titanpeak/gate/raw/*_base_color.png
art/titanpeak/podium/raw/*_base_color.png
art/titanpeak/set/raw/*_base_color.png
art/volcano/raw/*.fbx
art/volcano/raw/*.fbm/
art/volcano/raw/*_base_color.png
art/trophy/raw/*.fbx
art/trophy/raw/*.fbm/
art/trophy/raw/*_base_color.png
