.venv/
.idea/

# emulator e2e (Playwright)
emulator/node_modules/
emulator/e2e/test-results/
emulator/e2e/screens/
emulator/playwright-report/
__pycache__/
.pytest_cache/

# Bought Meshy boss files the titan does not use (task ids in art/boss/meshy_tasks.json)
art/boss/unused/

# Meshy cannon sources besides the imported FBX (task ids in art/cannon/meshy_tasks.json)
art/cannon/raw/*
!art/cannon/raw/cannon.fbx

# Playwright MCP session logs/snapshots (created when agents browse)
.playwright-mcp/

# Meshy mascot sources besides the clip FBX files tools/import_mascot.py reads (task ids in art/mascot/meshy_tasks.json)
art/mascot/raw/rig.fbx
art/mascot/raw/volt_tpose.glb
art/mascot/raw/volt_tpose_base_color.png
art/mascot/raw/*.fbm/
