  "items_per_tier": 24,
  "bounds": "Facts bounds (PROTOCOL 4c, briefs/facts2): the whole run inside sums 1 to 10, easy to hard by tier. Prompt forms: R 'a + b = ?' (answer s), C 'a + ? = s' (answer b), S '? + b = s' (answer a); every number a non-negative integer. T1 R, a or b <= 2 (0 allowed). T2 R, a, b >= 2. T3 R with a, b >= 3 (>= 8) plus C and S on the ten pairs a + (10 - a) (>= 4 each). T4 C, a, b >= 1. T5 S (>= 12) and C, a, b >= 2 and sums 5 to 10. Prompts unique per tier, 24 per tier. Wrong choices: distinct non-negative integers <= 999, >= 2 near the answer (+-1, +-2, +-10), at most 1 far; answer rank among the 4 values 15-35% each per tier; answers >= 20 always have a wrong choice sharing the ones digit (+-10); the answer is never the only value of its parity.",
  "tiers": [
    {
      "tier": 1,
      "name": "Plus 0, 1, 2",
      "description": "Adding 0, 1 or 2: the next number, or no change."
    },
    {
      "tier": 2,
      "name": "Sums to 10",
      "description": "Every sum up to 10 with both numbers 2 or more."
    },
    {
      "tier": 3,
      "name": "Make ten",
      "description": "Sums of 3 or more, and the pairs that make ten."
    },
    {
      "tier": 4,
      "name": "Missing numbers",
      "description": "Find the second number: 4 + ? = 9."
    },
    {
      "tier": 5,
      "name": "Missing first numbers",
      "description": "Find the first number: ? + 3 = 8."
    }
  ],
  "misconceptions": {
    "ONE_OFF": {
      "student": "Off by one. Count again: start at the bigger number and count up.",
      "teacher": "Counted on wrong: the sum is one more or one less than the true sum."
    },
    "SUBTRACTED": {
      "student": "Plus means put together. Add the two numbers, don't take them apart.",
      "teacher": "Subtracted the smaller addend from the larger instead of adding: 8 + 5 = 3."
    },
    "MISSING_ADDED": {
      "student": "Don't add the two numbers you see. Find the missing one: subtract.",
      "teacher": "Added the shown number and the total instead of subtracting: 7 + ? = 15 answered 22."
    },
    "MISSING_ONE_OFF": {
      "student": "Off by one. Add your answer to the shown number and check the total.",
      "teacher": "Counted up wrong: the missing number is one more or one less than the true one."
    }
  },
