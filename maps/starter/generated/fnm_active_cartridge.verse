        fnm_item{Id := "rational-ops/t4/001", Tier := 4, Prompt := "Write 8/9 as a decimal.", Choices := array{"1.125", "0.111...", "0.888...", "0.8"}, Answer := 2, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "3/4 is three quarters, not one. Use the top number too.", "", "It repeats forever. Keep the dots: 2/3 is 0.666..."}, Explanation := "8 ÷ 9 repeats forever: 0.888..."},
        fnm_item{Id := "rational-ops/t4/002", Tier := 4, Prompt := "−11/20 as a decimal?", Choices := array{"0.55", "−0.55", "−0.05", "−0.112"}, Answer := 1, Feedback := array{"Keep the negative: a negative fraction has a negative decimal.", "", "3/4 is three quarters, not one. Use the top number too.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4."}, Explanation := "11/20 = 55/100 = 0.55, so −0.55."},
        fnm_item{Id := "rational-ops/t4/003", Tier := 4, Prompt := "Write −12/25 as a decimal.", Choices := array{"−0.48", "−0.1225", "−4.8", "−0.04"}, Answer := 0, Feedback := array{"", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Do the digits, then put the decimal point back by counting places.", "3/4 is three quarters, not one. Use the top number too."}, Explanation := "12/25 = 48/100 = 0.48, so −0.48."},
        fnm_item{Id := "rational-ops/t4/004", Tier := 4, Prompt := "4/9 as a decimal?", Choices := array{"0.444...", "0.9", "0.111...", "2.25"}, Answer := 0, Feedback := array{"", "The top number counts too. Divide the top by the bottom.", "3/4 is three quarters, not one. Use the top number too.", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "4 ÷ 9 repeats forever: 0.444..."},
        fnm_item{Id := "rational-ops/t4/005", Tier := 4, Prompt := "−4/9 as a decimal?", Choices := array{"−2.25", "0.444...", "−0.9", "−0.444..."}, Answer := 3, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "Keep the negative: a negative fraction has a negative decimal.", "The top number counts too. Divide the top by the bottom.", ""}, Explanation := "4 ÷ 9 repeats forever: 0.444..., so −0.444..."},
        fnm_item{Id := "rational-ops/t4/006", Tier := 4, Prompt := "7/20 as a decimal?", Choices := array{"0.05", "0.72", "0.35", "3.5"}, Answer := 2, Feedback := array{"3/4 is three quarters, not one. Use the top number too.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "", "Do the digits, then put the decimal point back by counting places."}, Explanation := "7/20 = 35/100 = 0.35."},
        fnm_item{Id := "rational-ops/t4/007", Tier := 4, Prompt := "3/4 as a decimal?", Choices := array{"0.34", "1.333...", "0.75", "7.5"}, Answer := 2, Feedback := array{"3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "", "Do the digits, then put the decimal point back by counting places."}, Explanation := "3/4 = 75/100 = 0.75."},
        fnm_item{Id := "rational-ops/t4/008", Tier := 4, Prompt := "Write 4/25 as a decimal.", Choices := array{"1.6", "0.425", "0.16", "6.25"}, Answer := 2, Feedback := array{"Do the digits, then put the decimal point back by counting places.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "4/25 = 16/100 = 0.16."},
        fnm_item{Id := "rational-ops/t4/009", Tier := 4, Prompt := "3/20 as a decimal?", Choices := array{"1.5", "0.15", "6.666...", "0.32"}, Answer := 1, Feedback := array{"Do the digits, then put the decimal point back by counting places.", "", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4."}, Explanation := "3/20 = 15/100 = 0.15."},
        fnm_item{Id := "rational-ops/t4/010", Tier := 4, Prompt := "Convert −3/4 to a decimal.", Choices := array{"−7.5", "−0.75", "−0.34", "−1.333..."}, Answer := 1, Feedback := array{"Do the digits, then put the decimal point back by counting places.", "", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "3/4 = 75/100 = 0.75, so −0.75."},
        fnm_item{Id := "rational-ops/t4/011", Tier := 4, Prompt := "−1/2 as a decimal?", Choices := array{"−5", "−2", "−0.12", "−0.5"}, Answer := 3, Feedback := array{"Do the digits, then put the decimal point back by counting places.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", ""}, Explanation := "1/2 = 5/10 = 0.5, so −0.5."},
        fnm_item{Id := "rational-ops/t4/012", Tier := 4, Prompt := "3/5 as a decimal?", Choices := array{"6", "0.35", "1.666...", "0.6"}, Answer := 3, Feedback := array{"Do the digits, then put the decimal point back by counting places.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", ""}, Explanation := "3/5 = 6/10 = 0.6."},
        fnm_item{Id := "rational-ops/t4/013", Tier := 4, Prompt := "−2/9 as a decimal?", Choices := array{"0.222...", "−4.5", "−0.9", "−0.222..."}, Answer := 3, Feedback := array{"Keep the negative: a negative fraction has a negative decimal.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "The top number counts too. Divide the top by the bottom.", ""}, Explanation := "2 ÷ 9 repeats forever: 0.222..., so −0.222..."},
        fnm_item{Id := "rational-ops/t4/014", Tier := 4, Prompt := "Write −8/9 as a decimal.", Choices := array{"−1.125", "−0.888...", "−0.8", "0.888..."}, Answer := 1, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "", "It repeats forever. Keep the dots: 2/3 is 0.666...", "Keep the negative: a negative fraction has a negative decimal."}, Explanation := "8 ÷ 9 repeats forever: 0.888..., so −0.888..."},
        fnm_item{Id := "rational-ops/t4/015", Tier := 4, Prompt := "Which equals −5/11?", Choices := array{"(−5)/11", "(−11)/5", "−5/(−11)"}, Answer := 0, Feedback := array{"", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "A negative on top AND bottom makes it positive."}, Explanation := "A minus sign on the top, the bottom or the front means the same: −5/11 = (−5)/11."},
        fnm_item{Id := "rational-ops/t4/016", Tier := 4, Prompt := "Which equals 9/10?", Choices := array{"9/(−10)", "10/9", "(−9)/(−10)"}, Answer := 2, Feedback := array{"One negative sign makes it negative. You need two to get positive.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", ""}, Explanation := "Two negatives cancel: (−9)/(−10) = 9/10."},
        fnm_item{Id := "rational-ops/t4/017", Tier := 4, Prompt := "Which equals 2/3?", Choices := array{"−2/(−3)", "(−2)/3", "3/2"}, Answer := 0, Feedback := array{"", "One negative sign makes it negative. You need two to get positive.", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "Two negatives cancel: −2/(−3) = 2/3."},
        fnm_item{Id := "rational-ops/t4/018", Tier := 4, Prompt := "1/2 as a decimal?", Choices := array{"0.5", "2", "5", "0.12"}, Answer := 0, Feedback := array{"", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "Do the digits, then put the decimal point back by counting places.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4."}, Explanation := "1/2 = 5/10 = 0.5."},
        fnm_item{Id := "rational-ops/t4/019", Tier := 4, Prompt := "−1/4 as a decimal?", Choices := array{"−4", "−0.14", "−0.25", "0.25"}, Answer := 2, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "", "Keep the negative: a negative fraction has a negative decimal."}, Explanation := "1/4 = 25/100 = 0.25, so −0.25."},
        fnm_item{Id := "rational-ops/t4/020", Tier := 4, Prompt := "Which equals −2/5?", Choices := array{"2/5", "(−2)/5", "(−5)/2"}, Answer := 1, Feedback := array{"Keep the negative: a negative fraction has a negative decimal.", "", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "A minus sign on the top, the bottom or the front means the same: −2/5 = (−2)/5."},
        fnm_item{Id := "rational-ops/t4/021", Tier := 4, Prompt := "Which equals 3/11?", Choices := array{"3/(−11)", "−3/(−11)", "11/3"}, Answer := 1, Feedback := array{"One negative sign makes it negative. You need two to get positive.", "", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "Two negatives cancel: −3/(−11) = 3/11."},
        fnm_item{Id := "rational-ops/t4/022", Tier := 4, Prompt := "Convert −1/10 to a decimal.", Choices := array{"−0.1", "−1", "−10", "0.1"}, Answer := 0, Feedback := array{"", "Do the digits, then put the decimal point back by counting places.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "Keep the negative: a negative fraction has a negative decimal."}, Explanation := "1/10 = 0.1, so −0.1."},
        fnm_item{Id := "rational-ops/t4/023", Tier := 4, Prompt := "Convert 7/25 to a decimal.", Choices := array{"0.28", "0.725", "0.04", "2.8"}, Answer := 0, Feedback := array{"", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "3/4 is three quarters, not one. Use the top number too.", "Do the digits, then put the decimal point back by counting places."}, Explanation := "7/25 = 28/100 = 0.28."},
        fnm_item{Id := "rational-ops/t4/024", Tier := 4, Prompt := "Convert 4/5 to a decimal.", Choices := array{"1.25", "0.8", "0.45", "8"}, Answer := 1, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Do the digits, then put the decimal point back by counting places."}, Explanation := "4/5 = 8/10 = 0.8."},
        fnm_item{Id := "rational-ops/t4/025", Tier := 4, Prompt := "Convert −2/3 to a decimal.", Choices := array{"−0.333...", "−1.5", "−0.666...", "−0.6"}, Answer := 2, Feedback := array{"3/4 is three quarters, not one. Use the top number too.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "", "It repeats forever. Keep the dots: 2/3 is 0.666..."}, Explanation := "2 ÷ 3 repeats forever: 0.666..., so −0.666..."},
        fnm_item{Id := "rational-ops/t4/026", Tier := 4, Prompt := "1/5 as a decimal?", Choices := array{"0.2", "0.5", "5", "0.15"}, Answer := 0, Feedback := array{"", "The top number counts too. Divide the top by the bottom.", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4."}, Explanation := "1/5 = 2/10 = 0.2."},
        fnm_item{Id := "rational-ops/t4/027", Tier := 4, Prompt := "−1/3 as a decimal?", Choices := array{"−3", "−0.333...", "−0.13", "0.333..."}, Answer := 1, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Keep the negative: a negative fraction has a negative decimal."}, Explanation := "1 ÷ 3 repeats forever: 0.333..., so −0.333..."},
        fnm_item{Id := "rational-ops/t4/028", Tier := 4, Prompt := "−7/9 as a decimal?", Choices := array{"−0.111...", "−0.777...", "−0.9", "−0.7"}, Answer := 1, Feedback := array{"3/4 is three quarters, not one. Use the top number too.", "", "The top number counts too. Divide the top by the bottom.", "It repeats forever. Keep the dots: 2/3 is 0.666..."}, Explanation := "7 ÷ 9 repeats forever: 0.777..., so −0.777..."},
        fnm_item{Id := "rational-ops/t4/029", Tier := 4, Prompt := "Write 2/3 as a decimal.", Choices := array{"1.5", "0.23", "0.6", "0.666..."}, Answer := 3, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "It repeats forever. Keep the dots: 2/3 is 0.666...", ""}, Explanation := "2 ÷ 3 repeats forever: 0.666..."},
        fnm_item{Id := "rational-ops/t4/030", Tier := 4, Prompt := "Which equals −5/8?", Choices := array{"(−8)/5", "5/8", "(−5)/8"}, Answer := 2, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "Keep the negative: a negative fraction has a negative decimal.", ""}, Explanation := "A minus sign on the top, the bottom or the front means the same: −5/8 = (−5)/8."},
        fnm_item{Id := "rational-ops/t4/031", Tier := 4, Prompt := "Convert −4/25 to a decimal.", Choices := array{"−6.25", "0.16", "−0.425", "−0.16"}, Answer := 3, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "Keep the negative: a negative fraction has a negative decimal.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", ""}, Explanation := "4/25 = 16/100 = 0.16, so −0.16."},
        fnm_item{Id := "rational-ops/t4/032", Tier := 4, Prompt := "−7/25 as a decimal?", Choices := array{"−0.725", "0.28", "−0.28", "−2.8"}, Answer := 2, Feedback := array{"3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Keep the negative: a negative fraction has a negative decimal.", "", "Do the digits, then put the decimal point back by counting places."}, Explanation := "7/25 = 28/100 = 0.28, so −0.28."},
        fnm_item{Id := "rational-ops/t4/033", Tier := 4, Prompt := "Write −3/5 as a decimal.", Choices := array{"−1.666...", "−0.35", "−6", "−0.6"}, Answer := 3, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "Do the digits, then put the decimal point back by counting places.", ""}, Explanation := "3/5 = 6/10 = 0.6, so −0.6."},
        fnm_item{Id := "rational-ops/t4/034", Tier := 4, Prompt := "Write −11/25 as a decimal.", Choices := array{"0.44", "−4.4", "−0.1125", "−0.44"}, Answer := 3, Feedback := array{"Keep the negative: a negative fraction has a negative decimal.", "Do the digits, then put the decimal point back by counting places.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", ""}, Explanation := "11/25 = 44/100 = 0.44, so −0.44."},
        fnm_item{Id := "rational-ops/t4/035", Tier := 4, Prompt := "Convert 2/5 to a decimal.", Choices := array{"0.25", "0.2", "0.4", "2.5"}, Answer := 2, Feedback := array{"3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4.", "3/4 is three quarters, not one. Use the top number too.", "", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "2/5 = 4/10 = 0.4."},
        fnm_item{Id := "rational-ops/t4/036", Tier := 4, Prompt := "Convert −2/25 to a decimal.", Choices := array{"−0.08", "−12.5", "0.08", "−0.225"}, Answer := 0, Feedback := array{"", "Upside down: a/b means a ÷ b, the top divided by the bottom.", "Keep the negative: a negative fraction has a negative decimal.", "3/4 is not 0.34. Divide the top by the bottom: 3 ÷ 4."}, Explanation := "2/25 = 8/100 = 0.08, so −0.08."},
        fnm_item{Id := "rational-ops/t4/037", Tier := 4, Prompt := "Write 5/9 as a decimal.", Choices := array{"1.8", "0.555...", "0.5", "0.111..."}, Answer := 1, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "", "It repeats forever. Keep the dots: 2/3 is 0.666...", "3/4 is three quarters, not one. Use the top number too."}, Explanation := "5 ÷ 9 repeats forever: 0.555..."},
        fnm_item{Id := "rational-ops/t4/038", Tier := 4, Prompt := "Which equals 2/5?", Choices := array{"5/2", "−2/(−5)", "(−2)/5"}, Answer := 1, Feedback := array{"Upside down: a/b means a ÷ b, the top divided by the bottom.", "", "One negative sign makes it negative. You need two to get positive."}, Explanation := "Two negatives cancel: −2/(−5) = 2/5."},
        fnm_item{Id := "rational-ops/t4/039", Tier := 4, Prompt := "Convert 1/10 to a decimal.", Choices := array{"0.1", "0.2", "1", "10"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Do the digits, then put the decimal point back by counting places.", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "1/10 = 0.1."},
        fnm_item{Id := "rational-ops/t4/040", Tier := 4, Prompt := "Which equals −3/7?", Choices := array{"(−3)/7", "−3/(−7)", "(−7)/3"}, Answer := 0, Feedback := array{"", "A negative on top AND bottom makes it positive.", "Upside down: a/b means a ÷ b, the top divided by the bottom."}, Explanation := "A minus sign on the top, the bottom or the front means the same: −3/7 = (−3)/7."},
        fnm_item{Id := "rational-ops/t5/001", Tier := 5, Prompt := "Account changes −$0.50 a day for 8 days. Total?", Choices := array{"$7.50", "−$4", "$4", "−$0.40"}, Answer := 1, Feedback := array{"× means groups of, not +. Multiply the two numbers.", "", "One negative makes it negative. Two negatives make it positive.", "Do the digits, then put the decimal point back by counting places."}, Explanation := "8 groups of −$0.50: one negative, so negative. Digits 5 × 8 = 40, so −$4."},
        fnm_item{Id := "rational-ops/t5/002", Tier := 5, Prompt := "Temp is 3 degrees, then drops 3.9 degrees. Now?", Choices := array{"−0.9", "0.9", "−6.9", "6.9"}, Answer := 0, Feedback := array{"", "Right size, wrong sign. Which number is farther from 0?", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Read the story: down or spend means subtract, up or deposit means add."}, Explanation := "Drops means subtract. Subtracting 3.9 is adding −3.9. Signs differ: 3.9 − 3 = 0.9, and the bigger one is negative, so −0.9."},
        fnm_item{Id := "rational-ops/t5/003", Tier := 5, Prompt := "Diver at −2/5 m dives 9/10 m deeper. New elevation?", Choices := array{"−1/2", "−1 1/10", "1/2", "−1 3/10"}, Answer := 3, Feedback := array{"Same signs: add the sizes and keep the sign. Don\'t subtract.", "Rename BOTH with the same bottom first: 1/2 is 2/4, not 1/4.", "Read the story: down or spend means subtract, up or deposit means add.", ""}, Explanation := "Deeper means subtract. Subtracting 9/10 is adding −9/10. Common bottom 10: −4/10 + (−9/10) = −13/10 = −1 3/10."},
        fnm_item{Id := "rational-ops/t5/004", Tier := 5, Prompt := "(5/6 + (−1/3)) ÷ 5", Choices := array{"1/10", "7/30", "−1/10", "23/30"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "One negative makes it negative. Two negatives make it positive.", "Do the parentheses first, then × and ÷, then + and −."}, Explanation := "Inside first: 5/6 + (−1/3) = 1/2. Then 1/2 ÷ 5 = 1/10."},
        fnm_item{Id := "rational-ops/t5/005", Tier := 5, Prompt := "−3/8 + (−1/2) × (−4)", Choices := array{"2 3/8", "3 1/2", "−1 5/8", "1 5/8"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Do the parentheses first, then × and ÷, then + and −.", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "Multiply first: −1/2 × (−4) = 2. Then −3/8 + 2 = 1 5/8."},
        fnm_item{Id := "rational-ops/t5/006", Tier := 5, Prompt := "Temp is 1.2 degrees, then drops 3.6 degrees. Now?", Choices := array{"−2.4", "−4.8", "4.8", "2.4"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Read the story: down or spend means subtract, up or deposit means add.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "Drops means subtract. Subtracting 3.6 is adding −3.6. Signs differ: 3.6 − 1.2 = 2.4, and the bigger one is negative, so −2.4."},
        fnm_item{Id := "rational-ops/t5/007", Tier := 5, Prompt := "Temps are −2.4 and 3.9 degrees. How far apart?", Choices := array{"3.9", "1.5", "−6.3", "6.3"}, Answer := 3, Feedback := array{"Count both parts: up to 0 from the negative, then on to the positive.", "Across zero, add the sizes: from −2 up to 0 is 2, then on to 1.", "Distance is never negative. Count the steps between them.", ""}, Explanation := "Across zero, add the sizes: 2.4 + 3.9 = 6.3. Distance is |3.9 − (−2.4)| = 6.3."},
        fnm_item{Id := "rational-ops/t5/008", Tier := 5, Prompt := "Temps are −2.8 and 3 degrees. How far apart?", Choices := array{"3", "0.2", "5.8", "−5.8"}, Answer := 2, Feedback := array{"Count both parts: up to 0 from the negative, then on to the positive.", "Across zero, add the sizes: from −2 up to 0 is 2, then on to 1.", "", "Distance is never negative. Count the steps between them."}, Explanation := "Across zero, add the sizes: 2.8 + 3 = 5.8. Distance is |3 − (−2.8)| = 5.8."},
        fnm_item{Id := "rational-ops/t5/009", Tier := 5, Prompt := "Balance is −$7.50. You deposit $4.50. New balance?", Choices := array{"−$3.50", "−$3", "−$12", "$3"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Read the story: down or spend means subtract, up or deposit means add.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "Deposit means add. Signs differ: $7.50 − $4.50 = $3, and the bigger one is negative, so −$3."},
        fnm_item{Id := "rational-ops/t5/010", Tier := 5, Prompt := "Diver at −3/4 m swims up 1/12 m. New elevation?", Choices := array{"−2/3", "2/3", "−1/6", "−5/6"}, Answer := 0, Feedback := array{"", "Right size, wrong sign. Which number is farther from 0?", "Rename BOTH with the same bottom first: 1/2 is 2/4, not 1/4.", "Read the story: down or spend means subtract, up or deposit means add."}, Explanation := "Up means add. Common bottom 12: −9/12 + 1/12 = −8/12 = −2/3."},
        fnm_item{Id := "rational-ops/t5/011", Tier := 5, Prompt := "Temp changes −0.8 degrees an hour for 5 hours. Total?", Choices := array{"4", "−4", "4.2", "−0.4"}, Answer := 1, Feedback := array{"One negative makes it negative. Two negatives make it positive.", "", "× means groups of, not +. Multiply the two numbers.", "Do the digits, then put the decimal point back by counting places."}, Explanation := "5 groups of −0.8: one negative, so negative. Digits 8 × 5 = 40, so −4."},
        fnm_item{Id := "rational-ops/t5/012", Tier := 5, Prompt := "(−2/3 − 1/3) ÷ 4", Choices := array{"−1/4", "−4", "−3/4", "1/4"}, Answer := 0, Feedback := array{"", "Divide, don\'t multiply: ask what times the divisor makes the number.", "Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "Inside first: −2/3 − 1/3 = −1. Then −1 ÷ 4 = −1/4."},
        fnm_item{Id := "rational-ops/t5/013", Tier := 5, Prompt := "2.4 − (−0.8) × 2", Choices := array{"−4", "0.8", "4", "6.4"}, Answer := 2, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "One negative makes it negative. Two negatives make it positive.", "", "Do the parentheses first, then × and ÷, then + and −."}, Explanation := "Multiply first: −0.8 × 2 = −1.6. Then 2.4 − (−1.6) = 4."},
        fnm_item{Id := "rational-ops/t5/014", Tier := 5, Prompt := "−1/4 × (3 − 7)", Choices := array{"−1", "1", "2 1/2", "−7 3/4"}, Answer := 1, Feedback := array{"One negative makes it negative. Two negatives make it positive.", "", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Do the parentheses first, then × and ÷, then + and −."}, Explanation := "Inside first: 3 − 7 = −4. Then −1/4 × (−4) = 1."},
        fnm_item{Id := "rational-ops/t5/015", Tier := 5, Prompt := "1/3 × (−3 − (−6))", Choices := array{"5", "3", "1", "−1"}, Answer := 2, Feedback := array{"Do the parentheses first, then × and ÷, then + and −.", "Different signs: subtract the sizes, keep the sign of the bigger one.", "", "One negative makes it negative. Two negatives make it positive."}, Explanation := "Inside first: −3 − (−6) = 3. Then 1/3 × 3 = 1."},
        fnm_item{Id := "rational-ops/t5/016", Tier := 5, Prompt := "−0.8 × (3 + (−5))", Choices := array{"6.4", "−7.4", "−1.6", "1.6"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive.", ""}, Explanation := "Inside first: 3 + (−5) = −2. Then −0.8 × (−2) = 1.6."},
        fnm_item{Id := "rational-ops/t5/017", Tier := 5, Prompt := "Water level changes −4/5 inch a day for 5 days. Total?", Choices := array{"4", "4 1/5", "−4", "−4/25"}, Answer := 2, Feedback := array{"One negative makes it negative. Two negatives make it positive.", "× means groups of, not +. Multiply the two numbers.", "", "A whole number multiplies the top, not the bottom."}, Explanation := "5 days of −4/5: one negative, so negative. 4×5 over 5 = 20/5 = 4, so −4."},
        fnm_item{Id := "rational-ops/t5/018", Tier := 5, Prompt := "Temp changes −0.9 degrees an hour for 6 hours. Total?", Choices := array{"−5.4", "5.4", "−0.54", "5.1"}, Answer := 0, Feedback := array{"", "One negative makes it negative. Two negatives make it positive.", "Do the digits, then put the decimal point back by counting places.", "× means groups of, not +. Multiply the two numbers."}, Explanation := "6 groups of −0.9: one negative, so negative. Digits 9 × 6 = 54, so −5.4."},
        fnm_item{Id := "rational-ops/t5/019", Tier := 5, Prompt := "(−1/4 − (−7/8)) ÷ 5", Choices := array{"1/8", "9/40", "−1/8", "−3/40"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "One negative makes it negative. Two negatives make it positive.", "Do the parentheses first, then × and ÷, then + and −."}, Explanation := "Inside first: −1/4 − (−7/8) = 5/8. Then 5/8 ÷ 5 = 1/8."},
        fnm_item{Id := "rational-ops/t5/020", Tier := 5, Prompt := "A diver at −0.6 m and a bird at 3.9 m. Distance apart?", Choices := array{"−4.5", "3.3", "3.9", "4.5"}, Answer := 3, Feedback := array{"Distance is never negative. Count the steps between them.", "Across zero, add the sizes: from −2 up to 0 is 2, then on to 1.", "Count both parts: up to 0 from the negative, then on to the positive.", ""}, Explanation := "Across zero, add the sizes: 0.6 + 3.9 = 4.5. Distance is |3.9 − (−0.6)| = 4.5."},
        fnm_item{Id := "rational-ops/t5/021", Tier := 5, Prompt := "Balance is −$4. You deposit $3. New balance?", Choices := array{"$1", "−$7", "−$1.50", "−$1"}, Answer := 3, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "Read the story: down or spend means subtract, up or deposit means add.", "Check your arithmetic.", ""}, Explanation := "Deposit means add. Signs differ: $4 − $3 = $1, and the bigger one is negative, so −$1."},
        fnm_item{Id := "rational-ops/t5/022", Tier := 5, Prompt := "Water level changes −4/5 inch a day for 8 days. Total?", Choices := array{"−6 2/5", "7 1/5", "−1/10", "6 2/5"}, Answer := 0, Feedback := array{"", "× means groups of, not +. Multiply the two numbers.", "A whole number multiplies the top, not the bottom.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "8 days of −4/5: one negative, so negative. 4×8 over 5 = 32/5 = 6 2/5, so −6 2/5."},
        fnm_item{Id := "rational-ops/t5/023", Tier := 5, Prompt := "Diver at −1/5 m swims up 4/5 m. New elevation?", Choices := array{"−1", "1", "−3/5", "3/5"}, Answer := 3, Feedback := array{"Read the story: down or spend means subtract, up or deposit means add.", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "Up means add. Common bottom 5: −1/5 + 4/5 = 3/5."},
        fnm_item{Id := "rational-ops/t5/024", Tier := 5, Prompt := "Balance is $1. You spend $3.50. New balance?", Choices := array{"$2.50", "$4.50", "−$2.50", "−$4.50"}, Answer := 2, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "Read the story: down or spend means subtract, up or deposit means add.", "", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Spend means subtract. Subtracting $3.50 is adding −$3.50. Signs differ: $3.50 − $1 = $2.50, and the bigger one is negative, so −$2.50."},
        fnm_item{Id := "rational-ops/t5/025", Tier := 5, Prompt := "Temp is −1.2 degrees, then rises 3.3 degrees. Now?", Choices := array{"4.5", "−4.5", "−2.1", "2.1"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Read the story: down or spend means subtract, up or deposit means add.", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "Rises means add. Signs differ: 3.3 − 1.2 = 2.1, and the bigger one is positive, so 2.1."},
        fnm_item{Id := "rational-ops/t5/026", Tier := 5, Prompt := "−1.7 − 0.6 × 9", Choices := array{"7.1", "−7.1", "3.7", "−20.7"}, Answer := 1, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "", "One negative makes it negative. Two negatives make it positive.", "Do the parentheses first, then × and ÷, then + and −."}, Explanation := "Multiply first: 0.6 × 9 = 5.4. Then −1.7 − 5.4 = −7.1."},
        fnm_item{Id := "rational-ops/t5/027", Tier := 5, Prompt := "1/4 + 2/3 × (−6)", Choices := array{"−3 3/4", "−4 1/4", "−5 1/2", "4 1/4"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "Multiply first: 2/3 × (−6) = −4. Then 1/4 + (−4) = −3 3/4."},
        fnm_item{Id := "rational-ops/t5/028", Tier := 5, Prompt := "(−1.7 + 0.1) ÷ 4", Choices := array{"−1.675", "−0.4", "0.4", "−6.4"}, Answer := 1, Feedback := array{"Do the parentheses first, then × and ÷, then + and −.", "", "One negative makes it negative. Two negatives make it positive.", "Divide, don\'t multiply: ask what times the divisor makes the number."}, Explanation := "Inside first: −1.7 + 0.1 = −1.6. Then −1.6 ÷ 4 = −0.4."},
        fnm_item{Id := "rational-ops/t5/029", Tier := 5, Prompt := "(−0.1 + 1.3) ÷ (−3)", Choices := array{"−3.6", "−0.5", "−0.4", "0.4"}, Answer := 2, Feedback := array{"Divide, don\'t multiply: ask what times the divisor makes the number.", "Check your arithmetic.", "", "One negative makes it negative. Two negatives make it positive."}, Explanation := "Inside first: −0.1 + 1.3 = 1.2. Then 1.2 ÷ (−3) = −0.4."},
        fnm_item{Id := "rational-ops/t5/030", Tier := 5, Prompt := "Temp is −1.3 degrees, then rises 0.6 degrees. Now?", Choices := array{"−1.9", "−0.7", "0.7", "−0.8"}, Answer := 1, Feedback := array{"Read the story: down or spend means subtract, up or deposit means add.", "", "Right size, wrong sign. Which number is farther from 0?", "Check your arithmetic."}, Explanation := "Rises means add. Signs differ: 1.3 − 0.6 = 0.7, and the bigger one is negative, so −0.7."},
        fnm_item{Id := "rational-ops/t5/031", Tier := 5, Prompt := "Diver at −3.4 m dives 2.2 m deeper. New elevation?", Choices := array{"−5.7", "−1.2", "−5.6", "5.6"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Read the story: down or spend means subtract, up or deposit means add.", "", "Two negatives make a positive only when you multiply or divide."}, Explanation := "Deeper means subtract. Subtracting 2.2 is adding −2.2. Same signs: 3.4 + 2.2 = 5.6, both negative, so −5.6."},
        fnm_item{Id := "rational-ops/t5/032", Tier := 5, Prompt := "−1/4 × (8 + (−10))", Choices := array{"−12", "−1/2", "4 1/2", "1/2"}, Answer := 3, Feedback := array{"Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive.", "Different signs: subtract the sizes, keep the sign of the bigger one.", ""}, Explanation := "Inside first: 8 + (−10) = −2. Then −1/4 × (−2) = 1/2."},
        fnm_item{Id := "rational-ops/t5/033", Tier := 5, Prompt := "−0.6 × (8 − 3)", Choices := array{"−3", "−6.6", "−7.8", "3"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "Inside first: 8 − 3 = 5. Then −0.6 × 5 = −3."},
        fnm_item{Id := "rational-ops/t5/034", Tier := 5, Prompt := "(−0.8 − 1.6) ÷ 6", Choices := array{"−0.5", "0.4", "−0.4", "−14.4"}, Answer := 2, Feedback := array{"Check your arithmetic.", "One negative makes it negative. Two negatives make it positive.", "", "Divide, don\'t multiply: ask what times the divisor makes the number."}, Explanation := "Inside first: −0.8 − 1.6 = −2.4. Then −2.4 ÷ 6 = −0.4."},
        fnm_item{Id := "rational-ops/t5/035", Tier := 5, Prompt := "−2.2 − (−0.8) × 3", Choices := array{"−4.6", "0.2", "−4.2", "−0.2"}, Answer := 1, Feedback := array{"One negative makes it negative. Two negatives make it positive.", "", "Do the parentheses first, then × and ÷, then + and −.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "Multiply first: −0.8 × 3 = −2.4. Then −2.2 − (−2.4) = 0.2."},
        fnm_item{Id := "rational-ops/t5/036", Tier := 5, Prompt := "−1/2 − 2/3 × 6", Choices := array{"−7", "3 1/2", "−4 1/2", "4 1/2"}, Answer := 2, Feedback := array{"Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive.", "", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "Multiply first: 2/3 × 6 = 4. Then −1/2 − 4 = −4 1/2."},
        fnm_item{Id := "rational-ops/t5/037", Tier := 5, Prompt := "Diver at −1.9 m swims up 3.6 m. New elevation?", Choices := array{"5.5", "−1.7", "−5.5", "1.7"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Right size, wrong sign. Which number is farther from 0?", "Read the story: down or spend means subtract, up or deposit means add.", ""}, Explanation := "Up means add. Signs differ: 3.6 − 1.9 = 1.7, and the bigger one is positive, so 1.7."},
        fnm_item{Id := "rational-ops/t5/038", Tier := 5, Prompt := "0.3 − 0.7 × (−10)", Choices := array{"−7.3", "7.3", "4", "−6.7"}, Answer := 1, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "", "Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "Multiply first: 0.7 × (−10) = −7. Then 0.3 − (−7) = 7.3."},
        fnm_item{Id := "rational-ops/t5/039", Tier := 5, Prompt := "−0.9 × (−3 + (−2))", Choices := array{"0.7", "4.5", "−4.5", "4.6"}, Answer := 1, Feedback := array{"Do the parentheses first, then × and ÷, then + and −.", "", "One negative makes it negative. Two negatives make it positive.", "Check your arithmetic."}, Explanation := "Inside first: −3 + (−2) = −5. Then −0.9 × (−5) = 4.5."},
        fnm_item{Id := "rational-ops/t5/040", Tier := 5, Prompt := "−3/4 × (2 − (−6))", Choices := array{"4 1/2", "6", "−6", "3"}, Answer := 2, Feedback := array{"Do the parentheses first, then × and ÷, then + and −.", "One negative makes it negative. Two negatives make it positive.", "", "Subtracting a negative is adding: 4 − (−6) = 4 + 6."}, Explanation := "Inside first: 2 − (−6) = 8. Then −3/4 × 8 = −6."}
    }
}

FnmCartridge_two_step_equations():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "two-step-equations",
    Version := "1.0.0",
    Title := "Two-Step Equations",
    Subtitle := "Equations \& Inequalities: px + q = r",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Solve px + q = r", Description := "Undo the plus or minus first, then undo the times. Whole numbers only."},
        fnm_tier{Tier := 2, Name := "Negatives", Description := "Same two steps with negative coefficients, constants and answers."},
        fnm_tier{Tier := 3, Name := "Parentheses", Description := "Solve p(x + q) = r by dividing first, and distribute the p."},
        fnm_tier{Tier := 4, Name := "Stories: Write \& Solve", Description := "Turn a short story into a two-step equation, and solve it."},
        fnm_tier{Tier := 5, Name := "Two-Step Inequalities", Description := "Solve px + q \> r and friends. Flip the sign when you divide by a negative."}
    },
    Items := array{
        fnm_item{Id := "two-step-equations/t1/001", Tier := 1, Prompt := "Solve: 4m + 4 = 20", Choices := array{"6", "4", "1", "16"}, Answer := 1, Feedback := array{"Undo + with −, and − with +, on both sides.", "", "Dividing must hit every term. Safer: undo the + or − first, then divide.", "You stopped early. After undoing + or −, divide to get x alone."}, Explanation := "Subtract 4 from both sides: 4m = 16. Divide by 4: m = 4. Check: 4 × 4 + 4 = 20."},
        fnm_item{Id := "two-step-equations/t1/002", Tier := 1, Prompt := "Solve: 4 = 2n − 4", Choices := array{"8", "6", "4", "16"}, Answer := 2, Feedback := array{"You stopped early. After undoing + or −, divide to get x alone.", "Dividing must hit every term. Safer: undo the + or − first, then divide.", "", "x is multiplied by the number, so divide to undo it. Don\'t multiply again."}, Explanation := "Add 4 to both sides: 2n = 8. Divide by 2: n = 4. Check: 2 × 4 − 4 = 4."},
        fnm_item{Id := "two-step-equations/t1/003", Tier := 1, Prompt := "Solve: 18 = 3k − 9", Choices := array{"3", "15", "27", "9"}, Answer := 3, Feedback := array{"Undo + with −, and − with +, on both sides.", "Dividing must hit every term. Safer: undo the + or − first, then divide.", "You stopped early. After undoing + or −, divide to get x alone.", ""}, Explanation := "Add 9 to both sides: 3k = 27. Divide by 3: k = 9. Check: 3 × 9 − 9 = 18."},
        fnm_item{Id := "two-step-equations/t1/004", Tier := 1, Prompt := "Solve: 12 + 4t = 20", Choices := array{"32", "2", "8", "4"}, Answer := 1, Feedback := array{"x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "", "Undo + with −, and − with +, on both sides.", "2x means 2 times x. Undo times by dividing, not subtracting."}, Explanation := "Subtract 12 from both sides: 4t = 8. Divide by 4: t = 2. Check: 12 + 4 × 2 = 20."},
        fnm_item{Id := "two-step-equations/t1/005", Tier := 1, Prompt := "Solve: 2y − 8 = 8", Choices := array{"8", "32", "16", "12"}, Answer := 0, Feedback := array{"", "x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "You stopped early. After undoing + or −, divide to get x alone.", "Dividing must hit every term. Safer: undo the + or − first, then divide."}, Explanation := "Add 8 to both sides: 2y = 16. Divide by 2: y = 8. Check: 2 × 8 − 8 = 8."},
        fnm_item{Id := "two-step-equations/t1/006", Tier := 1, Prompt := "Solve: 6 + 2x = 18", Choices := array{"12", "6", "3", "24"}, Answer := 1, Feedback := array{"You stopped early. After undoing + or −, divide to get x alone.", "", "Dividing must hit every term. Safer: undo the + or − first, then divide.", "x is multiplied by the number, so divide to undo it. Don\'t multiply again."}, Explanation := "Subtract 6 from both sides: 2x = 12. Divide by 2: x = 6. Check: 6 + 2 × 6 = 18."},
        fnm_item{Id := "two-step-equations/t1/007", Tier := 1, Prompt := "Solve: 5x + 5 = 20", Choices := array{"3", "5", "10", "15"}, Answer := 0, Feedback := array{"", "Undo + with −, and − with +, on both sides.", "2x means 2 times x. Undo times by dividing, not subtracting.", "You stopped early. After undoing + or −, divide to get x alone."}, Explanation := "Subtract 5 from both sides: 5x = 15. Divide by 5: x = 3. Check: 5 × 3 + 5 = 20."},
        fnm_item{Id := "two-step-equations/t1/008", Tier := 1, Prompt := "Solve: 16 = 2t + 10", Choices := array{"13", "3", "6", "12"}, Answer := 1, Feedback := array{"Undo + with −, and − with +, on both sides.", "", "You stopped early. After undoing + or −, divide to get x alone.", "x is multiplied by the number, so divide to undo it. Don\'t multiply again."}, Explanation := "Subtract 10 from both sides: 2t = 6. Divide by 2: t = 3. Check: 2 × 3 + 10 = 16."},
        fnm_item{Id := "two-step-equations/t1/009", Tier := 1, Prompt := "Solve: 12 = 6m − 12", Choices := array{"24", "4", "14", "18"}, Answer := 1, Feedback := array{"You stopped early. After undoing + or −, divide to get x alone.", "", "Dividing must hit every term. Safer: undo the + or − first, then divide.", "2x means 2 times x. Undo times by dividing, not subtracting."}, Explanation := "Add 12 to both sides: 6m = 24. Divide by 6: m = 4. Check: 6 × 4 − 12 = 12."},
        fnm_item{Id := "two-step-equations/t1/010", Tier := 1, Prompt := "Solve: 3m − 9 = 3", Choices := array{"12", "10", "36", "4"}, Answer := 3, Feedback := array{"You stopped early. After undoing + or −, divide to get x alone.", "Dividing must hit every term. Safer: undo the + or − first, then divide.", "x is multiplied by the number, so divide to undo it. Don\'t multiply again.", ""}, Explanation := "Add 9 to both sides: 3m = 12. Divide by 3: m = 4. Check: 3 × 4 − 9 = 3."},
        fnm_item{Id := "two-step-equations/t1/011", Tier := 1, Prompt := "Solve: 7x − 7 = 14", Choices := array{"9", "21", "1", "3"}, Answer := 3, Feedback := array{"Dividing must hit every term. Safer: undo the + or − first, then divide.", "You stopped early. After undoing + or −, divide to get x alone.", "Undo + with −, and − with +, on both sides.", ""}, Explanation := "Add 7 to both sides: 7x = 21. Divide by 7: x = 3. Check: 7 × 3 − 7 = 14."},
        fnm_item{Id := "two-step-equations/t1/012", Tier := 1, Prompt := "Solve: 18 = 2m + 6", Choices := array{"24", "3", "6", "12"}, Answer := 2, Feedback := array{"x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "Dividing must hit every term. Safer: undo the + or − first, then divide.", "", "You stopped early. After undoing + or −, divide to get x alone."}, Explanation := "Subtract 6 from both sides: 2m = 12. Divide by 2: m = 6. Check: 2 × 6 + 6 = 18."},
        fnm_item{Id := "two-step-equations/t1/013", Tier := 1, Prompt := "Solve: 2n + 8 = 14", Choices := array{"11", "12", "6", "3"}, Answer := 3, Feedback := array{"Undo + with −, and − with +, on both sides.", "x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "You stopped early. After undoing + or −, divide to get x alone.", ""}, Explanation := "Subtract 8 from both sides: 2n = 6. Divide by 2: n = 3. Check: 2 × 3 + 8 = 14."},
        fnm_item{Id := "two-step-equations/t1/014", Tier := 1, Prompt := "Solve: 11 = 4n − 1", Choices := array{"3", "8", "48", "12"}, Answer := 0, Feedback := array{"", "2x means 2 times x. Undo times by dividing, not subtracting.", "x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "You stopped early. After undoing + or −, divide to get x alone."}, Explanation := "Add 1 to both sides: 4n = 12. Divide by 4: n = 3. Check: 4 × 3 − 1 = 11."},
        fnm_item{Id := "two-step-equations/t1/015", Tier := 1, Prompt := "Solve: 2y + 7 = 17", Choices := array{"10", "5", "12", "20"}, Answer := 1, Feedback := array{"You stopped early. After undoing + or −, divide to get x alone.", "", "Undo + with −, and − with +, on both sides.", "x is multiplied by the number, so divide to undo it. Don\'t multiply again."}, Explanation := "Subtract 7 from both sides: 2y = 10. Divide by 2: y = 5. Check: 2 × 5 + 7 = 17."},
        fnm_item{Id := "two-step-equations/t1/016", Tier := 1, Prompt := "Solve: 4x + 6 = 18", Choices := array{"3", "48", "12", "6"}, Answer := 0, Feedback := array{"", "x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "You stopped early. After undoing + or −, divide to get x alone.", "Undo + with −, and − with +, on both sides."}, Explanation := "Subtract 6 from both sides: 4x = 12. Divide by 4: x = 3. Check: 4 × 3 + 6 = 18."},
        fnm_item{Id := "two-step-equations/t1/017", Tier := 1, Prompt := "Solve: 3 + 3x = 18", Choices := array{"3", "15", "7", "5"}, Answer := 3, Feedback := array{"Dividing must hit every term. Safer: undo the + or − first, then divide.", "You stopped early. After undoing + or −, divide to get x alone.", "Undo + with −, and − with +, on both sides.", ""}, Explanation := "Subtract 3 from both sides: 3x = 15. Divide by 3: x = 5. Check: 3 + 3 × 5 = 18."},
        fnm_item{Id := "two-step-equations/t1/018", Tier := 1, Prompt := "Solve: 12 + 2n = 18", Choices := array{"12", "6", "15", "3"}, Answer := 3, Feedback := array{"x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "You stopped early. After undoing + or −, divide to get x alone.", "Undo + with −, and − with +, on both sides.", ""}, Explanation := "Subtract 12 from both sides: 2n = 6. Divide by 2: n = 3. Check: 12 + 2 × 3 = 18."},
        fnm_item{Id := "two-step-equations/t1/019", Tier := 1, Prompt := "Solve: 8 + 4k = 20", Choices := array{"7", "3", "48", "12"}, Answer := 1, Feedback := array{"Undo + with −, and − with +, on both sides.", "", "x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "You stopped early. After undoing + or −, divide to get x alone."}, Explanation := "Subtract 8 from both sides: 4k = 12. Divide by 4: k = 3. Check: 8 + 4 × 3 = 20."},
        fnm_item{Id := "two-step-equations/t1/020", Tier := 1, Prompt := "Solve: 3x + 9 = 15", Choices := array{"18", "8", "6", "2"}, Answer := 3, Feedback := array{"x is multiplied by the number, so divide to undo it. Don\'t multiply again.", "Undo + with −, and − with +, on both sides.", "You stopped early. After undoing + or −, divide to get x alone.", ""}, Explanation := "Subtract 9 from both sides: 3x = 6. Divide by 3: x = 2. Check: 3 × 2 + 9 = 15."},
