        fnm_item{Id := "expressions/t2/038", Tier := 2, Prompt := "Coefficient of t in 2 + 9t?", Choices := array{"2", "t", "9t", "9"}, Answer := 3, Feedback := array{"Coefficient: the number times a letter. Constant: a number all alone.", "That\'s the letter (the variable). The question asks for a number.", "That\'s the whole term. The coefficient is just its number: 7 in 7x.", ""}, Explanation := "In 2 + 9t, 9 multiplies t, so 9 is the coefficient. 2 stands alone: it is the constant."},
        fnm_item{Id := "expressions/t2/039", Tier := 2, Prompt := "What kind of expression is (y + 10) ÷ 6?", Choices := array{"product", "difference", "quotient", "sum"}, Answer := 2, Feedback := array{"Find the step you\'d do last. That step names it: sum, product...", "Find the step you\'d do last. That step names it: sum, product...", "", "Name it by the LAST step: 2(x + 5) adds first, multiplies last: product."}, Explanation := "In (y + 10) ÷ 6 you add first and divide last. The last step names it: a quotient."},
