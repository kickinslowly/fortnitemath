        fnm_item{Id := "fraction-division/t5/035", Tier := 5, Prompt := "3 friends split 1/2 of a pizza equally. How much each?", Choices := array{"6", "1/7", "1/6", "1 1/2"}, Answer := 2, Feedback := array{"Backwards: start with the amount you have, then divide it.", "Check your arithmetic.", "", "Dividing by a whole number makes it smaller: split it into that many parts."}, Explanation := "Share 1/2 into 3 parts: 1/2 ÷ 3 = 1/2 × 1/3 = 1/6."},
