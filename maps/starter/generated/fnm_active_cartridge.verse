        fnm_item{Id := "equations-inequalities/t5/011", Tier := 5, Prompt := "A team needs at least 15 players, p. Which fits?", Choices := array{"p \< 15", "p \> 15", "p ≤ 15", "p ≥ 15"}, Answer := 3, Feedback := array{"Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", ""}, Explanation := "15 or more: p ≥ 15. 15 itself counts, so the line goes under the sign."},
