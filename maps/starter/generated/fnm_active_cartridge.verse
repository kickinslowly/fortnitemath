        fnm_item{Id := "fraction-division/t5/012", Tier := 5, Prompt := "Rectangle: area 1/3 sq ft, width 1/8 ft. Length?", Choices := array{"2 2/3 ft", "1/24 ft", "24 ft", "3/8 ft"}, Answer := 0, Feedback := array{"", "You multiplied as is. To divide, multiply by the flipped divisor.", "Flip only the second fraction. The first one stays as it is.", "Backwards: start with the amount you have, then divide it."}, Explanation := "Length = area ÷ width: 1/3 ÷ 1/8 = 1/3 × 8 = 8/3 = 2 2/3 ft."},
