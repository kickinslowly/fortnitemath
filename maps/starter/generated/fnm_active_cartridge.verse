        fnm_item{Id := "equations-inequalities/t5/006", Tier := 5, Prompt := "Which makes 12 ≥ y true?", Choices := array{"14", "13", "9", "16"}, Answer := 2, Feedback := array{"Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "12 ≥ y means y ≤ 12. Try 9: 12 ≥ 9 is true."},
