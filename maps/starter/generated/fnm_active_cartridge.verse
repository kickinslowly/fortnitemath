        fnm_item{Id := "fraction-division/t5/034", Tier := 5, Prompt := "5/6 of a bag of dog food weighs 4 lb. Whole bag?", Choices := array{"5/24 lb", "24 lb", "3 1/3 lb", "4 4/5 lb"}, Answer := 3, Feedback := array{"Backwards: start with the amount you have, then divide it.", "Flip the whole divisor: ÷ 3/4 means × 4/3, not just × 4.", "You multiplied as is. To divide, multiply by the flipped divisor.", ""}, Explanation := "5/6 of the bag is 4 lb, so whole = 4 ÷ 5/6 = 4 × 6/5 = 24/5 = 4 4/5 lb."},
        fnm_item{Id := "fraction-division/t5/035", Tier := 5, Prompt := "3 friends split 1/2 of a pizza equally. How much each?", Choices := array{"6", "1/7", "1/6", "1 1/2"}, Answer := 2, Feedback := array{"Backwards: start with the amount you have, then divide it.", "Check your arithmetic.", "", "Dividing by a whole number makes it smaller: split it into that many parts."}, Explanation := "Share 1/2 into 3 parts: 1/2 ÷ 3 = 1/2 × 1/3 = 1/6."},
