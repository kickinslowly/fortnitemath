        fnm_item{Id := "equations-inequalities/t5/023", Tier := 5, Prompt := "The trip took over 19 days, d. Which fits?", Choices := array{"d \> 19", "d ≥ 19", "d \< 19", "d ≤ 19"}, Answer := 0, Feedback := array{"", "At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "More than 19: d \> 19. 19 itself does not count, so no line under the sign."},
