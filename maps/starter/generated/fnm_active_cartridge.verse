        fnm_item{Id := "linear-expressions/t4/015", Tier := 4, Prompt := "Factor out the GCF: 4m − 2", Choices := array{"4(m − 2)", "2(2m + 1)", "2(2m − 2)", "2(2m − 1)"}, Answer := 3, Feedback := array{"Pull out what BOTH terms share, not just one term\'s number.", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Divide EVERY term by the factor you take out, not just the first.", ""}, Explanation := "GCF of 4 and 2 is 2. Divide each term by 2: 2m − 1. So 2(2m − 1)."},
