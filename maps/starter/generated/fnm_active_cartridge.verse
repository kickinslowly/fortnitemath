        fnm_item{Id := "rational-numbers/t1/019", Tier := 1, Prompt := "Start at 6 and move 7 left. Where are you?", Choices := array{"0", "−1", "13", "−7"}, Answer := 1, Feedback := array{"Count the jumps between tick marks, not the tick marks themselves.", "", "Right means bigger numbers. Left means smaller numbers.", "Start at the starting number, not at 0, then count the move."}, Explanation := "Left means smaller: 6 − 7 = −1."},
