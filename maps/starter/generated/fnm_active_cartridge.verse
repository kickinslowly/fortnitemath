FnmCartridge_integer_ops():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "integer-ops",
    Version := "1.2.0",
    Title := "Integer Operations",
    Subtitle := "Positive \& Negative Numbers",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Adding", Description := "Add positive and negative numbers."},
        fnm_tier{Tier := 2, Name := "Subtracting", Description := "Subtract integers. Subtracting a negative means adding."},
        fnm_tier{Tier := 3, Name := "Multiply \& Divide", Description := "Multiply and divide integers. Watch the signs."},
        fnm_tier{Tier := 4, Name := "Mixed Signs", Description := "Two or three operations with negatives, in the right order."},
        fnm_tier{Tier := 5, Name := "Boss Level", Description := "Longer expressions, including powers of negative numbers."}
    },
    Items := array{
        fnm_item{Id := "integer-ops/t1/001", Tier := 1, Prompt := "8 + (−9)", Choices := array{"−1", "1", "0", "−17"}, Answer := 0, Feedback := array{"", "Right size, wrong sign. Which number is farther from 0?", "Check your arithmetic.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "8 + (−9): signs differ, 9 − 8 = 1. −9 is farther from 0, so negative: −1."},
