        fnm_item{Id := "angle-relationships/t5/024", Tier := 5, Prompt := "Straight line: 3x, 4x and 2x. Largest angle?", Choices := array{"20", "40", "60", "80"}, Answer := 3, Feedback := array{"x is not the angle. Multiply x by the number in front to get the angle.", "A right angle is 90 degrees. A straight line is 180. Use the right total.", "Re-read the question: it asks for the larger or the smaller angle.", ""}, Explanation := "3x + 4x + 2x = 180, x = 180 ÷ 9 = 20. Largest: 4 × 20 = 80."},
        fnm_item{Id := "angle-relationships/t5/025", Tier := 5, Prompt := "Complementary angles: 8x and x. Larger angle?", Choices := array{"80", "160", "100", "10"}, Answer := 0, Feedback := array{"", "A right angle is 90 degrees. A straight line is 180. Use the right total.", "Check your arithmetic.", "x is not the angle. Multiply x by the number in front to get the angle."}, Explanation := "8x + x = 90, x = 90 ÷ 9 = 10. Larger: 8 × 10 = 80."},
        fnm_item{Id := "angle-relationships/t5/026", Tier := 5, Prompt := "Lines cross. Adjacent angles: 4x and 60. x?", Choices := array{"15", "120", "30", "10"}, Answer := 2, Feedback := array{"Angles next to each other on a line add to 180. They are not equal.", "You stopped early. Divide by the number in front of x.", "", "Check your arithmetic."}, Explanation := "Adjacent angles add to 180: 4x = 180 − 60 = 120, x = 30."},
        fnm_item{Id := "angle-relationships/t5/027", Tier := 5, Prompt := "Adjacent angles on a line: 2x and 120. x?", Choices := array{"30", "60", "40", "20"}, Answer := 0, Feedback := array{"", "Angles next to each other on a line add to 180. They are not equal.", "Check your arithmetic.", "Check your arithmetic."}, Explanation := "Adjacent angles add to 180: 2x = 180 − 120 = 60, x = 30."},
        fnm_item{Id := "angle-relationships/t5/028", Tier := 5, Prompt := "Adjacent angles on a line: 3x and 30. x?", Choices := array{"20", "50", "70", "150"}, Answer := 1, Feedback := array{"A straight line is 180 degrees, not 90. Angles on a line add to 180.", "", "Check your arithmetic.", "You stopped early. Divide by the number in front of x."}, Explanation := "Adjacent angles add to 180: 3x = 180 − 30 = 150, x = 50."},
        fnm_item{Id := "angle-relationships/t5/029", Tier := 5, Prompt := "Supplementary angles: 2x + 40 and 60. x?", Choices := array{"70", "80", "40", "60"}, Answer := 2, Feedback := array{"Check your arithmetic.", "A + number on one side becomes minus when it moves to the other side.", "", "Take away every angle you are given, not just one."}, Explanation := "2x + 40 + 60 = 180, so 2x = 80, x = 40."},
        fnm_item{Id := "angle-relationships/t5/030", Tier := 5, Prompt := "Vertical angles are 3x + 60 and 120 degrees. x?", Choices := array{"120", "60", "40", "20"}, Answer := 3, Feedback := array{"Check what is asked: here you want x, not the size of an angle.", "A + number on one side becomes minus when it moves to the other side.", "Check your arithmetic.", ""}, Explanation := "Vertical angles are equal: 3x + 60 = 120, 3x = 60, x = 20."},
        fnm_item{Id := "angle-relationships/t5/031", Tier := 5, Prompt := "Lines cross. Adjacent angles: 4x and 100. x?", Choices := array{"10", "25", "80", "20"}, Answer := 3, Feedback := array{"Check your arithmetic.", "Angles next to each other on a line add to 180. They are not equal.", "You stopped early. Divide by the number in front of x.", ""}, Explanation := "Adjacent angles add to 180: 4x = 180 − 100 = 80, x = 20."},
        fnm_item{Id := "angle-relationships/t5/032", Tier := 5, Prompt := "5x and x form a straight line. Larger angle?", Choices := array{"140", "150", "30", "75"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "x is not the angle. Multiply x by the number in front to get the angle.", "A right angle is 90 degrees. A straight line is 180. Use the right total."}, Explanation := "5x + x = 180, x = 180 ÷ 6 = 30. Larger: 5 × 30 = 150."},
        fnm_item{Id := "angle-relationships/t5/033", Tier := 5, Prompt := "Complementary angles: 3x + 20 and 40. x?", Choices := array{"30", "10", "20", "40"}, Answer := 1, Feedback := array{"You stopped early. Divide by the number in front of x.", "", "Check your arithmetic.", "A right angle is 90 degrees. A straight line is 180. Use the right total."}, Explanation := "3x + 20 + 40 = 90, so 3x = 30, x = 10."},
        fnm_item{Id := "angle-relationships/t5/034", Tier := 5, Prompt := "x, 3x and 5x make a straight line. Largest angle?", Choices := array{"20", "60", "100", "120"}, Answer := 2, Feedback := array{"x is not the angle. Multiply x by the number in front to get the angle.", "Re-read the question: it asks for the larger or the smaller angle.", "", "Check your arithmetic."}, Explanation := "x + 3x + 5x = 180, x = 180 ÷ 9 = 20. Largest: 5 × 20 = 100."},
        fnm_item{Id := "angle-relationships/t5/035", Tier := 5, Prompt := "Lines cross. Vertical angles: 4x + 40 and 80. x?", Choices := array{"30", "10", "15", "80"}, Answer := 1, Feedback := array{"A + number on one side becomes minus when it moves to the other side.", "", "Vertical angles are equal. Supplementary angles are the ones that add to 180.", "Check what is asked: here you want x, not the size of an angle."}, Explanation := "Vertical angles are equal: 4x + 40 = 80, 4x = 40, x = 10."},
        fnm_item{Id := "angle-relationships/t5/036", Tier := 5, Prompt := "6x and 3x form a right angle. Larger angle?", Choices := array{"10", "30", "120", "60"}, Answer := 3, Feedback := array{"x is not the angle. Multiply x by the number in front to get the angle.", "Re-read the question: it asks for the larger or the smaller angle.", "A right angle is 90 degrees. A straight line is 180. Use the right total.", ""}, Explanation := "6x + 3x = 90, x = 90 ÷ 9 = 10. Larger: 6 × 10 = 60."},
        fnm_item{Id := "angle-relationships/t5/037", Tier := 5, Prompt := "Supplementary angles: 2x and 7x. Larger angle?", Choices := array{"40", "70", "140", "20"}, Answer := 2, Feedback := array{"Re-read the question: it asks for the larger or the smaller angle.", "A right angle is 90 degrees. A straight line is 180. Use the right total.", "", "x is not the angle. Multiply x by the number in front to get the angle."}, Explanation := "2x + 7x = 180, x = 180 ÷ 9 = 20. Larger: 7 × 20 = 140."},
        fnm_item{Id := "angle-relationships/t5/038", Tier := 5, Prompt := "Lines cross. Vertical angles: 3x + 40 and 70. x?", Choices := array{"20", "70", "10", "30"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Check what is asked: here you want x, not the size of an angle.", "", "You stopped early. Divide by the number in front of x."}, Explanation := "Vertical angles are equal: 3x + 40 = 70, 3x = 30, x = 10."},
        fnm_item{Id := "angle-relationships/t5/039", Tier := 5, Prompt := "x and 2x form a straight line. Larger angle?", Choices := array{"100", "120", "130", "60"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Check your arithmetic.", "x is not the angle. Multiply x by the number in front to get the angle."}, Explanation := "x + 2x = 180, x = 180 ÷ 3 = 60. Larger: 2 × 60 = 120."},
        fnm_item{Id := "angle-relationships/t5/040", Tier := 5, Prompt := "2x + 30 and 30 are supplementary. x?", Choices := array{"60", "40", "30", "15"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Check your arithmetic.", "A right angle is 90 degrees. A straight line is 180. Use the right total."}, Explanation := "2x + 30 + 30 = 180, so 2x = 120, x = 60."}
    }
}

FnmCartridge_circles():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "circles",
    Version := "1.0.0",
    Title := "Circles",
    Subtitle := "Radius, Circumference, Area \& π",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Radius, Diameter \& π", Description := "Radius is half the diameter. Circumference ÷ diameter is π for every circle."},
        fnm_tier{Tier := 2, Name := "Circumference", Description := "Distance around: C = 2πr = πd. Leave π as π."},
        fnm_tier{Tier := 3, Name := "Area of a Circle", Description := "Area = π × r × r. Square the radius, not the diameter."},
        fnm_tier{Tier := 4, Name := "Work Backward \& Estimate", Description := "Find the radius from the circumference. Use 3 for π to estimate."},
        fnm_tier{Tier := 5, Name := "Half \& Quarter Circles", Description := "Areas, curved edges and perimeters of parts of a circle."}
    },
    Items := array{
        fnm_item{Id := "circles/t1/001", Tier := 1, Prompt := "A string around a circle is about how many diameters?", Choices := array{"2", "4", "3", "6"}, Answer := 2, Feedback := array{"Check your arithmetic.", "A square around it is longer. A circle is about 3 diameters, 6 radii.", "", "Those are radii. A diameter is 2 radii, so about 3 diameters."}, Explanation := "Circumference = π × diameter, and π is a little more than 3: about 3 diameters."},
        fnm_item{Id := "circles/t1/002", Tier := 1, Prompt := "A pizza has diameter 10. Its radius?", Choices := array{"10", "20", "2.5", "5"}, Answer := 3, Feedback := array{"Radius and diameter are different: the diameter is twice the radius.", "Radius is half the diameter: it only goes to the center.", "Halve just once: the radius is half the diameter.", ""}, Explanation := "Radius = diameter ÷ 2: 10 ÷ 2 = 5."},
        fnm_item{Id := "circles/t1/003", Tier := 1, Prompt := "A wheel has radius 4. Circumference ÷ diameter?", Choices := array{"2π", "π", "4", "1/π"}, Answer := 1, Feedback := array{"π is circumference ÷ diameter. The 2π is circumference ÷ radius.", "", "The ratio does not depend on size. Every circle gives the same number.", "You flipped it: the circumference is the big number on top."}, Explanation := "Circumference ÷ diameter is π for every circle, big or small."},
        fnm_item{Id := "circles/t1/004", Tier := 1, Prompt := "Distance around a circle is its?", Choices := array{"radius", "area", "circumference", "diameter"}, Answer := 2, Feedback := array{"Around = circumference, inside = area, across = diameter, center-out = radius.", "Around = circumference, inside = area, across = diameter, center-out = radius.", "", "Around = circumference, inside = area, across = diameter, center-out = radius."}, Explanation := "The circumference is the distance around a circle."},
        fnm_item{Id := "circles/t1/005", Tier := 1, Prompt := "Circle: radius 8. Circumference ÷ radius?", Choices := array{"π", "2π", "1/(2π)", "8"}, Answer := 1, Feedback := array{"Circumference ÷ radius is 2π. Only ÷ diameter gives π.", "", "You flipped it: the circumference is the big number on top.", "The ratio does not depend on size. Every circle gives the same number."}, Explanation := "C = 2πr, so circumference ÷ radius = 2π."},
        fnm_item{Id := "circles/t1/006", Tier := 1, Prompt := "Circle: diameter 4. Radius?", Choices := array{"8", "4", "1", "2"}, Answer := 3, Feedback := array{"Radius is half the diameter: it only goes to the center.", "Radius and diameter are different: the diameter is twice the radius.", "Halve just once: the radius is half the diameter.", ""}, Explanation := "Radius = diameter ÷ 2: 4 ÷ 2 = 2."},
        fnm_item{Id := "circles/t1/007", Tier := 1, Prompt := "Radius 8. What is the diameter of the circle?", Choices := array{"16π", "16", "8", "4"}, Answer := 1, Feedback := array{"Diameter is straight across. The distance around needs π.", "", "Radius and diameter are different: the diameter is twice the radius.", "Diameter is twice the radius: it goes all the way across."}, Explanation := "Diameter = 2 × radius: 2 × 8 = 16."},
        fnm_item{Id := "circles/t1/008", Tier := 1, Prompt := "Circle: radius 2. Circumference ÷ diameter?", Choices := array{"2π", "2", "1/π", "π"}, Answer := 3, Feedback := array{"π is circumference ÷ diameter. The 2π is circumference ÷ radius.", "The ratio does not depend on size. Every circle gives the same number.", "You flipped it: the circumference is the big number on top.", ""}, Explanation := "Circumference ÷ diameter is π for every circle, big or small."},
        fnm_item{Id := "circles/t1/009", Tier := 1, Prompt := "A pond has diameter 4. What is its radius?", Choices := array{"8", "2", "4", "1"}, Answer := 1, Feedback := array{"Radius is half the diameter: it only goes to the center.", "", "Radius and diameter are different: the diameter is twice the radius.", "Halve just once: the radius is half the diameter."}, Explanation := "Radius = diameter ÷ 2: 4 ÷ 2 = 2."},
        fnm_item{Id := "circles/t1/010", Tier := 1, Prompt := "A pond has diameter 7. What is its radius?", Choices := array{"3.5", "5.5", "14", "7"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Radius is half the diameter: it only goes to the center.", "Radius and diameter are different: the diameter is twice the radius."}, Explanation := "Radius = diameter ÷ 2: 7 ÷ 2 = 3.5."},
        fnm_item{Id := "circles/t1/011", Tier := 1, Prompt := "A wheel has diameter 10. Circumference ÷ diameter?", Choices := array{"2π", "10", "1/π", "π"}, Answer := 3, Feedback := array{"π is circumference ÷ diameter. The 2π is circumference ÷ radius.", "The ratio does not depend on size. Every circle gives the same number.", "You flipped it: the circumference is the big number on top.", ""}, Explanation := "Circumference ÷ diameter is π for every circle, big or small."},
        fnm_item{Id := "circles/t1/012", Tier := 1, Prompt := "A wheel has diameter 7. Its radius?", Choices := array{"2.5", "7", "3.5", "14"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Radius and diameter are different: the diameter is twice the radius.", "", "Radius is half the diameter: it only goes to the center."}, Explanation := "Radius = diameter ÷ 2: 7 ÷ 2 = 3.5."},
        fnm_item{Id := "circles/t1/013", Tier := 1, Prompt := "Circle: radius 10. Circumference ÷ radius?", Choices := array{"1/(2π)", "2π", "π", "10"}, Answer := 1, Feedback := array{"You flipped it: the circumference is the big number on top.", "", "Circumference ÷ radius is 2π. Only ÷ diameter gives π.", "The ratio does not depend on size. Every circle gives the same number."}, Explanation := "C = 2πr, so circumference ÷ radius = 2π."},
        fnm_item{Id := "circles/t1/014", Tier := 1, Prompt := "Circle: radius 4. Diameter?", Choices := array{"8π", "8", "2", "4"}, Answer := 1, Feedback := array{"Diameter is straight across. The distance around needs π.", "", "Diameter is twice the radius: it goes all the way across.", "Radius and diameter are different: the diameter is twice the radius."}, Explanation := "Diameter = 2 × radius: 2 × 4 = 8."},
        fnm_item{Id := "circles/t1/015", Tier := 1, Prompt := "Pi (π) is circumference divided by what?", Choices := array{"diameter", "radius²", "radius", "area"}, Answer := 0, Feedback := array{"", "That\'s the area. Circumference goes around the edge: 2πr, or π × diameter.", "Circumference = π × diameter. The radius is only half of that.", "Around = circumference, inside = area, across = diameter, center-out = radius."}, Explanation := "π = circumference ÷ diameter, so circumference = π × diameter."},
        fnm_item{Id := "circles/t1/016", Tier := 1, Prompt := "A wheel has diameter 4. Circumference ÷ diameter?", Choices := array{"π", "4", "1/π", "2π"}, Answer := 0, Feedback := array{"", "The ratio does not depend on size. Every circle gives the same number.", "You flipped it: the circumference is the big number on top.", "π is circumference ÷ diameter. The 2π is circumference ÷ radius."}, Explanation := "Circumference ÷ diameter is π for every circle, big or small."},
        fnm_item{Id := "circles/t1/017", Tier := 1, Prompt := "A pond has radius 7. What is its diameter?", Choices := array{"7", "3.5", "14π", "14"}, Answer := 3, Feedback := array{"Radius and diameter are different: the diameter is twice the radius.", "Diameter is twice the radius: it goes all the way across.", "Diameter is straight across. The distance around needs π.", ""}, Explanation := "Diameter = 2 × radius: 2 × 7 = 14."},
        fnm_item{Id := "circles/t1/018", Tier := 1, Prompt := "A pizza has radius 9. Its diameter?", Choices := array{"18", "9", "18π", "4.5"}, Answer := 0, Feedback := array{"", "Radius and diameter are different: the diameter is twice the radius.", "Diameter is straight across. The distance around needs π.", "Diameter is twice the radius: it goes all the way across."}, Explanation := "Diameter = 2 × radius: 2 × 9 = 18."},
        fnm_item{Id := "circles/t1/019", Tier := 1, Prompt := "A line from the center to the edge is called?", Choices := array{"circumference", "area", "diameter", "radius"}, Answer := 3, Feedback := array{"Around = circumference, inside = area, across = diameter, center-out = radius.", "Around = circumference, inside = area, across = diameter, center-out = radius.", "Around = circumference, inside = area, across = diameter, center-out = radius.", ""}, Explanation := "A radius goes from the center out to the edge. A diameter is 2 radii."},
        fnm_item{Id := "circles/t1/020", Tier := 1, Prompt := "Radius 10. What is the diameter of the circle?", Choices := array{"5", "20", "20π", "10"}, Answer := 1, Feedback := array{"Diameter is twice the radius: it goes all the way across.", "", "Diameter is straight across. The distance around needs π.", "Radius and diameter are different: the diameter is twice the radius."}, Explanation := "Diameter = 2 × radius: 2 × 10 = 20."},
        fnm_item{Id := "circles/t1/021", Tier := 1, Prompt := "A pond has radius 3. What is its diameter?", Choices := array{"1.5", "3", "6", "6π"}, Answer := 2, Feedback := array{"Diameter is twice the radius: it goes all the way across.", "Radius and diameter are different: the diameter is twice the radius.", "", "Diameter is straight across. The distance around needs π."}, Explanation := "Diameter = 2 × radius: 2 × 3 = 6."},
        fnm_item{Id := "circles/t1/022", Tier := 1, Prompt := "A line across a circle through its center is called?", Choices := array{"diameter", "radius", "area", "circumference"}, Answer := 0, Feedback := array{"", "Around = circumference, inside = area, across = diameter, center-out = radius.", "Around = circumference, inside = area, across = diameter, center-out = radius.", "Around = circumference, inside = area, across = diameter, center-out = radius."}, Explanation := "A diameter goes straight across, through the center."},
        fnm_item{Id := "circles/t1/023", Tier := 1, Prompt := "Circle: radius 9. Diameter?", Choices := array{"9", "18π", "4.5", "18"}, Answer := 3, Feedback := array{"Radius and diameter are different: the diameter is twice the radius.", "Diameter is straight across. The distance around needs π.", "Diameter is twice the radius: it goes all the way across.", ""}, Explanation := "Diameter = 2 × radius: 2 × 9 = 18."},
        fnm_item{Id := "circles/t1/024", Tier := 1, Prompt := "A pond has diameter 6. What is its radius?", Choices := array{"12", "1.5", "6", "3"}, Answer := 3, Feedback := array{"Radius is half the diameter: it only goes to the center.", "Halve just once: the radius is half the diameter.", "Radius and diameter are different: the diameter is twice the radius.", ""}, Explanation := "Radius = diameter ÷ 2: 6 ÷ 2 = 3."},
        fnm_item{Id := "circles/t1/025", Tier := 1, Prompt := "Radius 5. What is the diameter of the circle?", Choices := array{"2.5", "10π", "10", "5"}, Answer := 2, Feedback := array{"Diameter is twice the radius: it goes all the way across.", "Diameter is straight across. The distance around needs π.", "", "Radius and diameter are different: the diameter is twice the radius."}, Explanation := "Diameter = 2 × radius: 2 × 5 = 10."},
        fnm_item{Id := "circles/t1/026", Tier := 1, Prompt := "A pizza has diameter 8. Its radius?", Choices := array{"2", "16", "4", "8"}, Answer := 2, Feedback := array{"Halve just once: the radius is half the diameter.", "Radius is half the diameter: it only goes to the center.", "", "Radius and diameter are different: the diameter is twice the radius."}, Explanation := "Radius = diameter ÷ 2: 8 ÷ 2 = 4."},
