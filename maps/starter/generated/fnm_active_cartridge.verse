        fnm_item{Id := "expressions/t3/033", Tier := 3, Prompt := "Find 4p + 18 when p = 8", Choices := array{"30", "50", "104", "66"}, Answer := 1, Feedback := array{"A number next to a letter means multiply: 3x is 3 × x, not 3 + x.", "", "Multiply before you add, unless ( ) say otherwise.", "3x means 3 times x. With x = 5 it is 3 × 5 = 15, not 35."}, Explanation := "4p means 4 × 8 = 32. Then 32 + 18 = 50."},
        fnm_item{Id := "expressions/t3/034", Tier := 3, Prompt := "Find 3(n + 5) when n = 4", Choices := array{"12", "27", "17", "39"}, Answer := 1, Feedback := array{"A number next to a letter means multiply: 3x is 3 × x, not 3 + x.", "", "Work inside ( ) first: 5(x − 2) is 5 times the whole (x − 2).", "3x means 3 times x. With x = 5 it is 3 × 5 = 15, not 35."}, Explanation := "( ) first: 4 + 5 = 9. Then 3 × 9 = 27."},
        fnm_item{Id := "expressions/t3/035", Tier := 3, Prompt := "Find 7x − y when x = 5, y = 12", Choices := array{"63", "23", "24", "0"}, Answer := 1, Feedback := array{"3x means 3 times x. With x = 5 it is 3 × 5 = 15, not 35.", "", "Check your arithmetic.", "A number next to a letter means multiply: 3x is 3 × x, not 3 + x."}, Explanation := "7x means 7 × 5 = 35. Then 35 − 12 = 23."},
