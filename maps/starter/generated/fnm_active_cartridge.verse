        fnm_item{Id := "fraction-division/t5/006", Tier := 5, Prompt := "5 friends split 1/2 of a pizza equally. How much each?", Choices := array{"1/11", "2 1/2", "1/10", "10"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Dividing by a whole number makes it smaller: split it into that many parts.", "", "Backwards: start with the amount you have, then divide it."}, Explanation := "Share 1/2 into 5 parts: 1/2 ÷ 5 = 1/2 × 1/5 = 1/10."},
        fnm_item{Id := "fraction-division/t5/007", Tier := 5, Prompt := "8 lb of trail mix split into 2/3 lb bags. How many bags?", Choices := array{"12", "5 1/3", "1/12", "24"}, Answer := 0, Feedback := array{"", "You multiplied as is. To divide, multiply by the flipped divisor.", "Backwards: start with the amount you have, then divide it.", "Flip the whole divisor: ÷ 3/4 means × 4/3, not just × 4."}, Explanation := "Groups of 2/3 in 8: 8 ÷ 2/3 = 8 × 3/2 = 24/2 = 12."},
