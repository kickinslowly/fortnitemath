        fnm_item{Id := "integer-ops/t4/038", Tier := 4, Prompt := "9 ÷ (−3) − (−18) ÷ 3", Choices := array{"−3", "3", "−9", "5"}, Answer := 1, Feedback := array{"One negative makes it negative. Two negatives make it positive.", "", "Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "Do × and ÷ before + and −."}, Explanation := "9 ÷ (−3) = −3, then −18 ÷ 3 = −6, then −3 − (−6) = 3."},
        fnm_item{Id := "integer-ops/t4/039", Tier := 4, Prompt := "−5 − 4 × (−10)", Choices := array{"−45", "35", "90", "−35"}, Answer := 1, Feedback := array{"Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "", "Do × and ÷ before + and −.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "4 × (−10) = −40, then −5 − (−40) = 35."},
        fnm_item{Id := "integer-ops/t4/040", Tier := 4, Prompt := "−4 + (−5) × (−5) + (−2)", Choices := array{"−19", "19", "43", "31"}, Answer := 1, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "", "Do × and ÷ before + and −.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "−5 × (−5) = 25, then −4 + 25 = 21, then 21 + (−2) = 19."},
        fnm_item{Id := "integer-ops/t5/001", Tier := 5, Prompt := "−8 ÷ (−4) − (−2) × 2 × (−9)", Choices := array{"34", "−34", "−4", "−72"}, Answer := 1, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "", "Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12.", "Do × and ÷ before + and −."}, Explanation := "−8 ÷ (−4) = 2, then −2 × 2 = −4, then −4 × (−9) = 36, then 2 − 36 = −34."},
        fnm_item{Id := "integer-ops/t5/002", Tier := 5, Prompt := "−9² − (−3) × (−2)", Choices := array{"−87", "156", "−75", "75"}, Answer := 0, Feedback := array{"", "Do × and ÷ before + and −.", "One negative makes it negative. Two negatives make it positive.", "−3² means −(3 × 3). (−3)² means (−3) × (−3)."}, Explanation := "9² = 81, then −9² = −81, then −3 × (−2) = 6, then −81 − 6 = −87."},
        fnm_item{Id := "integer-ops/t5/003", Tier := 5, Prompt := "−6 − (−4) − 3 × (−10)", Choices := array{"28", "−32", "50", "5"}, Answer := 0, Feedback := array{"", "One negative makes it negative. Two negatives make it positive.", "Do × and ÷ before + and −.", "× means groups: 4 × (−3) is 4 groups of −3, not 4 + (−3)."}, Explanation := "3 × (−10) = −30, then −6 − (−4) = −2, then −2 − (−30) = 28."},
        fnm_item{Id := "integer-ops/t5/004", Tier := 5, Prompt := "−6 ÷ (−2) − (−8) + (−2)³", Choices := array{"3", "12", "−3", "−13"}, Answer := 0, Feedback := array{"", "Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12.", "One negative makes it negative. Two negatives make it positive.", "Subtracting a negative is adding: 4 − (−6) = 4 + 6."}, Explanation := "(−2)³ = −8, then −6 ÷ (−2) = 3, then 3 − (−8) = 11, then 11 + (−8) = 3."},
        fnm_item{Id := "integer-ops/t5/005", Tier := 5, Prompt := "3 − 9 × (−6 + 10)", Choices := array{"−141", "−24", "−33", "33"}, Answer := 2, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Do × and ÷ before + and −.", "", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "−6 + 10 = 4, then 9 × 4 = 36, then 3 − 36 = −33."},
        fnm_item{Id := "integer-ops/t5/006", Tier := 5, Prompt := "−8² + 2 × (−3 × 2)", Choices := array{"76", "372", "−76", "52"}, Answer := 2, Feedback := array{"Two negatives make a positive only when you multiply or divide.", "Do × and ÷ before + and −.", "", "−3² means −(3 × 3). (−3)² means (−3) × (−3)."}, Explanation := "−3 × 2 = −6, then 8² = 64, then −8² = −64, then 2 × (−6) = −12, then −64 + (−12) = −76."},
        fnm_item{Id := "integer-ops/t5/007", Tier := 5, Prompt := "5 − ((−3)² − (−4))", Choices := array{"10", "−8", "0", "8"}, Answer := 1, Feedback := array{"−3² means −(3 × 3). (−3)² means (−3) × (−3).", "", "Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "(−3)² = 9, then 9 − (−4) = 13, then 5 − 13 = −8."},
        fnm_item{Id := "integer-ops/t5/008", Tier := 5, Prompt := "−3 + (2 + (−4)³ ÷ (−8))", Choices := array{"511", "−9", "7", "−7"}, Answer := 2, Feedback := array{"Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12.", "One negative makes it negative. Two negatives make it positive.", "", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "(−4)³ = −64, then −64 ÷ (−8) = 8, then 2 + 8 = 10, then −3 + 10 = 7."},
        fnm_item{Id := "integer-ops/t5/009", Tier := 5, Prompt := "−3² − (4 + (−7))", Choices := array{"6", "12", "−12", "−6"}, Answer := 3, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "Subtracting a negative is adding: 4 − (−6) = 4 + 6.", ""}, Explanation := "4 + (−7) = −3, then 3² = 9, then −3² = −9, then −9 − (−3) = −6."},
        fnm_item{Id := "integer-ops/t5/010", Tier := 5, Prompt := "3 + (9 + (−10 − (−7))) × 9", Choices := array{"111", "57", "81", "−69"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "", "Do × and ÷ before + and −.", "Subtracting a negative is adding: 4 − (−6) = 4 + 6."}, Explanation := "−10 − (−7) = −3, then 9 + (−3) = 6, then 6 × 9 = 54, then 3 + 54 = 57."},
        fnm_item{Id := "integer-ops/t5/011", Tier := 5, Prompt := "−7² + (−4) ÷ (−2)", Choices := array{"−51", "−47", "51", "47"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "7² = 49, then −7² = −49, then −4 ÷ (−2) = 2, then −49 + 2 = −47."},
        fnm_item{Id := "integer-ops/t5/012", Tier := 5, Prompt := "−8 + (5 + (−4)³)", Choices := array{"−67", "−77", "−65", "67"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Check your arithmetic.", "Two negatives make a positive only when you multiply or divide."}, Explanation := "(−4)³ = −64, then 5 + (−64) = −59, then −8 + (−59) = −67."},
        fnm_item{Id := "integer-ops/t5/013", Tier := 5, Prompt := "−6 × 6 + (−8) ÷ 4", Choices := array{"−68", "38", "−11", "−38"}, Answer := 3, Feedback := array{"Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12.", "Two negatives make a positive only when you multiply or divide.", "Do × and ÷ before + and −.", ""}, Explanation := "−6 × 6 = −36, then −8 ÷ 4 = −2, then −36 + (−2) = −38."},
        fnm_item{Id := "integer-ops/t5/014", Tier := 5, Prompt := "(−5² − (−4)) ÷ 7", Choices := array{"−3", "−1", "−147", "3"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "5² = 25, then −5² = −25, then −25 − (−4) = −21, then −21 ÷ 7 = −3."},
        fnm_item{Id := "integer-ops/t5/015", Tier := 5, Prompt := "−5 + (−8 − (−3) × 4) × (−3)", Choices := array{"55", "−65", "75", "−17"}, Answer := 3, Feedback := array{"Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "One negative makes it negative. Two negatives make it positive.", "Do × and ÷ before + and −.", ""}, Explanation := "−3 × 4 = −12, then −8 − (−12) = 4, then 4 × (−3) = −12, then −5 + (−12) = −17."},
        fnm_item{Id := "integer-ops/t5/016", Tier := 5, Prompt := "−10 + (−3) + (−4 + (−8) × (−7))", Choices := array{"71", "39", "65", "73"}, Answer := 1, Feedback := array{"Do × and ÷ before + and −.", "", "Two negatives make a positive only when you multiply or divide.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "−8 × (−7) = 56, then −4 + 56 = 52, then −10 + (−3) = −13, then −13 + 52 = 39."},
        fnm_item{Id := "integer-ops/t5/017", Tier := 5, Prompt := "(−3 + (−3) × (−3)) × (6 − (−2))", Choices := array{"−1", "96", "144", "48"}, Answer := 3, Feedback := array{"× means groups: 4 × (−3) is 4 groups of −3, not 4 + (−3).", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Do × and ÷ before + and −.", ""}, Explanation := "−3 × (−3) = 9, then −3 + 9 = 6, then 6 − (−2) = 8, then 6 × 8 = 48."},
        fnm_item{Id := "integer-ops/t5/018", Tier := 5, Prompt := "−63 ÷ 9 − (−2) × (−7)", Choices := array{"−21", "−581", "35", "2"}, Answer := 0, Feedback := array{"", "Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12.", "Do × and ÷ before + and −.", "× means groups: 4 × (−3) is 4 groups of −3, not 4 + (−3)."}, Explanation := "−63 ÷ 9 = −7, then −2 × (−7) = 14, then −7 − 14 = −21."},
        fnm_item{Id := "integer-ops/t5/019", Tier := 5, Prompt := "(−2)² × (3 − (−5)) − (−9)", Choices := array{"−17", "−23", "−41", "41"}, Answer := 3, Feedback := array{"Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "3 − (−5) = 8, then (−2)² = 4, then 4 × 8 = 32, then 32 − (−9) = 41."},
        fnm_item{Id := "integer-ops/t5/020", Tier := 5, Prompt := "−2 × (6 + (−9) ÷ (−3) − 4)", Choices := array{"3", "−10", "6", "−2"}, Answer := 1, Feedback := array{"× means groups: 4 × (−3) is 4 groups of −3, not 4 + (−3).", "", "Do × and ÷ before + and −.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "−9 ÷ (−3) = 3, then 6 + 3 = 9, then 9 − 4 = 5, then −2 × 5 = −10."},
        fnm_item{Id := "integer-ops/t5/021", Tier := 5, Prompt := "−8² + 8 × 10", Choices := array{"−560", "144", "−16", "16"}, Answer := 3, Feedback := array{"Do × and ÷ before + and −.", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "8² = 64, then −8² = −64, then 8 × 10 = 80, then −64 + 80 = 16."},
