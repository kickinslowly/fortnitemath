        fnm_item{Id := "expressions/t3/001", Tier := 3, Prompt := "Find 2(a + 2) when a = 5", Choices := array{"14", "9", "27", "12"}, Answer := 0, Feedback := array{"", "A number next to a letter means multiply: 3x is 3 × x, not 3 + x.", "3x means 3 times x. With x = 5 it is 3 × 5 = 15, not 35.", "Work inside ( ) first: 5(x − 2) is 5 times the whole (x − 2)."}, Explanation := "( ) first: 5 + 2 = 7. Then 2 × 7 = 14."},
