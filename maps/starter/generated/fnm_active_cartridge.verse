        fnm_item{Id := "fraction-division/t5/027", Tier := 5, Prompt := "2/3 of a bag of dog food weighs 3 lb. Whole bag?", Choices := array{"4 1/2 lb", "2 lb", "9 lb", "2/9 lb"}, Answer := 0, Feedback := array{"", "You multiplied as is. To divide, multiply by the flipped divisor.", "Flip the whole divisor: ÷ 3/4 means × 4/3, not just × 4.", "Backwards: start with the amount you have, then divide it."}, Explanation := "2/3 of the bag is 3 lb, so whole = 3 ÷ 2/3 = 3 × 3/2 = 9/2 = 4 1/2 lb."},
