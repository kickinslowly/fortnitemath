        fnm_item{Id := "two-step-equations/t4/034", Tier := 4, Prompt := "Each of 6 pals pays $b plus a $4 tip. $60 in all. Find b.", Choices := array{"56", "14", "10", "6"}, Answer := 3, Feedback := array{"Divide by the number outside the parentheses first. Don\'t skip it.", "Undo the number inside the parentheses with the OPPOSITE operation.", "You stopped early. After undoing + or −, divide to get x alone.", ""}, Explanation := "Divide both sides by 6: b + 4 = 10. Subtract 4: b = 6. Check: 6(6 + 4) = 60."},
        fnm_item{Id := "two-step-equations/t4/035", Tier := 4, Prompt := "2 boxes of n pens. Gave away 12. 6 left. Find n.", Choices := array{"3", "16", "9", "18"}, Answer := 2, Feedback := array{"Don\'t forget the one-time amount. Take it off first, then divide.", "2x means 2 times x. Undo times by dividing, not subtracting.", "", "You stopped early. After undoing + or −, divide to get x alone."}, Explanation := "2n − 12 = 6. Add 12: 2n = 18. Divide by 2: n = 9."},
