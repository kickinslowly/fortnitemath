        fnm_item{Id := "linear-expressions/t4/018", Tier := 4, Prompt := "Factor out −2: −6t + 4", Choices := array{"−2(3t + 2)", "2(3t + 2)", "−2(3t − 2)", "−2(3t + 4)"}, Answer := 2, Feedback := array{"Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Don\'t lose a minus sign. It stays with the term it belongs to.", "", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −6t ÷ (−2) = 3t, 4 ÷ (−2) = −2. So −2(3t − 2)."},
        fnm_item{Id := "linear-expressions/t4/019", Tier := 4, Prompt := "Factor out −2: −10k + 12", Choices := array{"−2(5k − 6)", "−2(5k + 6)", "2(5k + 6)", "−2(5k + 12)"}, Answer := 0, Feedback := array{"", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −10k ÷ (−2) = 5k, 12 ÷ (−2) = −6. So −2(5k − 6)."},
        fnm_item{Id := "linear-expressions/t4/020", Tier := 4, Prompt := "−4x + 10 = −2(2x + ?)", Choices := array{"12", "5", "−5", "10"}, Answer := 2, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: 10 ÷ (−2) = −5. So −2(2x − 5)."},
        fnm_item{Id := "linear-expressions/t4/021", Tier := 4, Prompt := "Factor out −2: −4p + 2", Choices := array{"2(2p + 1)", "−2(2p + 1)", "−2(2p + 2)", "−2(2p − 1)"}, Answer := 3, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first.", ""}, Explanation := "Divide each term by −2: −4p ÷ (−2) = 2p, 2 ÷ (−2) = −1. So −2(2p − 1)."},
        fnm_item{Id := "linear-expressions/t4/022", Tier := 4, Prompt := "−2n − 10 = −2(n + ?)", Choices := array{"−8", "−5", "5", "−10"}, Answer := 2, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −10 ÷ (−2) = 5. So −2(n + 5)."},
        fnm_item{Id := "linear-expressions/t4/023", Tier := 4, Prompt := "Factor out −2: −8x − 2", Choices := array{"2(4x − 1)", "−2(4x − 1)", "−2(4x + 1)", "−2(4x − 2)"}, Answer := 2, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −8x ÷ (−2) = 4x, −2 ÷ (−2) = 1. So −2(4x + 1)."},
        fnm_item{Id := "linear-expressions/t4/024", Tier := 4, Prompt := "Factor out −5: −5w + 10", Choices := array{"5(w + 2)", "−5(w + 2)", "−5(w − 2)", "−5(w + 10)"}, Answer := 2, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −5: −5w ÷ (−5) = w, 10 ÷ (−5) = −2. So −5(w − 2)."},
        fnm_item{Id := "linear-expressions/t4/025", Tier := 4, Prompt := "−12p + 10 = −2(6p + ?)", Choices := array{"12", "5", "10", "−5"}, Answer := 3, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first.", ""}, Explanation := "Divide each term by −2: 10 ÷ (−2) = −5. So −2(6p − 5)."},
        fnm_item{Id := "linear-expressions/t4/026", Tier := 4, Prompt := "Factor out the GCF: 10b − 2", Choices := array{"2(5b − 1)", "10(b − 2)", "2(5b + 1)", "2(5b − 2)"}, Answer := 0, Feedback := array{"", "Pull out what BOTH terms share, not just one term\'s number.", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "GCF of 10 and 2 is 2. Divide each term by 2: 5b − 1. So 2(5b − 1)."},
        fnm_item{Id := "linear-expressions/t4/027", Tier := 4, Prompt := "Factor out −3: −9p + 3", Choices := array{"3(3p + 1)", "−3(3p − 1)", "−3(3p + 1)", "−3(3p + 3)"}, Answer := 1, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −3: −9p ÷ (−3) = 3p, 3 ÷ (−3) = −1. So −3(3p − 1)."},
        fnm_item{Id := "linear-expressions/t4/028", Tier := 4, Prompt := "12n + 6 = 6(2n + ?)", Choices := array{"−1", "6", "2", "1"}, Answer := 3, Feedback := array{"Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first.", "Check your arithmetic.", ""}, Explanation := "Divide each term by 6: 6 ÷ 6 = 1. So 6(2n + 1)."},
        fnm_item{Id := "linear-expressions/t4/029", Tier := 4, Prompt := "10a + 8 = 2(5a + ?)", Choices := array{"4", "6", "−4", "8"}, Answer := 0, Feedback := array{"", "Factoring divides each term by the factor. Subtracting it is wrong.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by 2: 8 ÷ 2 = 4. So 2(5a + 4)."},
        fnm_item{Id := "linear-expressions/t4/030", Tier := 4, Prompt := "Factor out the GCF: 2n + 8", Choices := array{"2(n + 6)", "2(n + 8)", "2(n + 4)", "8(2n + 1)"}, Answer := 2, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "Pull out what BOTH terms share, not just one term\'s number.", "", "Pull out what BOTH terms share, not just one term\'s number."}, Explanation := "GCF of 2 and 8 is 2. Divide each term by 2: n + 4. So 2(n + 4)."},
        fnm_item{Id := "linear-expressions/t4/031", Tier := 4, Prompt := "Factor out −2: −6y − 8", Choices := array{"−2(3y + 4)", "2(3y − 4)", "−2(3y − 4)", "−2(3y − 8)"}, Answer := 0, Feedback := array{"", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −6y ÷ (−2) = 3y, −8 ÷ (−2) = 4. So −2(3y + 4)."},
        fnm_item{Id := "linear-expressions/t4/032", Tier := 4, Prompt := "Factor out the GCF: 8b + 2", Choices := array{"8(b + 2)", "2(4b + 1)", "2(4b + 2)", "2(8b + 1)"}, Answer := 1, Feedback := array{"Pull out what BOTH terms share, not just one term\'s number.", "", "Divide EVERY term by the factor you take out, not just the first.", "Pull out what BOTH terms share, not just one term\'s number."}, Explanation := "GCF of 8 and 2 is 2. Divide each term by 2: 4b + 1. So 2(4b + 1)."},
        fnm_item{Id := "linear-expressions/t4/033", Tier := 4, Prompt := "Factor out −5: −5m − 5", Choices := array{"5(m − 1)", "−5(m − 1)", "−5(m − 5)", "−5(m + 1)"}, Answer := 3, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first.", ""}, Explanation := "Divide each term by −5: −5m ÷ (−5) = m, −5 ÷ (−5) = 1. So −5(m + 1)."},
        fnm_item{Id := "linear-expressions/t4/034", Tier := 4, Prompt := "Factor out −2: −10x − 8", Choices := array{"−2(5x + 4)", "2(5x − 4)", "−2(5x − 4)", "−2(5x − 8)"}, Answer := 0, Feedback := array{"", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −10x ÷ (−2) = 5x, −8 ÷ (−2) = 4. So −2(5x + 4)."},
        fnm_item{Id := "linear-expressions/t4/035", Tier := 4, Prompt := "Factor out −2: −2b − 12", Choices := array{"2(b − 6)", "−2(b + 6)", "−2(b − 6)", "−2(b − 12)"}, Answer := 1, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −2b ÷ (−2) = b, −12 ÷ (−2) = 6. So −2(b + 6)."},
        fnm_item{Id := "linear-expressions/t4/036", Tier := 4, Prompt := "−2x − 10 = −2(x + ?)", Choices := array{"−8", "−5", "5", "−10"}, Answer := 2, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −10 ÷ (−2) = 5. So −2(x + 5)."},
        fnm_item{Id := "linear-expressions/t4/037", Tier := 4, Prompt := "Factor out the GCF: 10t + 6", Choices := array{"2(8t + 4)", "2(5t + 3)", "10(t + 6)", "2(5t + 6)"}, Answer := 1, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "", "Pull out what BOTH terms share, not just one term\'s number.", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "GCF of 10 and 6 is 2. Divide each term by 2: 5t + 3. So 2(5t + 3)."},
        fnm_item{Id := "linear-expressions/t4/038", Tier := 4, Prompt := "Factor out −2: −10y − 4", Choices := array{"2(5y − 2)", "−2(5y − 2)", "−2(5y + 2)", "−2(5y − 4)"}, Answer := 2, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −10y ÷ (−2) = 5y, −4 ÷ (−2) = 2. So −2(5y + 2)."},
        fnm_item{Id := "linear-expressions/t4/039", Tier := 4, Prompt := "Factor out the GCF: 2w + 12", Choices := array{"2(w + 10)", "2(w + 12)", "12(2w + 1)", "2(w + 6)"}, Answer := 3, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "Pull out what BOTH terms share, not just one term\'s number.", "Pull out what BOTH terms share, not just one term\'s number.", ""}, Explanation := "GCF of 2 and 12 is 2. Divide each term by 2: w + 6. So 2(w + 6)."},
        fnm_item{Id := "linear-expressions/t4/040", Tier := 4, Prompt := "Factor out the GCF: 6t + 9", Choices := array{"3(2t + 3)", "3(3t + 6)", "6(t + 9)", "3(2t + 9)"}, Answer := 0, Feedback := array{"", "Factoring divides each term by the factor. Subtracting it is wrong.", "Pull out what BOTH terms share, not just one term\'s number.", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "GCF of 6 and 9 is 3. Divide each term by 3: 2t + 3. So 3(2t + 3)."},
        fnm_item{Id := "linear-expressions/t5/001", Tier := 5, Prompt := "A meal costs m. Add a 40% tip. Total?", Choices := array{"m + 40", "1.4m", "0.4m", "0.6m"}, Answer := 1, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2)."}, Explanation := "Adding 40% of m: m + 0.4m = 1.4m."},
        fnm_item{Id := "linear-expressions/t5/002", Tier := 5, Prompt := "Simplify: (1/12)m + (1/2)m", Choices := array{"7/12", "(1/12)m", "(7/12)m", "(1/7)m"}, Answer := 2, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "Don\'t leave a term out. Every term is either combined or kept.", "", "Don\'t add the bottoms. Use a common denominator and add only the tops."}, Explanation := "Use denominator 12: 1/12 + 6/12 = 7/12. So (7/12)m."},
        fnm_item{Id := "linear-expressions/t5/003", Tier := 5, Prompt := "Cost c, with 20% taken off. New cost?", Choices := array{"0.98c", "1.2c", "0.8c", "c − 20"}, Answer := 2, Feedback := array{"Check the decimal point: 5% is 0.05 and 50% is 0.5.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", "", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2."}, Explanation := "Taking off 20% of c: c − 0.2c = 0.8c."},
        fnm_item{Id := "linear-expressions/t5/004", Tier := 5, Prompt := "Simplify: (1/3)y + (5/12)y", Choices := array{"(3/4)y", "(1/2)y", "(2/5)y", "(1/3)y"}, Answer := 0, Feedback := array{"", "Rename BOTH fractions with the common denominator, then add the tops.", "Don\'t add the bottoms. Use a common denominator and add only the tops.", "Don\'t leave a term out. Every term is either combined or kept."}, Explanation := "Use denominator 12: 4/12 + 5/12 = 9/12 = 3/4. So (3/4)y."},
        fnm_item{Id := "linear-expressions/t5/005", Tier := 5, Prompt := "A game costs g. Now 40% off. New price?", Choices := array{"0.6g", "0.96g", "0.4g", "1.4g"}, Answer := 0, Feedback := array{"", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2)."}, Explanation := "Taking off 40% of g: g − 0.4g = 0.6g."},
        fnm_item{Id := "linear-expressions/t5/006", Tier := 5, Prompt := "Rectangle: width c, length c + 1. Perimeter?", Choices := array{"4c + 1", "6c", "4c + 2", "2c + 1"}, Answer := 2, Feedback := array{"Multiply EVERY term inside ( ) by the outside number, not just the first.", "Only like terms combine. A letter term and a plain number can\'t merge.", "", "The perimeter goes all the way around: two widths AND two lengths."}, Explanation := "All 4 sides: c + (c + 1) + c + (c + 1). Combine like terms: 4c + 2."},
        fnm_item{Id := "linear-expressions/t5/007", Tier := 5, Prompt := "Increase by 10%: multiply by what?", Choices := array{"1.01", "1.1", "10", "0.1"}, Answer := 1, Feedback := array{"Check the decimal point: 5% is 0.05 and 50% is 0.5.", "", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2."}, Explanation := "10% is 0.1. The whole is 1, and the change adds 0.1: 1 + 0.1 = 1.1."},
        fnm_item{Id := "linear-expressions/t5/008", Tier := 5, Prompt := "Cost c rises 5%. New cost?", Choices := array{"1.05c", "c + 5", "0.95c", "0.05c"}, Answer := 0, Feedback := array{"", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2."}, Explanation := "Adding 5% of c: c + 0.05c = 1.05c."},
        fnm_item{Id := "linear-expressions/t5/009", Tier := 5, Prompt := "Simplify: 4x − 0.1x", Choices := array{"3.9", "4.1x", "0.1x", "3.9x"}, Answer := 3, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", ""}, Explanation := "Like terms: 4 − 0.1 = 3.9, so 4x − 0.1x = 3.9x."},
        fnm_item{Id := "linear-expressions/t5/010", Tier := 5, Prompt := "Simplify: 3x − 0.5x", Choices := array{"2.5x", "2.5", "3.5x", "0.5x"}, Answer := 0, Feedback := array{"", "Keep the letter. Only the coefficients combine; the letter stays on.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2."}, Explanation := "Like terms: 3 − 0.5 = 2.5, so 3x − 0.5x = 2.5x."},
        fnm_item{Id := "linear-expressions/t5/011", Tier := 5, Prompt := "Simplify: (3/5)t − (1/10)t", Choices := array{"(1/5)t", "(3/5)t", "1/2", "(1/2)t"}, Answer := 3, Feedback := array{"Rename BOTH fractions with the common denominator, then add the tops.", "Don\'t leave a term out. Every term is either combined or kept.", "Keep the letter. Only the coefficients combine; the letter stays on.", ""}, Explanation := "Use denominator 10: 6/10 − 1/10 = 5/10 = 1/2. So (1/2)t."},
        fnm_item{Id := "linear-expressions/t5/012", Tier := 5, Prompt := "1.05p means p went up by what percent?", Choices := array{"105%", "5%", "1.05%", "10.5%"}, Answer := 1, Feedback := array{"1.2p is 120% of p. The change is only how far it is from 100%.", "", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "Check the decimal point: 5% is 0.05 and 50% is 0.5."}, Explanation := "1.05p = p + 0.05p, and 0.05 is 5%, so p went up by 5%."},
        fnm_item{Id := "linear-expressions/t5/013", Tier := 5, Prompt := "Simplify: 3p + 0.6p", Choices := array{"3.6", "3.06p", "3.6p", "2.4p"}, Answer := 2, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2)."}, Explanation := "Like terms: 3 + 0.6 = 3.6, so 3p + 0.6p = 3.6p."},
        fnm_item{Id := "linear-expressions/t5/014", Tier := 5, Prompt := "Simplify: (4/5)y − (1/2)y", Choices := array{"(2/5)y", "(4/5)y", "3/10", "(3/10)y"}, Answer := 3, Feedback := array{"Like terms ADD or SUBTRACT their coefficients. Don\'t multiply them.", "Don\'t leave a term out. Every term is either combined or kept.", "Keep the letter. Only the coefficients combine; the letter stays on.", ""}, Explanation := "Use denominator 10: 8/10 − 5/10 = 3/10. So (3/10)y."},
        fnm_item{Id := "linear-expressions/t5/015", Tier := 5, Prompt := "Increase by 40%: multiply by what?", Choices := array{"40", "0.4", "1.04", "1.4"}, Answer := 3, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", ""}, Explanation := "40% is 0.4. The whole is 1, and the change adds 0.4: 1 + 0.4 = 1.4."},
        fnm_item{Id := "linear-expressions/t5/016", Tier := 5, Prompt := "Price p, then 20% tax. Total price?", Choices := array{"p + 20", "0.8p", "0.2p", "1.2p"}, Answer := 3, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", ""}, Explanation := "Adding 20% of p: p + 0.2p = 1.2p."},
        fnm_item{Id := "linear-expressions/t5/017", Tier := 5, Prompt := "Simplify: 4p − 0.1p", Choices := array{"3.9", "3.9p", "4.1p", "0.1p"}, Answer := 1, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2."}, Explanation := "Like terms: 4 − 0.1 = 3.9, so 4p − 0.1p = 3.9p."},
        fnm_item{Id := "linear-expressions/t5/018", Tier := 5, Prompt := "A price rises 50%. New price = old price × ?", Choices := array{"50", "1.05", "1.5", "0.5"}, Answer := 2, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2)."}, Explanation := "50% is 0.5. The whole is 1, and the change adds 0.5: 1 + 0.5 = 1.5."},
        fnm_item{Id := "linear-expressions/t5/019", Tier := 5, Prompt := "A plant is h tall and grows 40%. New height?", Choices := array{"h + 40", "1.04h", "1.4h", "0.4h"}, Answer := 2, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2."}, Explanation := "Adding 40% of h: h + 0.4h = 1.4h."},
        fnm_item{Id := "linear-expressions/t5/020", Tier := 5, Prompt := "A bike costs b. Sale: 10% off. Sale price?", Choices := array{"b − 10", "0.99b", "1.1b", "0.9b"}, Answer := 3, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", ""}, Explanation := "Taking off 10% of b: b − 0.1b = 0.9b."},
        fnm_item{Id := "linear-expressions/t5/021", Tier := 5, Prompt := "Price p, then 5% tax. Total price?", Choices := array{"p + 5", "0.05p", "0.95p", "1.05p"}, Answer := 3, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", ""}, Explanation := "Adding 5% of p: p + 0.05p = 1.05p."},
        fnm_item{Id := "linear-expressions/t5/022", Tier := 5, Prompt := "A shirt costs s. It goes 60% off. Sale price?", Choices := array{"0.4s", "s − 60", "0.94s", "0.6s"}, Answer := 0, Feedback := array{"", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2."}, Explanation := "Taking off 60% of s: s − 0.6s = 0.4s."},
        fnm_item{Id := "linear-expressions/t5/023", Tier := 5, Prompt := "A price rises 5%. New price = old price × ?", Choices := array{"5", "0.95", "1.05", "0.05"}, Answer := 2, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", "", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2."}, Explanation := "5% is 0.05. The whole is 1, and the change adds 0.05: 1 + 0.05 = 1.05."},
        fnm_item{Id := "linear-expressions/t5/024", Tier := 5, Prompt := "Simplify: 3w − 0.5w", Choices := array{"2.5", "0.5w", "3.5w", "2.5w"}, Answer := 3, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", ""}, Explanation := "Like terms: 3 − 0.5 = 2.5, so 3w − 0.5w = 2.5w."},
        fnm_item{Id := "linear-expressions/t5/025", Tier := 5, Prompt := "0.75b means b dropped by what percent?", Choices := array{"25%", "75%", "0.75%", "7.5%"}, Answer := 0, Feedback := array{"", "1.2p is 120% of p. The change is only how far it is from 100%.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "Check the decimal point: 5% is 0.05 and 50% is 0.5."}, Explanation := "0.75b = b − 0.25b, and 0.25 is 25%, so b dropped by 25%."},
        fnm_item{Id := "linear-expressions/t5/026", Tier := 5, Prompt := "A game costs g. Now 60% off. New price?", Choices := array{"0.4g", "g − 60", "0.94g", "1.6g"}, Answer := 0, Feedback := array{"", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2)."}, Explanation := "Taking off 60% of g: g − 0.6g = 0.4g."},
        fnm_item{Id := "linear-expressions/t5/027", Tier := 5, Prompt := "Simplify: (2/3)p − (1/9)p", Choices := array{"(1/9)p", "(5/9)p", "(2/3)p", "5/9"}, Answer := 1, Feedback := array{"Rename BOTH fractions with the common denominator, then add the tops.", "", "Don\'t leave a term out. Every term is either combined or kept.", "Keep the letter. Only the coefficients combine; the letter stays on."}, Explanation := "Use denominator 9: 6/9 − 1/9 = 5/9. So (5/9)p."},
        fnm_item{Id := "linear-expressions/t5/028", Tier := 5, Prompt := "Rectangle: width c, length 3c + 3. Perimeter?", Choices := array{"7c + 6", "4c + 3", "8c + 6", "8c + 3"}, Answer := 2, Feedback := array{"Count all 4 sides: the width twice and the length twice.", "The perimeter goes all the way around: two widths AND two lengths.", "", "Multiply EVERY term inside ( ) by the outside number, not just the first."}, Explanation := "All 4 sides: c + (3c + 3) + c + (3c + 3). Combine like terms: 8c + 6."},
        fnm_item{Id := "linear-expressions/t5/029", Tier := 5, Prompt := "Cost c, with 50% taken off. New cost?", Choices := array{"c − 50", "0.5c", "0.95c", "1.5c"}, Answer := 1, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2)."}, Explanation := "Taking off 50% of c: c − 0.5c = 0.5c."},
        fnm_item{Id := "linear-expressions/t5/030", Tier := 5, Prompt := "Decrease by 40%: multiply by what?", Choices := array{"0.4", "0.6", "40", "0.96"}, Answer := 1, Feedback := array{"That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5."}, Explanation := "40% is 0.4. The whole is 1, and the change takes away 0.4: 1 − 0.4 = 0.6."},
        fnm_item{Id := "linear-expressions/t5/031", Tier := 5, Prompt := "Cost c rises 10%. New cost?", Choices := array{"0.1c", "c + 10", "0.9c", "1.1c"}, Answer := 3, Feedback := array{"That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "Off or a drop means subtract (1 − 0.2). A rise or tax means add (1 + 0.2).", ""}, Explanation := "Adding 10% of c: c + 0.1c = 1.1c."},
        fnm_item{Id := "linear-expressions/t5/032", Tier := 5, Prompt := "Rectangle: width w, length 2w + 4. Perimeter?", Choices := array{"6w + 8", "5w + 8", "14w", "6w + 4"}, Answer := 0, Feedback := array{"", "Count all 4 sides: the width twice and the length twice.", "Only like terms combine. A letter term and a plain number can\'t merge.", "Multiply EVERY term inside ( ) by the outside number, not just the first."}, Explanation := "All 4 sides: w + (2w + 4) + w + (2w + 4). Combine like terms: 6w + 8."},
        fnm_item{Id := "linear-expressions/t5/033", Tier := 5, Prompt := "Simplify: (3/5)m − (1/10)m", Choices := array{"(1/5)m", "(1/2)m", "(3/5)m", "1/2"}, Answer := 1, Feedback := array{"Rename BOTH fractions with the common denominator, then add the tops.", "", "Don\'t leave a term out. Every term is either combined or kept.", "Keep the letter. Only the coefficients combine; the letter stays on."}, Explanation := "Use denominator 10: 6/10 − 1/10 = 5/10 = 1/2. So (1/2)m."},
        fnm_item{Id := "linear-expressions/t5/034", Tier := 5, Prompt := "Simplify: 4b + 0.1b", Choices := array{"4.1", "4.1b", "0.1b", "4.01b"}, Answer := 1, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5."}, Explanation := "Like terms: 4 + 0.1 = 4.1, so 4b + 0.1b = 4.1b."},
        fnm_item{Id := "linear-expressions/t5/035", Tier := 5, Prompt := "Simplify: 3p + 0.1p", Choices := array{"3.1", "0.1p", "3.01p", "3.1p"}, Answer := 3, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", ""}, Explanation := "Like terms: 3 + 0.1 = 3.1, so 3p + 0.1p = 3.1p."},
        fnm_item{Id := "linear-expressions/t5/036", Tier := 5, Prompt := "Simplify: (1/2)n + (2/5)n", Choices := array{"(9/10)n", "(1/5)n", "(3/7)n", "(3/10)n"}, Answer := 0, Feedback := array{"", "Like terms ADD or SUBTRACT their coefficients. Don\'t multiply them.", "Don\'t add the bottoms. Use a common denominator and add only the tops.", "Rename BOTH fractions with the common denominator, then add the tops."}, Explanation := "Use denominator 10: 5/10 + 4/10 = 9/10. So (9/10)n."},
        fnm_item{Id := "linear-expressions/t5/037", Tier := 5, Prompt := "Rectangle: width m, length m + 1. Perimeter?", Choices := array{"6m", "4m + 2", "3m + 2", "2m + 1"}, Answer := 1, Feedback := array{"Only like terms combine. A letter term and a plain number can\'t merge.", "", "Count all 4 sides: the width twice and the length twice.", "The perimeter goes all the way around: two widths AND two lengths."}, Explanation := "All 4 sides: m + (m + 1) + m + (m + 1). Combine like terms: 4m + 2."},
        fnm_item{Id := "linear-expressions/t5/038", Tier := 5, Prompt := "A shirt costs s. It goes 75% off. Sale price?", Choices := array{"s − 75", "0.75s", "0.25s", "s − 0.75"}, Answer := 2, Feedback := array{"A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2.", "That\'s only the extra part. Combine it with the whole: 1 + 0.2 = 1.2.", "", "A percent is a part OF the amount (like 0.2p), not a plain 20 or 0.2."}, Explanation := "Taking off 75% of s: s − 0.75s = 0.25s."},
        fnm_item{Id := "linear-expressions/t5/039", Tier := 5, Prompt := "1.05m means m went up by what percent?", Choices := array{"105%", "1.05%", "5%", "10.5%"}, Answer := 2, Feedback := array{"1.2p is 120% of p. The change is only how far it is from 100%.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "", "Check the decimal point: 5% is 0.05 and 50% is 0.5."}, Explanation := "1.05m = m + 0.05m, and 0.05 is 5%, so m went up by 5%."},
        fnm_item{Id := "linear-expressions/t5/040", Tier := 5, Prompt := "0.4n means n dropped by what percent?", Choices := array{"60%", "40%", "0.4%", "4%"}, Answer := 0, Feedback := array{"", "1.2p is 120% of p. The change is only how far it is from 100%.", "Check the decimal point: 5% is 0.05 and 50% is 0.5.", "Check the decimal point: 5% is 0.05 and 50% is 0.5."}, Explanation := "0.4n = n − 0.6n, and 0.6 is 60%, so n dropped by 60%."}
    }
}

