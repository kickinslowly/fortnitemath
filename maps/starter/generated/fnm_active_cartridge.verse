        fnm_item{Id := "circles/t3/001", Tier := 3, Prompt := "A sprinkler waters a circle, diameter 6. Area?", Choices := array{"3π", "9π", "6π", "36π"}, Answer := 1, Feedback := array{"Area needs r × r: square the radius, don\'t just use it.", "", "That\'s the circumference. Area is π × radius × radius.", "In π × r × r, r is the RADIUS. Use half the diameter."}, Explanation := "Radius = 6 ÷ 2 = 3. Area = π × 3 × 3 = 9π."},
        fnm_item{Id := "circles/t3/002", Tier := 3, Prompt := "Area of a circle is π times what?", Choices := array{"diameter²", "diameter", "radius²", "radius"}, Answer := 2, Feedback := array{"In π × r × r, r is the RADIUS. Use half the diameter.", "That\'s the circumference. Area is π × radius × radius.", "", "Area needs r × r: square the radius, don\'t just use it."}, Explanation := "Area = π × radius × radius: π times the radius squared."},
        fnm_item{Id := "circles/t3/003", Tier := 3, Prompt := "A sprinkler waters a circle, radius 9. Area?", Choices := array{"18π", "9π", "81π", "81"}, Answer := 2, Feedback := array{"That\'s the circumference. Area is π × radius × radius.", "Area needs r × r: square the radius, don\'t just use it.", "", "Don\'t drop π: it is part of every circle formula (use 3 if told)."}, Explanation := "Area = π × radius × radius: 9 × 9 = 81, so 81π."},
        fnm_item{Id := "circles/t3/004", Tier := 3, Prompt := "A sprinkler waters a circle, radius 7. Area?", Choices := array{"49", "14π", "49π", "196π"}, Answer := 2, Feedback := array{"Don\'t drop π: it is part of every circle formula (use 3 if told).", "That\'s the circumference. Area is π × radius × radius.", "", "Square the radius as given: π × r × r. Don\'t double it first."}, Explanation := "Area = π × radius × radius: 7 × 7 = 49, so 49π."},
        fnm_item{Id := "circles/t3/005", Tier := 3, Prompt := "A pizza has radius 10. Its area?", Choices := array{"20π", "10π", "400π", "100π"}, Answer := 3, Feedback := array{"That\'s the circumference. Area is π × radius × radius.", "Area needs r × r: square the radius, don\'t just use it.", "Square the radius as given: π × r × r. Don\'t double it first.", ""}, Explanation := "Area = π × radius × radius: 10 × 10 = 100, so 100π."},
        fnm_item{Id := "circles/t3/006", Tier := 3, Prompt := "Circle: radius 7. Area?", Choices := array{"14π", "7π", "49", "49π"}, Answer := 3, Feedback := array{"That\'s the circumference. Area is π × radius × radius.", "Area needs r × r: square the radius, don\'t just use it.", "Don\'t drop π: it is part of every circle formula (use 3 if told).", ""}, Explanation := "Area = π × radius × radius: 7 × 7 = 49, so 49π."},
        fnm_item{Id := "circles/t3/007", Tier := 3, Prompt := "A rug has diameter 8. Its area?", Choices := array{"16π", "8π", "64π", "16"}, Answer := 0, Feedback := array{"", "That\'s the circumference. Area is π × radius × radius.", "In π × r × r, r is the RADIUS. Use half the diameter.", "Don\'t drop π: it is part of every circle formula (use 3 if told)."}, Explanation := "Radius = 8 ÷ 2 = 4. Area = π × 4 × 4 = 16π."},
        fnm_item{Id := "circles/t3/008", Tier := 3, Prompt := "Circle: diameter 6. Area?", Choices := array{"9", "36π", "3π", "9π"}, Answer := 3, Feedback := array{"Don\'t drop π: it is part of every circle formula (use 3 if told).", "In π × r × r, r is the RADIUS. Use half the diameter.", "Area needs r × r: square the radius, don\'t just use it.", ""}, Explanation := "Radius = 6 ÷ 2 = 3. Area = π × 3 × 3 = 9π."},
        fnm_item{Id := "circles/t3/009", Tier := 3, Prompt := "A rug (radius 2) and a mat (radius 4). Total area?", Choices := array{"20π", "16π", "12π", "36π"}, Answer := 0, Feedback := array{"", "You used only one circle. Add both areas.", "That\'s the circumference. Area is π × radius × radius.", "Add the AREAS, not the radii. Find each π × r × r first, then add."}, Explanation := "Each area is π × r × r: 4π and 16π. Add: 4 + 16 = 20, so 20π."},
        fnm_item{Id := "circles/t3/010", Tier := 3, Prompt := "Radius is halved. Area is how many times as big?", Choices := array{"6", "1/2", "1/4", "1/8"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Area uses r × r, so it grows by the scale factor squared.", "", "Cubing is for volume. Lengths scale by k, areas by k × k."}, Explanation := "Area uses r × r, so the factor is squared: 1/2 × 1/2 = 1/4."},
        fnm_item{Id := "circles/t3/011", Tier := 3, Prompt := "Circle: radius 6. Area?", Choices := array{"12π", "36π", "144π", "36"}, Answer := 1, Feedback := array{"That\'s the circumference. Area is π × radius × radius.", "", "Square the radius as given: π × r × r. Don\'t double it first.", "Don\'t drop π: it is part of every circle formula (use 3 if told)."}, Explanation := "Area = π × radius × radius: 6 × 6 = 36, so 36π."},
        fnm_item{Id := "circles/t3/012", Tier := 3, Prompt := "Circle: radius 5. Area?", Choices := array{"25", "5π", "10π", "25π"}, Answer := 3, Feedback := array{"Don\'t drop π: it is part of every circle formula (use 3 if told).", "Area needs r × r: square the radius, don\'t just use it.", "That\'s the circumference. Area is π × radius × radius.", ""}, Explanation := "Area = π × radius × radius: 5 × 5 = 25, so 25π."},
