        fnm_item{Id := "expressions/t2/031", Tier := 2, Prompt := "Coefficient of a in 10 + 2a?", Choices := array{"2", "2a", "10", "a"}, Answer := 0, Feedback := array{"", "That\'s the whole term. The coefficient is just its number: 7 in 7x.", "Coefficient: the number times a letter. Constant: a number all alone.", "That\'s the letter (the variable). The question asks for a number."}, Explanation := "In 10 + 2a, 2 multiplies a, so 2 is the coefficient. 10 stands alone: it is the constant."},
        fnm_item{Id := "expressions/t2/032", Tier := 2, Prompt := "What kind of expression is 10(a + 4)?", Choices := array{"sum", "quotient", "difference", "product"}, Answer := 3, Feedback := array{"Name it by the LAST step: 2(x + 5) adds first, multiplies last: product.", "Find the step you\'d do last. That step names it: sum, product...", "Find the step you\'d do last. That step names it: sum, product...", ""}, Explanation := "In 10(a + 4) you add first and multiply last. The last step names it: a product."},
        fnm_item{Id := "expressions/t2/033", Tier := 2, Prompt := "How many terms in 9x + 9y + 2?", Choices := array{"2", "3", "5", "4"}, Answer := 1, Feedback := array{"A number alone is a term too: 3a + 2b + 5 has 3 terms.", "", "A term is a whole piece between + signs: 3a is one term, not two.", "Check your arithmetic."}, Explanation := "Terms are the pieces joined by +: 9x, 9y, 2. That is 3 terms."},
