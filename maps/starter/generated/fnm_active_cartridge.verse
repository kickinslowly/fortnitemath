        fnm_item{Id := "equations-inequalities/t5/013", Tier := 5, Prompt := "A ride takes 3 or more tickets, t. Which fits?", Choices := array{"t \> 3", "t \< 3", "t ≤ 3", "t ≥ 3"}, Answer := 3, Feedback := array{"At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", ""}, Explanation := "3 or more: t ≥ 3. 3 itself counts, so the line goes under the sign."},
