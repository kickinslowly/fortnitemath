        fnm_item{Id := "equations-inequalities/t5/023", Tier := 5, Prompt := "The trip took over 19 days, d. Which fits?", Choices := array{"d \> 19", "d ≥ 19", "d \< 19", "d ≤ 19"}, Answer := 0, Feedback := array{"", "At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "More than 19: d \> 19. 19 itself does not count, so no line under the sign."},
        fnm_item{Id := "equations-inequalities/t5/024", Tier := 5, Prompt := "Less than 12 minutes, m, remain. Which fits?", Choices := array{"m ≤ 12", "m \< 12", "m \> 12", "m ≥ 12"}, Answer := 1, Feedback := array{"At least / at most include the number (≥ ≤). More / fewer than do not.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "Less than 12: m \< 12. 12 itself does not count, so no line under the sign."},
        fnm_item{Id := "equations-inequalities/t5/025", Tier := 5, Prompt := "Which makes 6 \> n true?", Choices := array{"6", "8", "4", "7"}, Answer := 2, Feedback := array{"\< and \> leave out the number itself: 4 \< 4 is false.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "6 \> n means n \< 6. Try 4: 6 \> 4 is true. 6 \< 6 is false: 6 is not a solution."},
        fnm_item{Id := "equations-inequalities/t5/026", Tier := 5, Prompt := "At most 10 kids, k, fit in the van. Which fits?", Choices := array{"k \< 10", "k ≤ 10", "k ≥ 10", "k \> 10"}, Answer := 1, Feedback := array{"At least / at most include the number (≥ ≤). More / fewer than do not.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "10 or less: k ≤ 10. 10 itself counts, so the line goes under the sign."},
