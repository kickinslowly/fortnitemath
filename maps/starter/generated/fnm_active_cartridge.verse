        fnm_item{Id := "fraction-division/t5/031", Tier := 5, Prompt := "3/8 of a bag of dog food weighs 6 lb. Whole bag?", Choices := array{"1/16 lb", "16 lb", "2 1/4 lb", "48 lb"}, Answer := 1, Feedback := array{"Backwards: start with the amount you have, then divide it.", "", "You multiplied as is. To divide, multiply by the flipped divisor.", "Flip the whole divisor: ÷ 3/4 means × 4/3, not just × 4."}, Explanation := "3/8 of the bag is 6 lb, so whole = 6 ÷ 3/8 = 6 × 8/3 = 48/3 = 16 lb."},
        fnm_item{Id := "fraction-division/t5/032", Tier := 5, Prompt := "5/6 cup of flour, 1/3 cup per batch. How many batches?", Choices := array{"2/5", "5/18", "2 1/2", "3 3/5"}, Answer := 2, Feedback := array{"Backwards: start with the amount you have, then divide it.", "You multiplied as is. To divide, multiply by the flipped divisor.", "", "Flip only the second fraction. The first one stays as it is."}, Explanation := "Groups of 1/3 in 5/6: 5/6 ÷ 1/3 = 5/6 × 3 = 15/6 = 2 1/2."},
