        fnm_item{Id := "circles/t1/029", Tier := 1, Prompt := "A wheel has diameter 5. Its radius?", Choices := array{"0.5", "5", "2.5", "10"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Radius and diameter are different: the diameter is twice the radius.", "", "Radius is half the diameter: it only goes to the center."}, Explanation := "Radius = diameter ÷ 2: 5 ÷ 2 = 2.5."},
        fnm_item{Id := "circles/t1/030", Tier := 1, Prompt := "A pond has radius 6. What is its diameter?", Choices := array{"6", "12π", "3", "12"}, Answer := 3, Feedback := array{"Radius and diameter are different: the diameter is twice the radius.", "Diameter is straight across. The distance around needs π.", "Diameter is twice the radius: it goes all the way across.", ""}, Explanation := "Diameter = 2 × radius: 2 × 6 = 12."},
        fnm_item{Id := "circles/t1/031", Tier := 1, Prompt := "Circle: radius 5. Diameter?", Choices := array{"10π", "10", "5", "2.5"}, Answer := 1, Feedback := array{"Diameter is straight across. The distance around needs π.", "", "Radius and diameter are different: the diameter is twice the radius.", "Diameter is twice the radius: it goes all the way across."}, Explanation := "Diameter = 2 × radius: 2 × 5 = 10."},
        fnm_item{Id := "circles/t1/032", Tier := 1, Prompt := "A wheel has radius 10. Its diameter?", Choices := array{"5", "20π", "20", "10"}, Answer := 2, Feedback := array{"Diameter is twice the radius: it goes all the way across.", "Diameter is straight across. The distance around needs π.", "", "Radius and diameter are different: the diameter is twice the radius."}, Explanation := "Diameter = 2 × radius: 2 × 10 = 20."},
        fnm_item{Id := "circles/t1/033", Tier := 1, Prompt := "Circle: radius 7. Circumference ÷ radius?", Choices := array{"7", "2π", "π", "1/(2π)"}, Answer := 1, Feedback := array{"The ratio does not depend on size. Every circle gives the same number.", "", "Circumference ÷ radius is 2π. Only ÷ diameter gives π.", "You flipped it: the circumference is the big number on top."}, Explanation := "C = 2πr, so circumference ÷ radius = 2π."},
