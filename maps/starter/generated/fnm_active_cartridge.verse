        fnm_item{Id := "percent-problems/t5/001", Tier := 5, Prompt := "Cost $20, marked up 20%, then 25% off that. Price?", Choices := array{"$18", "$30", "$24", "$19"}, Answer := 0, Feedback := array{"", "Check the direction: tax and markups add, discounts take away.", "There is a second step. Take the second percent of the new price too.", "Do one percent at a time. The second is of the new price, not the original."}, Explanation := "10% of $20 is $2, so 20% is $4; $20 + $4 = $24. 25% is 1/4 of $24: $6; $24 − $6 = $18."},
        fnm_item{Id := "percent-problems/t5/002", Tier := 5, Prompt := "Measured 24 cm. True length: 30 cm. Percent error?", Choices := array{"25%", "80%", "20%", "6%"}, Answer := 2, Feedback := array{"Percent error compares the miss with the ACTUAL value, not the guess.", "That is guess compared to actual. Percent error is only the miss.", "", "A change of 5 is not 5%. Divide the change by the original (or actual) value."}, Explanation := "Miss: 30 − 24 = 6. Compare with the actual 30. 10% of 30 is 3; 6 is 2 of those, so 20%."},
        fnm_item{Id := "percent-problems/t5/003", Tier := 5, Prompt := "$40 jacket, 25% off, then 10% off the sale price. Price?", Choices := array{"$26", "$27", "$30", "$20"}, Answer := 1, Feedback := array{"Do one percent at a time. The second is of the new price, not the original.", "", "There is a second step. Take the second percent of the new price too.", "The % number is not dollars. Find that percent OF the price first."}, Explanation := "25% is 1/4 of $40: $10; $40 − $10 = $30. 10% of $30 is $3; $30 − $3 = $27."},
        fnm_item{Id := "percent-problems/t5/004", Tier := 5, Prompt := "The $16 item is marked up 50%, then 25% off that. Price?", Choices := array{"$18", "$24", "$30", "$20"}, Answer := 0, Feedback := array{"", "There is a second step. Take the second percent of the new price too.", "Check the direction: tax and markups add, discounts take away.", "Do one percent at a time. The second is of the new price, not the original."}, Explanation := "50% is half of $16: $8; $16 + $8 = $24. 25% is 1/4 of $24: $6; $24 − $6 = $18."},
        fnm_item{Id := "percent-problems/t5/005", Tier := 5, Prompt := "Scale shows 40 lb. True weight: 50 lb. Percent error?", Choices := array{"25%", "80%", "20%", "10%"}, Answer := 2, Feedback := array{"Percent error compares the miss with the ACTUAL value, not the guess.", "That is guess compared to actual. Percent error is only the miss.", "", "A change of 5 is not 5%. Divide the change by the original (or actual) value."}, Explanation := "Miss: 50 − 40 = 10. Compare with the actual 50. 10% of 50 is 5; 10 is 2 of those, so 20%."},
