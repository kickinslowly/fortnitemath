        fnm_item{Id := "proportional-relationships/t2/031", Tier := 2, Prompt := "x: 3, 6, 9. y: 9, 18, 27. Which equation fits?", Choices := array{"y = x + 6", "y = 3x", "x = 3y", "y = 9x"}, Answer := 1, Feedback := array{"y = x + 4 adds the same amount. Proportional means multiply: y = kx.", "", "Swapped. y is the one that equals k times x, so y = kx.", "That is a y value, not k. Divide: k = y ÷ x."}, Explanation := "y ÷ x is 3 every time (9 ÷ 3 = 3), so y = 3x."},
        fnm_item{Id := "proportional-relationships/t2/032", Tier := 2, Prompt := "Which shows p proportional to h, k = 2?", Choices := array{"p = 2h", "h = 2p", "p = 2h + 4", "p = h + 2"}, Answer := 0, Feedback := array{"", "Swapped. y is the one that equals k times x, so y = kx.", "y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx."}, Explanation := "Proportional means p = kh with nothing added. With k = 2: p = 2h."},
        fnm_item{Id := "proportional-relationships/t2/033", Tier := 2, Prompt := "(4, 32) is on y = kx. Which point is also on it?", Choices := array{"(9, 72)", "(9, 75)", "(9, 37)", "(72, 9)"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "Swapped. y is the one that equals k times x, so y = kx."}, Explanation := "32 ÷ 4 = 8, so y = 8x. At x = 9: 8 × 9 = 72. Point (9, 72)."},
        fnm_item{Id := "proportional-relationships/t2/034", Tier := 2, Prompt := "Which equation has c proportional to n with k = 9?", Choices := array{"c = 9n + 4", "n = 9c", "c = 9n", "c = n + 9"}, Answer := 2, Feedback := array{"y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "Swapped. y is the one that equals k times x, so y = kx.", "", "y = x + 4 adds the same amount. Proportional means multiply: y = kx."}, Explanation := "Proportional means c = kn with nothing added. With k = 9: c = 9n."},
        fnm_item{Id := "proportional-relationships/t2/035", Tier := 2, Prompt := "x: 3, 6, 9. y: 27, 54, 81. Which equation fits?", Choices := array{"y = 27x", "y = 9x", "x = 9y", "y = x + 24"}, Answer := 1, Feedback := array{"That is a y value, not k. Divide: k = y ÷ x.", "", "Swapped. y is the one that equals k times x, so y = kx.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx."}, Explanation := "y ÷ x is 9 every time (27 ÷ 3 = 9), so y = 9x."},
        fnm_item{Id := "proportional-relationships/t2/036", Tier := 2, Prompt := "(5, 30) is on y = kx. Which point is also on it?", Choices := array{"(2, 27)", "(2, 75)", "(12, 2)", "(2, 12)"}, Answer := 3, Feedback := array{"Scaling multiplies or divides. Adding or subtracting is not scaling.", "Same direction: if x goes down by a factor, y goes down by that factor too.", "Swapped. y is the one that equals k times x, so y = kx.", ""}, Explanation := "30 ÷ 5 = 6, so y = 6x. At x = 2: 6 × 2 = 12. Point (2, 12)."},
        fnm_item{Id := "proportional-relationships/t2/037", Tier := 2, Prompt := "x: 1, 3, 4. y: 10, 12, 13. Which equation fits?", Choices := array{"x = y + 9", "y = 10x", "y = 9x", "y = x + 9"}, Answer := 3, Feedback := array{"Swapped. y is the one that equals k times x, so y = kx.", "Check every pair. y ÷ x changes, so this is not proportional.", "The table adds the same amount each time: y = x + c, not y = cx.", ""}, Explanation := "10 ÷ 1 and 12 ÷ 3 differ, so not proportional. Each y is x + 9: y = x + 9."},
