        fnm_item{Id := "fraction-division/t5/009", Tier := 5, Prompt := "Rectangle: area 3/8 sq ft, width 1/4 ft. Length?", Choices := array{"2/3 ft", "3/32 ft", "10 2/3 ft", "1 1/2 ft"}, Answer := 3, Feedback := array{"Backwards: start with the amount you have, then divide it.", "You multiplied as is. To divide, multiply by the flipped divisor.", "Flip only the second fraction. The first one stays as it is.", ""}, Explanation := "Length = area ÷ width: 3/8 ÷ 1/4 = 3/8 × 4 = 12/8 = 1 1/2 ft."},
        fnm_item{Id := "fraction-division/t5/010", Tier := 5, Prompt := "6 friends split 1/2 of a pizza equally. How much each?", Choices := array{"12", "3", "1/11", "1/12"}, Answer := 3, Feedback := array{"Backwards: start with the amount you have, then divide it.", "Dividing by a whole number makes it smaller: split it into that many parts.", "Check your arithmetic.", ""}, Explanation := "Share 1/2 into 6 parts: 1/2 ÷ 6 = 1/2 × 1/6 = 1/12."},
