        fnm_item{Id := "circles/t3/025", Tier := 3, Prompt := "Radius × radius × π gives a circle\'s what?", Choices := array{"area", "diameter", "circumference", "radius"}, Answer := 0, Feedback := array{"", "Around = circumference, inside = area, across = diameter, center-out = radius.", "Around = circumference, inside = area, across = diameter, center-out = radius.", "Around = circumference, inside = area, across = diameter, center-out = radius."}, Explanation := "π × r × r is the area, the space inside the circle."},
