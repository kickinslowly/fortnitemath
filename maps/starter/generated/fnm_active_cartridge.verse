FnmCartridge_linear_expressions():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "linear-expressions",
    Version := "1.0.0",
    Title := "Equivalent Expressions",
    Subtitle := "Combine, Expand \& Factor with Signs",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Combine Like Terms", Description := "Combine like terms when some coefficients are negative: 5x − 8x = −3x."},
        fnm_tier{Tier := 2, Name := "Distribute Negatives", Description := "Multiply a bracket by a negative number or a minus sign: −3(x − 4) = −3x + 12."},
        fnm_tier{Tier := 3, Name := "Add \& Subtract Groups", Description := "Add or subtract whole expressions: (5x + 2) − (2x − 3) = 3x + 5."},
        fnm_tier{Tier := 4, Name := "Factoring", Description := "Pull out a common factor, even a negative one: −4x + 8 = −4(x − 2)."},
        fnm_tier{Tier := 5, Name := "Rewrite to Show Meaning", Description := "Same value, new form: 20% off p is 0.8p, and a + 0.05a is 1.05a."}
    },
    Items := array{
        fnm_item{Id := "linear-expressions/t1/001", Tier := 1, Prompt := "Simplify: −8t + 11 − 4t", Choices := array{"12t + 11", "−1", "−12t + 11", "−t"}, Answer := 2, Feedback := array{"Right size, wrong sign. Check which number is bigger and what its sign is.", "Keep the letter. Only the coefficients combine; the letter stays on.", "", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Like terms: −8t − 4t = −12t. 11 has no t, so it stays: −12t + 11."},
        fnm_item{Id := "linear-expressions/t1/002", Tier := 1, Prompt := "Simplify: −6p + 6t + 8p", Choices := array{"2p + 6t", "14p + 6t", "2p", "8p"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Don\'t leave a term out. Every term is either combined or kept.", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Combine only the p terms: −6p + 8p = 2p. The t term stays: 2p + 6t."},
        fnm_item{Id := "linear-expressions/t1/003", Tier := 1, Prompt := "Simplify: −7k + 3k", Choices := array{"−4k", "4k", "−4", "−10k"}, Answer := 0, Feedback := array{"", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Keep the letter. Only the coefficients combine; the letter stays on.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Add the coefficients: −7 + 3 = −4. So −7k + 3k = −4k."},
        fnm_item{Id := "linear-expressions/t1/004", Tier := 1, Prompt := "Simplify: −5b + 8 − 2b", Choices := array{"−3b + 8", "1", "−7b + 8", "b"}, Answer := 2, Feedback := array{"A minus sign means take that term away. Don\'t turn it into a plus.", "Keep the letter. Only the coefficients combine; the letter stays on.", "", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Like terms: −5b − 2b = −7b. 8 has no b, so it stays: −7b + 8."},
        fnm_item{Id := "linear-expressions/t1/005", Tier := 1, Prompt := "Simplify: 7 − 9p + p", Choices := array{"−9p + 7", "−8p + 7", "8p + 7", "−10p + 7"}, Answer := 1, Feedback := array{"A letter alone is 1 of it (a is 1a, −a is −1a). Don\'t skip it.", "", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Like terms: −9p + p = −8p. 7 has no p, so it stays: −8p + 7."},
        fnm_item{Id := "linear-expressions/t1/006", Tier := 1, Prompt := "Simplify: 4w − 2w", Choices := array{"6w", "−2w", "2", "2w"}, Answer := 3, Feedback := array{"A minus sign means take that term away. Don\'t turn it into a plus.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Keep the letter. Only the coefficients combine; the letter stays on.", ""}, Explanation := "Add the coefficients: 4 − 2 = 2. So 4w − 2w = 2w."},
        fnm_item{Id := "linear-expressions/t1/007", Tier := 1, Prompt := "Simplify: 4p + 3p − 2t", Choices := array{"7p", "7p + 2t", "7p − 2t", "5p"}, Answer := 2, Feedback := array{"Don\'t leave a term out. Every term is either combined or kept.", "A minus sign means take that term away. Don\'t turn it into a plus.", "", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Combine only the p terms: 4p + 3p = 7p. The t term stays: 7p − 2t."},
        fnm_item{Id := "linear-expressions/t1/008", Tier := 1, Prompt := "Simplify: a − 10a", Choices := array{"−11a", "−9a", "11a", "−9"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "", "A minus sign means take that term away. Don\'t turn it into a plus.", "Keep the letter. Only the coefficients combine; the letter stays on."}, Explanation := "Add the coefficients (a alone is 1a): 1 − 10 = −9. So a − 10a = −9a."},
        fnm_item{Id := "linear-expressions/t1/009", Tier := 1, Prompt := "Simplify: 7w − 11w", Choices := array{"−4w", "−18w", "4w", "18w"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "Add the coefficients: 7 − 11 = −4. So 7w − 11w = −4w."},
        fnm_item{Id := "linear-expressions/t1/010", Tier := 1, Prompt := "Simplify: 9b − 3b", Choices := array{"6", "−6b", "6b", "12b"}, Answer := 2, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "Add the coefficients: 9 − 3 = 6. So 9b − 3b = 6b."},
        fnm_item{Id := "linear-expressions/t1/011", Tier := 1, Prompt := "Simplify: −2y + 3 − 9 + 6y", Choices := array{"4y − 6", "−2y", "4y − 12", "4y + 12"}, Answer := 0, Feedback := array{"", "Only like terms combine. A letter term and a plain number can\'t merge.", "Different signs: subtract the sizes, keep the sign of the bigger one.", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "y terms: −2y + 6y = 4y. Numbers: 3 − 9 = −6. So 4y − 6."},
        fnm_item{Id := "linear-expressions/t1/012", Tier := 1, Prompt := "Simplify: −6y − 5 + 3y", Choices := array{"−8y", "−8", "−3y − 5", "−9y − 5"}, Answer := 2, Feedback := array{"Only like terms combine. A letter term and a plain number can\'t merge.", "Keep the letter. Only the coefficients combine; the letter stays on.", "", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Like terms: −6y + 3y = −3y. −5 has no y, so it stays: −3y − 5."},
        fnm_item{Id := "linear-expressions/t1/013", Tier := 1, Prompt := "Simplify: −2t − 10 + 8t", Choices := array{"−4t", "6t − 10", "−6t − 10", "6t + 10"}, Answer := 1, Feedback := array{"Only like terms combine. A letter term and a plain number can\'t merge.", "", "Right size, wrong sign. Check which number is bigger and what its sign is.", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "Like terms: −2t + 8t = 6t. −10 has no t, so it stays: 6t − 10."},
        fnm_item{Id := "linear-expressions/t1/014", Tier := 1, Prompt := "Simplify: −m + 9 + 5m", Choices := array{"5m + 9", "13m", "4m + 9", "6m + 9"}, Answer := 2, Feedback := array{"A letter alone is 1 of it (a is 1a, −a is −1a). Don\'t skip it.", "Only like terms combine. A letter term and a plain number can\'t merge.", "", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Like terms: −m + 5m = 4m. 9 has no m, so it stays: 4m + 9."},
        fnm_item{Id := "linear-expressions/t1/015", Tier := 1, Prompt := "Simplify: −6n − 3 − 5 − 5n", Choices := array{"−19", "11n − 8", "−11n − 8", "−n − 8"}, Answer := 2, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "n terms: −6n − 5n = −11n. Numbers: −3 − 5 = −8. So −11n − 8."},
        fnm_item{Id := "linear-expressions/t1/016", Tier := 1, Prompt := "Simplify: 6t − 8t", Choices := array{"2t", "−2", "−14t", "−2t"}, Answer := 3, Feedback := array{"Right size, wrong sign. Check which number is bigger and what its sign is.", "Keep the letter. Only the coefficients combine; the letter stays on.", "Different signs: subtract the sizes, keep the sign of the bigger one.", ""}, Explanation := "Add the coefficients: 6 − 8 = −2. So 6t − 8t = −2t."},
        fnm_item{Id := "linear-expressions/t1/017", Tier := 1, Prompt := "Simplify: −9t − 4 + 5t", Choices := array{"−8t", "−8", "−14t − 4", "−4t − 4"}, Answer := 3, Feedback := array{"Only like terms combine. A letter term and a plain number can\'t merge.", "Keep the letter. Only the coefficients combine; the letter stays on.", "Different signs: subtract the sizes, keep the sign of the bigger one.", ""}, Explanation := "Like terms: −9t + 5t = −4t. −4 has no t, so it stays: −4t − 4."},
        fnm_item{Id := "linear-expressions/t1/018", Tier := 1, Prompt := "Simplify: m − 9m", Choices := array{"8m", "10m", "−8m", "−8"}, Answer := 2, Feedback := array{"Right size, wrong sign. Check which number is bigger and what its sign is.", "A minus sign means take that term away. Don\'t turn it into a plus.", "", "Keep the letter. Only the coefficients combine; the letter stays on."}, Explanation := "Add the coefficients (m alone is 1m): 1 − 9 = −8. So m − 9m = −8m."},
        fnm_item{Id := "linear-expressions/t1/019", Tier := 1, Prompt := "Simplify: −8m − 4m − 3", Choices := array{"−12m − 3", "−15m", "12m − 3", "−4m − 3"}, Answer := 0, Feedback := array{"", "Only like terms combine. A letter term and a plain number can\'t merge.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "Like terms: −8m − 4m = −12m. −3 has no m, so it stays: −12m − 3."},
        fnm_item{Id := "linear-expressions/t1/020", Tier := 1, Prompt := "Simplify: −10 − x + 4x", Choices := array{"4x − 10", "3x − 10", "5x − 10", "−7x"}, Answer := 1, Feedback := array{"A letter alone is 1 of it (a is 1a, −a is −1a). Don\'t skip it.", "", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Like terms: −x + 4x = 3x. −10 has no x, so it stays: 3x − 10."},
        fnm_item{Id := "linear-expressions/t1/021", Tier := 1, Prompt := "Simplify: 2b − 5a + 6a", Choices := array{"a", "2b + 11a", "2b − a", "2b + a"}, Answer := 3, Feedback := array{"Don\'t leave a term out. Every term is either combined or kept.", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Right size, wrong sign. Check which number is bigger and what its sign is.", ""}, Explanation := "Combine only the a terms: −5a + 6a = a. The b term stays: 2b + a."},
        fnm_item{Id := "linear-expressions/t1/022", Tier := 1, Prompt := "Simplify: −9a − 5 − a", Choices := array{"−9a − 5", "−10a − 5", "−15", "−15a"}, Answer := 1, Feedback := array{"A letter alone is 1 of it (a is 1a, −a is −1a). Don\'t skip it.", "", "Keep the letter. Only the coefficients combine; the letter stays on.", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Like terms: −9a − a = −10a. −5 has no a, so it stays: −10a − 5."},
        fnm_item{Id := "linear-expressions/t1/023", Tier := 1, Prompt := "Simplify: −9x + 5 + 3x − 1", Choices := array{"−6x + 6", "−6x + 4", "6x + 4", "−2"}, Answer := 1, Feedback := array{"A minus sign means take that term away. Don\'t turn it into a plus.", "", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Keep the letter. Only the coefficients combine; the letter stays on."}, Explanation := "x terms: −9x + 3x = −6x. Numbers: 5 − 1 = 4. So −6x + 4."},
        fnm_item{Id := "linear-expressions/t1/024", Tier := 1, Prompt := "Simplify: −4 + 8k + 7 − 3k", Choices := array{"5k + 3", "8k", "11k + 3", "5k + 11"}, Answer := 0, Feedback := array{"", "Only like terms combine. A letter term and a plain number can\'t merge.", "A minus sign means take that term away. Don\'t turn it into a plus.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "k terms: 8k − 3k = 5k. Numbers: −4 + 7 = 3. So 5k + 3."},
        fnm_item{Id := "linear-expressions/t1/025", Tier := 1, Prompt := "Simplify: 4 − 6k − 5 + 9k", Choices := array{"2", "3k − 1", "2k", "3k − 9"}, Answer := 1, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "", "Only like terms combine. A letter term and a plain number can\'t merge.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "k terms: −6k + 9k = 3k. Numbers: 4 − 5 = −1. So 3k − 1."},
        fnm_item{Id := "linear-expressions/t1/026", Tier := 1, Prompt := "Simplify: −5m + 9n − 3m", Choices := array{"−8m + 9n", "−8m", "−2m + 9n", "8m + 9n"}, Answer := 0, Feedback := array{"", "Don\'t leave a term out. Every term is either combined or kept.", "A minus sign means take that term away. Don\'t turn it into a plus.", "Right size, wrong sign. Check which number is bigger and what its sign is."}, Explanation := "Combine only the m terms: −5m − 3m = −8m. The n term stays: −8m + 9n."},
        fnm_item{Id := "linear-expressions/t1/027", Tier := 1, Prompt := "Simplify: −4y − 3 + 8y", Choices := array{"12y − 3", "4y + 3", "4y − 3", "y"}, Answer := 2, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "A minus sign means take that term away. Don\'t turn it into a plus.", "", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Like terms: −4y + 8y = 4y. −3 has no y, so it stays: 4y − 3."},
        fnm_item{Id := "linear-expressions/t1/028", Tier := 1, Prompt := "Simplify: 2a − 7a + 8b", Choices := array{"−5a + 8b", "−5a", "5a + 8b", "−9a + 8b"}, Answer := 0, Feedback := array{"", "Don\'t leave a term out. Every term is either combined or kept.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Combine only the a terms: 2a − 7a = −5a. The b term stays: −5a + 8b."},
        fnm_item{Id := "linear-expressions/t1/029", Tier := 1, Prompt := "Simplify: 3 + 7y − 4y", Choices := array{"6", "3y + 3", "−3y + 3", "11y + 3"}, Answer := 1, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "", "Right size, wrong sign. Check which number is bigger and what its sign is.", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "Like terms: 7y − 4y = 3y. 3 has no y, so it stays: 3y + 3."},
        fnm_item{Id := "linear-expressions/t1/030", Tier := 1, Prompt := "Simplify: 5c − 2d + 7c", Choices := array{"12c − 2d", "12c", "10c", "12c + 2d"}, Answer := 0, Feedback := array{"", "Don\'t leave a term out. Every term is either combined or kept.", "Only like terms combine. A letter term and a plain number can\'t merge.", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "Combine only the c terms: 5c + 7c = 12c. The d term stays: 12c − 2d."},
        fnm_item{Id := "linear-expressions/t1/031", Tier := 1, Prompt := "Simplify: 8n − n", Choices := array{"7", "−7n", "9n", "7n"}, Answer := 3, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Different signs: subtract the sizes, keep the sign of the bigger one.", ""}, Explanation := "Add the coefficients (n alone is 1n): 8 − 1 = 7. So 8n − n = 7n."},
        fnm_item{Id := "linear-expressions/t1/032", Tier := 1, Prompt := "Simplify: −3y + 2y", Choices := array{"−1", "y", "−5y", "−y"}, Answer := 3, Feedback := array{"Keep the letter. Only the coefficients combine; the letter stays on.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Different signs: subtract the sizes, keep the sign of the bigger one.", ""}, Explanation := "Add the coefficients: −3 + 2 = −1. So −3y + 2y = −y."},
        fnm_item{Id := "linear-expressions/t1/033", Tier := 1, Prompt := "Simplify: 6k − 9k", Choices := array{"15k", "−3k", "−3", "3k"}, Answer := 1, Feedback := array{"A minus sign means take that term away. Don\'t turn it into a plus.", "", "Keep the letter. Only the coefficients combine; the letter stays on.", "Right size, wrong sign. Check which number is bigger and what its sign is."}, Explanation := "Add the coefficients: 6 − 9 = −3. So 6k − 9k = −3k."},
        fnm_item{Id := "linear-expressions/t1/034", Tier := 1, Prompt := "Simplify: 7c − 6c + 5d", Choices := array{"c + 5d", "c", "6c", "13c + 5d"}, Answer := 0, Feedback := array{"", "Don\'t leave a term out. Every term is either combined or kept.", "Only like terms combine. A letter term and a plain number can\'t merge.", "A minus sign means take that term away. Don\'t turn it into a plus."}, Explanation := "Combine only the c terms: 7c − 6c = c. The d term stays: c + 5d."},
        fnm_item{Id := "linear-expressions/t1/035", Tier := 1, Prompt := "Simplify: 8t − t", Choices := array{"9t", "7", "−7t", "7t"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Keep the letter. Only the coefficients combine; the letter stays on.", "Right size, wrong sign. Check which number is bigger and what its sign is.", ""}, Explanation := "Add the coefficients (t alone is 1t): 8 − 1 = 7. So 8t − t = 7t."},
        fnm_item{Id := "linear-expressions/t1/036", Tier := 1, Prompt := "Simplify: 4w − 11w", Choices := array{"15w", "−15w", "−7", "−7w"}, Answer := 3, Feedback := array{"A minus sign means take that term away. Don\'t turn it into a plus.", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Keep the letter. Only the coefficients combine; the letter stays on.", ""}, Explanation := "Add the coefficients: 4 − 11 = −7. So 4w − 11w = −7w."},
        fnm_item{Id := "linear-expressions/t1/037", Tier := 1, Prompt := "Simplify: −8 − 5x + 2x", Choices := array{"−11x", "−11", "−3x − 8", "3x − 8"}, Answer := 2, Feedback := array{"Only like terms combine. A letter term and a plain number can\'t merge.", "Keep the letter. Only the coefficients combine; the letter stays on.", "", "Right size, wrong sign. Check which number is bigger and what its sign is."}, Explanation := "Like terms: −5x + 2x = −3x. −8 has no x, so it stays: −3x − 8."},
        fnm_item{Id := "linear-expressions/t1/038", Tier := 1, Prompt := "Simplify: −11t + 5t", Choices := array{"−16t", "−6", "6t", "−6t"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Keep the letter. Only the coefficients combine; the letter stays on.", "Right size, wrong sign. Check which number is bigger and what its sign is.", ""}, Explanation := "Add the coefficients: −11 + 5 = −6. So −11t + 5t = −6t."},
        fnm_item{Id := "linear-expressions/t1/039", Tier := 1, Prompt := "Simplify: −8x − x", Choices := array{"−7x", "9x", "−9", "−9x"}, Answer := 3, Feedback := array{"A minus sign means take that term away. Don\'t turn it into a plus.", "Right size, wrong sign. Check which number is bigger and what its sign is.", "Keep the letter. Only the coefficients combine; the letter stays on.", ""}, Explanation := "Add the coefficients (x alone is 1x): −8 − 1 = −9. So −8x − x = −9x."},
        fnm_item{Id := "linear-expressions/t1/040", Tier := 1, Prompt := "Simplify: 6k − 1 − 7k + 2", Choices := array{"−k + 3", "−k + 1", "13k + 1", "k + 1"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "", "A minus sign means take that term away. Don\'t turn it into a plus.", "Right size, wrong sign. Check which number is bigger and what its sign is."}, Explanation := "k terms: 6k − 7k = −k. Numbers: −1 + 2 = 1. So −k + 1."},
        fnm_item{Id := "linear-expressions/t2/001", Tier := 2, Prompt := "Distribute: −3(4n + 2)", Choices := array{"−18n", "−12n + 2", "−12n − 6", "12n + 6"}, Answer := 2, Feedback := array{"Only like terms combine. A letter term and a plain number can\'t merge.", "Multiply EVERY term inside ( ) by the outside number, not just the first.", "", "Keep the outside minus. −3(x − 4) means −3 times each term."}, Explanation := "Multiply each term by −3: −3 × 4n = −12n and −3 × 2 = −6. So −12n − 6."},
        fnm_item{Id := "linear-expressions/t2/002", Tier := 2, Prompt := "Distribute: 3(−n − 4)", Choices := array{"−3n + 12", "−3n − 12", "−15n", "−3n − 4"}, Answer := 1, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "", "Only like terms combine. A letter term and a plain number can\'t merge.", "Multiply EVERY term inside ( ) by the outside number, not just the first."}, Explanation := "Multiply each term by 3: 3 × (−n) = −3n and 3 × (−4) = −12. So −3n − 12."},
        fnm_item{Id := "linear-expressions/t2/003", Tier := 2, Prompt := "Distribute: −6(2t − 1)", Choices := array{"−12t + 6", "−12t − 6", "12t − 6", "−12t − 1"}, Answer := 0, Feedback := array{"", "Watch each sign: −3 × 4 = −12, but −3 × (−4) = +12.", "Keep the outside minus. −3(x − 4) means −3 times each term.", "Multiply EVERY term inside ( ) by the outside number, not just the first."}, Explanation := "Multiply each term by −6: −6 × 2t = −12t and −6 × (−1) = 6. So −12t + 6."},
        fnm_item{Id := "linear-expressions/t2/004", Tier := 2, Prompt := "Distribute: 2(−4k + 6)", Choices := array{"8k + 12", "−8k + 12", "4k", "−8k + 6"}, Answer := 1, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "", "Only like terms combine. A letter term and a plain number can\'t merge.", "Multiply EVERY term inside ( ) by the outside number, not just the first."}, Explanation := "Multiply each term by 2: 2 × (−4k) = −8k and 2 × 6 = 12. So −8k + 12."},
        fnm_item{Id := "linear-expressions/t2/005", Tier := 2, Prompt := "Distribute: −(8a + 3)", Choices := array{"−8a + 3", "−8a − 3", "8a + 3", "−11a"}, Answer := 1, Feedback := array{"A minus in front of ( ) changes EVERY sign inside: −(2x + 5) = −2x − 5.", "", "Keep the outside minus. −3(x − 4) means −3 times each term.", "Only like terms combine. A letter term and a plain number can\'t merge."}, Explanation := "Multiply each term by −1: −1 × 8a = −8a and −1 × 3 = −3. So −8a − 3."},
        fnm_item{Id := "linear-expressions/t2/006", Tier := 2, Prompt := "Distribute: −2(5 + 6x)", Choices := array{"−10 + 12x", "−10 − 12x", "10 + 12x", "−10 + 6x"}, Answer := 1, Feedback := array{"Watch each sign: −3 × 4 = −12, but −3 × (−4) = +12.", "", "Keep the outside minus. −3(x − 4) means −3 times each term.", "Multiply EVERY term inside ( ) by the outside number, not just the first."}, Explanation := "Multiply each term by −2: −2 × 5 = −10 and −2 × 6x = −12x. So −10 − 12x."},
        fnm_item{Id := "linear-expressions/t2/007", Tier := 2, Prompt := "Distribute: −(10y − 1)", Choices := array{"−10y + 1", "−10y − 1", "−9y", "10y − 1"}, Answer := 0, Feedback := array{"", "A minus in front of ( ) changes EVERY sign inside: −(2x + 5) = −2x − 5.", "Only like terms combine. A letter term and a plain number can\'t merge.", "Keep the outside minus. −3(x − 4) means −3 times each term."}, Explanation := "Multiply each term by −1: −1 × 10y = −10y and −1 × (−1) = 1. So −10y + 1."},
        fnm_item{Id := "linear-expressions/t2/008", Tier := 2, Prompt := "Distribute: −3(4t − 2)", Choices := array{"−12t + 6", "−12t − 6", "−12t − 2", "12t − 6"}, Answer := 0, Feedback := array{"", "Watch each sign: −3 × 4 = −12, but −3 × (−4) = +12.", "Multiply EVERY term inside ( ) by the outside number, not just the first.", "Keep the outside minus. −3(x − 4) means −3 times each term."}, Explanation := "Multiply each term by −3: −3 × 4t = −12t and −3 × (−2) = 6. So −12t + 6."},
        fnm_item{Id := "linear-expressions/t2/009", Tier := 2, Prompt := "Distribute: −2(2 + 6k)", Choices := array{"−4 + 12k", "−4 − 12k", "−16k", "−4 + 6k"}, Answer := 1, Feedback := array{"Watch each sign: −3 × 4 = −12, but −3 × (−4) = +12.", "", "Only like terms combine. A letter term and a plain number can\'t merge.", "Multiply EVERY term inside ( ) by the outside number, not just the first."}, Explanation := "Multiply each term by −2: −2 × 2 = −4 and −2 × 6k = −12k. So −4 − 12k."},
