        fnm_item{Id := "order-of-ops-exponents/t5/028", Tier := 5, Prompt := "(9 ÷ 3 − 2 + (5 − 4))³", Choices := array{"8", "10", "0", "6"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "+ and − are a team: go left to right between them.", "3² means 3 × 3, not 3 × 2."}, Explanation := "5 − 4 = 1, then 9 ÷ 3 = 3, then 3 − 2 = 1, then 1 + 1 = 2, then 2³ = 8."},
        fnm_item{Id := "order-of-ops-exponents/t5/029", Tier := 5, Prompt := "(12 ÷ (42 ÷ 7 − 2))³", Choices := array{"37", "27", "28", "9"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Check your arithmetic.", "3² means 3 × 3, not 3 × 2."}, Explanation := "42 ÷ 7 = 6, then 6 − 2 = 4, then 12 ÷ 4 = 3, then 3³ = 27."},
        fnm_item{Id := "order-of-ops-exponents/t5/030", Tier := 5, Prompt := "(4 + 10 ÷ 2)² − 10 × 2", Choices := array{"61", "8", "78", "9"}, Answer := 0, Feedback := array{"", "3² means 3 × 3, not 3 × 2.", "Added or subtracted too early. × and ÷ come first.", "Exponent goes on its base only, before multiplying."}, Explanation := "10 ÷ 2 = 5, then 4 + 5 = 9, then 9² = 81, then 10 × 2 = 20, then 81 − 20 = 61."},
        fnm_item{Id := "order-of-ops-exponents/t5/031", Tier := 5, Prompt := "(6 − (7 − (13 − 21 ÷ 3)))²", Choices := array{"28", "20", "25", "10"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Check your arithmetic.", "", "3² means 3 × 3, not 3 × 2."}, Explanation := "21 ÷ 3 = 7, then 13 − 7 = 6, then 7 − 6 = 1, then 6 − 1 = 5, then 5² = 25."},
        fnm_item{Id := "order-of-ops-exponents/t5/032", Tier := 5, Prompt := "(5 + ((5 + 10) ÷ 3)²) ÷ 10", Choices := array{"3", "2", "10", "0"}, Answer := 0, Feedback := array{"", "3² means 3 × 3, not 3 × 2.", "Worked left to right. Do × and ÷ before + and −.", "Check your arithmetic."}, Explanation := "5 + 10 = 15, then 15 ÷ 3 = 5, then 5² = 25, then 5 + 25 = 30, then 30 ÷ 10 = 3."},
        fnm_item{Id := "order-of-ops-exponents/t5/033", Tier := 5, Prompt := "2³ ÷ 2 × (9 ÷ 3)", Choices := array{"1", "8", "12", "9"}, Answer := 2, Feedback := array{"3² means 3 × 3, not 3 × 2.", "Check your arithmetic.", "", "3² means 3 × 3, not 3 × 2."}, Explanation := "9 ÷ 3 = 3, then 2³ = 8, then 8 ÷ 2 = 4, then 4 × 3 = 12."},
        fnm_item{Id := "order-of-ops-exponents/t5/034", Tier := 5, Prompt := "8 ÷ 2 × ((6 − 4)³ ÷ 4)", Choices := array{"21", "6", "2", "8"}, Answer := 3, Feedback := array{"3² means 3 × 3, not 3 × 2.", "3² means 3 × 3, not 3 × 2.", "× and ÷ are a team: go left to right between them.", ""}, Explanation := "6 − 4 = 2, then 2³ = 8, then 8 ÷ 4 = 2, then 8 ÷ 2 = 4, then 4 × 2 = 8."},
        fnm_item{Id := "order-of-ops-exponents/t5/035", Tier := 5, Prompt := "24 ÷ (24 ÷ (6² ÷ 9) − 3)", Choices := array{"9", "3", "8", "1"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Check your arithmetic.", "", "Added or subtracted too early. × and ÷ come first."}, Explanation := "6² = 36, then 36 ÷ 9 = 4, then 24 ÷ 4 = 6, then 6 − 3 = 3, then 24 ÷ 3 = 8."},
        fnm_item{Id := "order-of-ops-exponents/t5/036", Tier := 5, Prompt := "(5 − 2 + 6 ÷ 3)²", Choices := array{"10", "9", "25", "1"}, Answer := 2, Feedback := array{"3² means 3 × 3, not 3 × 2.", "Added or subtracted too early. × and ÷ come first.", "", "+ and − are a team: go left to right between them."}, Explanation := "6 ÷ 3 = 2, then 5 − 2 = 3, then 3 + 2 = 5, then 5² = 25."},
        fnm_item{Id := "order-of-ops-exponents/t5/037", Tier := 5, Prompt := "(3³ − 54 ÷ 3²) ÷ 3", Choices := array{"27", "7", "0", "25"}, Answer := 1, Feedback := array{"Worked left to right. Do × and ÷ before + and −.", "", "3² means 3 × 3, not 3 × 2.", "Skipped the parentheses. Do what\'s inside them first."}, Explanation := "3³ = 27, then 3² = 9, then 54 ÷ 9 = 6, then 27 − 6 = 21, then 21 ÷ 3 = 7."},
        fnm_item{Id := "order-of-ops-exponents/t5/038", Tier := 5, Prompt := "16 ÷ (2³ − (4 + 2))", Choices := array{"8", "510", "11", "0"}, Answer := 0, Feedback := array{"", "Exponent goes on its base only, before multiplying.", "Check your arithmetic.", "Skipped the parentheses. Do what\'s inside them first."}, Explanation := "4 + 2 = 6, then 2³ = 8, then 8 − 6 = 2, then 16 ÷ 2 = 8."},
        fnm_item{Id := "order-of-ops-exponents/t5/039", Tier := 5, Prompt := "(10 ÷ 5 × 2² − 2)²", Choices := array{"4", "196", "36", "16"}, Answer := 2, Feedback := array{"Skipped the parentheses. Do what\'s inside them first.", "Exponent goes on its base only, before multiplying.", "", "Added or subtracted too early. × and ÷ come first."}, Explanation := "2² = 4, then 10 ÷ 5 = 2, then 2 × 4 = 8, then 8 − 2 = 6, then 6² = 36."},
