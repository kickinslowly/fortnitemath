        fnm_item{Id := "expressions/t2/036", Tier := 2, Prompt := "Coefficient of y in 9x + y + 3?", Choices := array{"1", "3", "0", "9"}, Answer := 0, Feedback := array{"", "Coefficient: the number times a letter. Constant: a number all alone.", "A letter alone has coefficient 1: y means 1y.", "That number goes with a different letter. Find the one in front of it."}, Explanation := "y alone means 1 × y, so the coefficient of y is 1."},
