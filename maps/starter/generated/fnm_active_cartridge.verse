        fnm_item{Id := "equations-inequalities/t5/018", Tier := 5, Prompt := "Fewer than 12 seats, s, are left. Which fits?", Choices := array{"s \< 12", "s ≤ 12", "s ≥ 12", "s \> 12"}, Answer := 0, Feedback := array{"", "At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "Less than 12: s \< 12. 12 itself does not count, so no line under the sign."},
        fnm_item{Id := "equations-inequalities/t5/019", Tier := 5, Prompt := "The trip took over 18 days, d. Which fits?", Choices := array{"d \> 18", "d \< 18", "d ≤ 18", "d ≥ 18"}, Answer := 0, Feedback := array{"", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "At least / at most include the number (≥ ≤). More / fewer than do not."}, Explanation := "More than 18: d \> 18. 18 itself does not count, so no line under the sign."},
