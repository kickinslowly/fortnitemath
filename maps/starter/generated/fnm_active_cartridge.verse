        fnm_item{Id := "circles/t3/014", Tier := 3, Prompt := "A sprinkler waters a circle, radius 8. Area?", Choices := array{"16π", "64π", "64", "256π"}, Answer := 1, Feedback := array{"That\'s the circumference. Area is π × radius × radius.", "", "Don\'t drop π: it is part of every circle formula (use 3 if told).", "Square the radius as given: π × r × r. Don\'t double it first."}, Explanation := "Area = π × radius × radius: 8 × 8 = 64, so 64π."},
        fnm_item{Id := "circles/t3/015", Tier := 3, Prompt := "Circle: radius 4. Area?", Choices := array{"16", "16π", "8π", "64π"}, Answer := 1, Feedback := array{"Don\'t drop π: it is part of every circle formula (use 3 if told).", "", "That\'s the circumference. Area is π × radius × radius.", "Square the radius as given: π × r × r. Don\'t double it first."}, Explanation := "Area = π × radius × radius: 4 × 4 = 16, so 16π."},
        fnm_item{Id := "circles/t3/016", Tier := 3, Prompt := "A rug has radius 8. Its area?", Choices := array{"64π", "16π", "256π", "8π"}, Answer := 0, Feedback := array{"", "That\'s the circumference. Area is π × radius × radius.", "Square the radius as given: π × r × r. Don\'t double it first.", "Area needs r × r: square the radius, don\'t just use it."}, Explanation := "Area = π × radius × radius: 8 × 8 = 64, so 64π."},
        fnm_item{Id := "circles/t3/017", Tier := 3, Prompt := "Area formula, using radius r?", Choices := array{"πr²", "2πr", "πr", "πd²"}, Answer := 0, Feedback := array{"", "That\'s the circumference. Area is π × radius × radius.", "Area needs r × r: square the radius, don\'t just use it.", "In π × r × r, r is the RADIUS. Use half the diameter."}, Explanation := "Area = π × r × r = πr²."},
