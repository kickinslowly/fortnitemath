        fnm_item{Id := "order-of-ops-exponents/t5/010", Tier := 5, Prompt := "10² − 20 ÷ (8 − 42 ÷ 7)", Choices := array{"10", "90", "92", "0"}, Answer := 1, Feedback := array{"3² means 3 × 3, not 3 × 2.", "", "Check your arithmetic.", "3² means 3 × 3, not 3 × 2."}, Explanation := "42 ÷ 7 = 6, then 8 − 6 = 2, then 10² = 100, then 20 ÷ 2 = 10, then 100 − 10 = 90."},
        fnm_item{Id := "order-of-ops-exponents/t5/011", Tier := 5, Prompt := "30 ÷ (10² ÷ 10) + (3 − 2)", Choices := array{"1", "10", "16", "4"}, Answer := 3, Feedback := array{"Check your arithmetic.", "3² means 3 × 3, not 3 × 2.", "3² means 3 × 3, not 3 × 2.", ""}, Explanation := "10² = 100, then 100 ÷ 10 = 10, then 3 − 2 = 1, then 30 ÷ 10 = 3, then 3 + 1 = 4."},
        fnm_item{Id := "order-of-ops-exponents/t5/012", Tier := 5, Prompt := "80 ÷ (10² ÷ 10) ÷ 4", Choices := array{"6", "10", "12", "2"}, Answer := 3, Feedback := array{"Check your arithmetic.", "3² means 3 × 3, not 3 × 2.", "Check your arithmetic.", ""}, Explanation := "10² = 100, then 100 ÷ 10 = 10, then 80 ÷ 10 = 8, then 8 ÷ 4 = 2."},
        fnm_item{Id := "order-of-ops-exponents/t5/013", Tier := 5, Prompt := "7 + (40 ÷ (4 + 6) + 9²)", Choices := array{"29", "92", "176", "104"}, Answer := 1, Feedback := array{"3² means 3 × 3, not 3 × 2.", "", "Worked left to right. Do × and ÷ before + and −.", "Skipped the parentheses. Do what\'s inside them first."}, Explanation := "4 + 6 = 10, then 9² = 81, then 40 ÷ 10 = 4, then 4 + 81 = 85, then 7 + 85 = 92."},
        fnm_item{Id := "order-of-ops-exponents/t5/014", Tier := 5, Prompt := "(7 + (8 ÷ 2 − 3))²", Choices := array{"2", "64", "1", "16"}, Answer := 1, Feedback := array{"Skipped the parentheses. Do what\'s inside them first.", "", "Added or subtracted too early. × and ÷ come first.", "3² means 3 × 3, not 3 × 2."}, Explanation := "8 ÷ 2 = 4, then 4 − 3 = 1, then 7 + 1 = 8, then 8² = 64."},
        fnm_item{Id := "order-of-ops-exponents/t5/015", Tier := 5, Prompt := "(15 − 8² ÷ 8) × 9", Choices := array{"64", "117", "63", "73"}, Answer := 2, Feedback := array{"Check your arithmetic.", "3² means 3 × 3, not 3 × 2.", "", "Check your arithmetic."}, Explanation := "8² = 64, then 64 ÷ 8 = 8, then 15 − 8 = 7, then 7 × 9 = 63."},
        fnm_item{Id := "order-of-ops-exponents/t5/016", Tier := 5, Prompt := "10 + (2 + 2 + (8 ÷ 2)²)", Choices := array{"22", "30", "74", "16"}, Answer := 1, Feedback := array{"3² means 3 × 3, not 3 × 2.", "", "Worked left to right. Do × and ÷ before + and −.", "Skipped the parentheses. Do what\'s inside them first."}, Explanation := "8 ÷ 2 = 4, then 4² = 16, then 2 + 2 = 4, then 4 + 16 = 20, then 10 + 20 = 30."},
        fnm_item{Id := "order-of-ops-exponents/t5/017", Tier := 5, Prompt := "6 ÷ 3 + (6² + 4 ÷ 2)", Choices := array{"40", "22", "34", "16"}, Answer := 0, Feedback := array{"", "Worked left to right. Do × and ÷ before + and −.", "Skipped the parentheses. Do what\'s inside them first.", "3² means 3 × 3, not 3 × 2."}, Explanation := "6² = 36, then 4 ÷ 2 = 2, then 36 + 2 = 38, then 6 ÷ 3 = 2, then 2 + 38 = 40."},
        fnm_item{Id := "order-of-ops-exponents/t5/018", Tier := 5, Prompt := "10 + (8 ÷ 2 + 3³ ÷ 9)", Choices := array{"15", "18", "17", "192"}, Answer := 2, Feedback := array{"3² means 3 × 3, not 3 × 2.", "Check your arithmetic.", "", "Skipped the parentheses. Do what\'s inside them first."}, Explanation := "3³ = 27, then 8 ÷ 2 = 4, then 27 ÷ 9 = 3, then 4 + 3 = 7, then 10 + 7 = 17."},
        fnm_item{Id := "order-of-ops-exponents/t5/019", Tier := 5, Prompt := "6² ÷ (9 × (2 + 4) ÷ 9)", Choices := array{"2", "10", "5", "6"}, Answer := 3, Feedback := array{"3² means 3 × 3, not 3 × 2.", "Check your arithmetic.", "Check your arithmetic.", ""}, Explanation := "2 + 4 = 6, then 9 × 6 = 54, then 54 ÷ 9 = 6, then 6² = 36, then 36 ÷ 6 = 6."},
        fnm_item{Id := "order-of-ops-exponents/t5/020", Tier := 5, Prompt := "10 + (3² − 24 ÷ 8)", Choices := array{"6", "13", "16", "18"}, Answer := 2, Feedback := array{"Check your arithmetic.", "3² means 3 × 3, not 3 × 2.", "", "Check your arithmetic."}, Explanation := "3² = 9, then 24 ÷ 8 = 3, then 9 − 3 = 6, then 10 + 6 = 16."},
        fnm_item{Id := "order-of-ops-exponents/t5/021", Tier := 5, Prompt := "4³ + 3 + (8 − 2) ÷ 3", Choices := array{"69", "17", "59", "7"}, Answer := 0, Feedback := array{"", "3² means 3 × 3, not 3 × 2.", "Check your arithmetic.", "3² means 3 × 3, not 3 × 2."}, Explanation := "8 − 2 = 6, then 4³ = 64, then 6 ÷ 3 = 2, then 64 + 3 = 67, then 67 + 2 = 69."},
        fnm_item{Id := "order-of-ops-exponents/t5/022", Tier := 5, Prompt := "(5² + 3 − 8) ÷ 4", Choices := array{"5", "6", "11", "26"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "3² means 3 × 3, not 3 × 2.", "Skipped the parentheses. Do what\'s inside them first."}, Explanation := "5² = 25, then 25 + 3 = 28, then 28 − 8 = 20, then 20 ÷ 4 = 5."},
        fnm_item{Id := "order-of-ops-exponents/t5/023", Tier := 5, Prompt := "6² ÷ (9 ÷ 3 × 2) − 3", Choices := array{"12", "3", "21", "5"}, Answer := 1, Feedback := array{"Added or subtracted too early. × and ÷ come first.", "", "× and ÷ are a team: go left to right between them.", "3² means 3 × 3, not 3 × 2."}, Explanation := "9 ÷ 3 = 3, then 3 × 2 = 6, then 6² = 36, then 36 ÷ 6 = 6, then 6 − 3 = 3."},
        fnm_item{Id := "order-of-ops-exponents/t5/024", Tier := 5, Prompt := "7² + (9 ÷ 3)³", Choices := array{"23", "51", "76", "15"}, Answer := 2, Feedback := array{"3² means 3 × 3, not 3 × 2.", "3² means 3 × 3, not 3 × 2.", "", "3² means 3 × 3, not 3 × 2."}, Explanation := "9 ÷ 3 = 3, then 7² = 49, then 3³ = 27, then 49 + 27 = 76."},
        fnm_item{Id := "order-of-ops-exponents/t5/025", Tier := 5, Prompt := "((14 ÷ 2)² ÷ 7)²", Choices := array{"46", "47", "49", "4"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Check your arithmetic.", "", "3² means 3 × 3, not 3 × 2."}, Explanation := "14 ÷ 2 = 7, then 7² = 49, then 49 ÷ 7 = 7, then 7² = 49."},
        fnm_item{Id := "order-of-ops-exponents/t5/026", Tier := 5, Prompt := "6² ÷ (18 ÷ (2 + 9 − 8))", Choices := array{"6", "1", "2", "10"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "3² means 3 × 3, not 3 × 2.", "Check your arithmetic."}, Explanation := "2 + 9 = 11, then 11 − 8 = 3, then 18 ÷ 3 = 6, then 6² = 36, then 36 ÷ 6 = 6."},
