        fnm_item{Id := "equations-inequalities/t5/013", Tier := 5, Prompt := "A ride takes 3 or more tickets, t. Which fits?", Choices := array{"t \> 3", "t \< 3", "t ≤ 3", "t ≥ 3"}, Answer := 3, Feedback := array{"At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", ""}, Explanation := "3 or more: t ≥ 3. 3 itself counts, so the line goes under the sign."},
        fnm_item{Id := "equations-inequalities/t5/014", Tier := 5, Prompt := "Which makes 4k \> 20 true?", Choices := array{"5", "6", "2", "3"}, Answer := 1, Feedback := array{"\< and \> leave out the number itself: 4 \< 4 is false.", "", "Plug it in: the statement comes out false. Pick from the other side.", "Plug it in: the statement comes out false. Pick from the other side."}, Explanation := "Try 6: 4 × 6 = 24, and 24 \> 20 is true. 4 × 5 = 20, and 20 \> 20 is false."},
        fnm_item{Id := "equations-inequalities/t5/015", Tier := 5, Prompt := "Which makes 9 \> y true?", Choices := array{"10", "9", "13", "7"}, Answer := 3, Feedback := array{"Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "\< and \> leave out the number itself: 4 \< 4 is false.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", ""}, Explanation := "9 \> y means y \< 9. Try 7: 9 \> 7 is true. 9 \< 9 is false: 9 is not a solution."},
        fnm_item{Id := "equations-inequalities/t5/016", Tier := 5, Prompt := "Which is a solution of y ≤ 14?", Choices := array{"17", "15", "16", "14"}, Answer := 3, Feedback := array{"Plug it in: the statement comes out false. Pick from the other side.", "Plug it in: the statement comes out false. Pick from the other side.", "Plug it in: the statement comes out false. Pick from the other side.", ""}, Explanation := "Try 14: 14 ≤ 14 is true."},
        fnm_item{Id := "equations-inequalities/t5/017", Tier := 5, Prompt := "Which makes 4 \< n true?", Choices := array{"4", "7", "3", "1"}, Answer := 1, Feedback := array{"\< and \> leave out the number itself: 4 \< 4 is false.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "4 \< n means n \> 4. Try 7: 4 \< 7 is true. 4 \> 4 is false: 4 is not a solution."},
        fnm_item{Id := "equations-inequalities/t5/018", Tier := 5, Prompt := "Fewer than 12 seats, s, are left. Which fits?", Choices := array{"s \< 12", "s ≤ 12", "s ≥ 12", "s \> 12"}, Answer := 0, Feedback := array{"", "At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "Less than 12: s \< 12. 12 itself does not count, so no line under the sign."},
        fnm_item{Id := "equations-inequalities/t5/019", Tier := 5, Prompt := "The trip took over 18 days, d. Which fits?", Choices := array{"d \> 18", "d \< 18", "d ≤ 18", "d ≥ 18"}, Answer := 0, Feedback := array{"", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "At least / at most include the number (≥ ≤). More / fewer than do not."}, Explanation := "More than 18: d \> 18. 18 itself does not count, so no line under the sign."},
        fnm_item{Id := "equations-inequalities/t5/020", Tier := 5, Prompt := "Which makes y + 5 \< 15 true?", Choices := array{"10", "12", "9", "13"}, Answer := 2, Feedback := array{"\< and \> leave out the number itself: 4 \< 4 is false.", "Plug it in: the statement comes out false. Pick from the other side.", "", "Plug it in: the statement comes out false. Pick from the other side."}, Explanation := "Try 9: 9 + 5 = 14, and 14 \< 15 is true. 10 + 5 = 15, and 15 \< 15 is false."},
        fnm_item{Id := "equations-inequalities/t5/021", Tier := 5, Prompt := "At most 14 guests, g, can come. Which fits?", Choices := array{"g \< 14", "g ≥ 14", "g ≤ 14", "g \> 14"}, Answer := 2, Feedback := array{"At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "14 or less: g ≤ 14. 14 itself counts, so the line goes under the sign."},
