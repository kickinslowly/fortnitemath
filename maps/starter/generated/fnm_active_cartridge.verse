        fnm_item{Id := "fraction-division/t5/018", Tier := 5, Prompt := "2 cups of rice, 1/8 cup per bowl. How many bowls?", Choices := array{"18", "1/16", "16", "1/4"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Backwards: start with the amount you have, then divide it.", "", "Count the pieces: each whole holds as many as the denominator. Multiply."}, Explanation := "Groups of 1/8 in 2: 2 ÷ 1/8 = 2 × 8 = 16."},
