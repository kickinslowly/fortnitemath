        fnm_item{Id := "rational-ops/t2/034", Tier := 2, Prompt := "−2/5 + (−7/10)", Choices := array{"−1 1/10", "−9/10", "−3/5", "1 1/10"}, Answer := 0, Feedback := array{"", "Rename BOTH with the same bottom first: 1/2 is 2/4, not 1/4.", "Never add the bottoms. Make them the same, then add only the tops.", "Two negatives make a positive only when you multiply or divide."}, Explanation := "Common bottom 10: −4/10 + (−7/10) = −11/10 = −1 1/10."},
        fnm_item{Id := "rational-ops/t2/035", Tier := 2, Prompt := "1/2 − 9/10", Choices := array{"1 2/5", "−2/5", "−2/3", "−1 2/5"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes. The bigger size decides the sign.", "", "Never add the bottoms. Make them the same, then add only the tops.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Subtracting 9/10 is adding −9/10. Common bottom 10: 5/10 + (−9/10) = −4/10 = −2/5."},
        fnm_item{Id := "rational-ops/t2/036", Tier := 2, Prompt := "1/7 − (−6/7)", Choices := array{"1", "1/2", "−1", "−5/7"}, Answer := 0, Feedback := array{"", "Never add the bottoms. Make them the same, then add only the tops.", "Right size, wrong sign. Which number is farther from 0?", "Subtracting a negative is adding: 4 − (−6) = 4 + 6."}, Explanation := "Subtracting −6/7 is adding 6/7. Common bottom 7: 1/7 + 6/7 = 7/7 = 1."},
        fnm_item{Id := "rational-ops/t2/037", Tier := 2, Prompt := "3/10 − 2/5", Choices := array{"−7/10", "−1/10", "1/15", "1/10"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "", "Never add the bottoms. Make them the same, then add only the tops.", "Rename BOTH with the same bottom first: 1/2 is 2/4, not 1/4."}, Explanation := "Subtracting 2/5 is adding −2/5. Common bottom 10: 3/10 + (−4/10) = −1/10."},
