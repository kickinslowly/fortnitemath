        fnm_item{Id := "expressions/t5/001", Tier := 5, Prompt := "Simplify: 3(w + 1) + 2(w + 1)", Choices := array{"5w + 7", "10w", "5w + 5", "5w + 2"}, Answer := 2, Feedback := array{"The outside number multiplies each term: 3(x + 4) = 3x + 12.", "Only like terms combine. 3x + 12 can\'t become 15x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "3w + 3 and 2w + 2. w terms: 5w. Numbers: 3 + 2 = 5. So 5w + 5."},
        fnm_item{Id := "expressions/t5/002", Tier := 5, Prompt := "Simplify: 3x + 4x", Choices := array{"8x", "7x", "12x", "7x²"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Add like terms: 5a + 3a is 8a. Multiply only when you see ×.", "Adding like terms adds the numbers: x + x + x = 3x, not x³."}, Explanation := "Like terms: add the coefficients. 3 + 4 = 7, so 7x."},
