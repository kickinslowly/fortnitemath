        fnm_item{Id := "circles/t4/001", Tier := 4, Prompt := "Circle: circumference 12. Diameter? Use 3 for π.", Choices := array{"36", "4", "2", "12"}, Answer := 1, Feedback := array{"Going backward means undoing: divide here, don\'t multiply.", "", "The number beside π is the diameter itself, not half of it.", "Don\'t forget π (3 here): C = 6 × radius, or 3 × diameter."}, Explanation := "C = 3 × diameter, so diameter = 12 ÷ 3 = 4."},
