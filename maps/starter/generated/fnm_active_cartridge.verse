        fnm_item{Id := "two-step-equations/t4/001", Tier := 4, Prompt := "Each of 2 kids gets n cards and 3 pins: 18 items. Equation?", Choices := array{"3(n + 2) = 18", "2(n + 3) = 18", "2(n − 3) = 18", "2n = 18"}, Answer := 1, Feedback := array{"Numbers in the wrong spots. Match each number to its job in the story.", "", "Right numbers, wrong sign. Does the story add to the total or take away?", "Don\'t forget the one-time amount. Take it off first, then divide."}, Explanation := "2 people, each with (n + 3): 2(n + 3) = 18. (Then n = 6.)"},
        fnm_item{Id := "two-step-equations/t4/002", Tier := 4, Prompt := "Gym: $6 to join, $3 a visit. Paid $15. Visits?", Choices := array{"9", "7", "5", "3"}, Answer := 3, Feedback := array{"You stopped early. After undoing + or −, divide to get x alone.", "The one-time amount is already inside the total. Undo it with the opposite.", "Don\'t forget the one-time amount. Take it off first, then divide.", ""}, Explanation := "3v + 6 = 15. Subtract 6: 3v = 9. Divide by 3: v = 3."},
        fnm_item{Id := "two-step-equations/t4/003", Tier := 4, Prompt := "3 packs of k cards, lost 10. 2 cards left. Equation?", Choices := array{"10k − 3 = 2", "3k + 10 = 2", "3k − 10 = 2", "3k = 2"}, Answer := 2, Feedback := array{"Numbers in the wrong spots. Match each number to its job in the story.", "Right numbers, wrong sign. Does the story add to the total or take away?", "", "Don\'t forget the one-time amount. Take it off first, then divide."}, Explanation := "3 groups of k, minus 10: 3k − 10 = 2. (Then k = 4.)"},
