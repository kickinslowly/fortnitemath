        fnm_item{Id := "rational-numbers/t1/003", Tier := 1, Prompt := "Deposit $8, then withdraw $5. As integers?", Choices := array{"8 and −5", "−8 and −5", "8 and 5", "−8 and 5"}, Answer := 0, Feedback := array{"", "Below, owe, lose, down, withdraw are negative. Above, earn, gain, up are +.", "Below, owe, lose, down, withdraw are negative. Above, earn, gain, up are +.", "Below, owe, lose, down, withdraw are negative. Above, earn, gain, up are +."}, Explanation := "Deposit means positive: 8. Withdraw means negative: −5. So 8 and −5."},
        fnm_item{Id := "rational-numbers/t1/004", Tier := 1, Prompt := "Start at 7 and move 2 right. Where are you?", Choices := array{"9", "5", "2", "8"}, Answer := 0, Feedback := array{"", "Right means bigger numbers. Left means smaller numbers.", "Start at the starting number, not at 0, then count the move.", "Count the jumps between tick marks, not the tick marks themselves."}, Explanation := "Right means bigger: 7 + 2 = 9."},
        fnm_item{Id := "rational-numbers/t1/005", Tier := 1, Prompt := "Start at 9 and move 7 right. Where are you?", Choices := array{"15", "2", "16", "7"}, Answer := 2, Feedback := array{"Count the jumps between tick marks, not the tick marks themselves.", "Right means bigger numbers. Left means smaller numbers.", "", "Start at the starting number, not at 0, then count the move."}, Explanation := "Right means bigger: 9 + 7 = 16."},
        fnm_item{Id := "rational-numbers/t1/006", Tier := 1, Prompt := "What is the opposite of −5?", Choices := array{"1/5", "−5", "5", "−1/5"}, Answer := 2, Feedback := array{"Opposite means switch the sign. Flipping into a fraction is the reciprocal.", "The opposite is the same distance from 0 on the other side: 7 and −7.", "", "Opposite means switch the sign. Flipping into a fraction is the reciprocal."}, Explanation := "The opposite is the same distance from 0 on the other side of 0: 5."},
