FnmCartridge_expressions():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "expressions",
    Version := "1.0.0",
    Title := "Expressions",
    Subtitle := "Write, Read, Evaluate",
    Grade := "6",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Words to Expressions", Description := "Turn words into an expression: 5 less than n is n − 5."},
        fnm_tier{Tier := 2, Name := "Parts of an Expression", Description := "Terms, coefficients, constants, and naming an expression by its last step."},
        fnm_tier{Tier := 3, Name := "Evaluate", Description := "Put the number in for the letter, then follow the order of operations."},
        fnm_tier{Tier := 4, Name := "Distributive Property", Description := "Expand a(b + c) and factor out the greatest common factor."},
        fnm_tier{Tier := 5, Name := "Equivalent Expressions", Description := "Combine like terms and spot expressions that are always equal."}
    },
    Items := array{
        fnm_item{Id := "expressions/t1/001", Tier := 1, Prompt := "3 less than the product of 4 and p", Choices := array{"3p − 4", "3 − 4p", "4(p − 3)", "4p − 3"}, Answer := 3, Feedback := array{"Check which number multiplies and which number is added or taken away.", "Order matters for −. \'5 less than n\' starts at n: n − 5.", "\'3 more than 2n\' adds 3 after multiplying: 2n + 3, no ( ).", ""}, Explanation := "The product of 4 and p is 4p. Take 3 away from it: 4p − 3."},
        fnm_item{Id := "expressions/t1/002", Tier := 1, Prompt := "12 less than y", Choices := array{"12 − y", "y − 12", "12y", "y + 12"}, Answer := 1, Feedback := array{"Order matters for −. \'5 less than n\' starts at n: n − 5.", "", "Match the words: sum +, difference −, product ×, quotient ÷.", "Match the words: sum +, difference −, product ×, quotient ÷."}, Explanation := "Start at y and take 12 away: y − 12. \'Less than\' flips the order of the words."},
        fnm_item{Id := "expressions/t1/003", Tier := 1, Prompt := "10 times the sum of x and 4", Choices := array{"10x + 4", "4(x + 10)", "10(x + 4)", "10 + x + 4"}, Answer := 2, Feedback := array{"\'Times the sum\' multiplies the WHOLE sum, so use ( ): 3(n + 4).", "Check which number multiplies and which number is added or taken away.", "", "Match the words: sum +, difference −, product ×, quotient ÷."}, Explanation := "Find the sum x + 4 first, so keep it together in ( ), then times 10: 10(x + 4)."},
        fnm_item{Id := "expressions/t1/004", Tier := 1, Prompt := "17 less than k", Choices := array{"k + 17", "k − 17", "17 − k", "17k"}, Answer := 1, Feedback := array{"Match the words: sum +, difference −, product ×, quotient ÷.", "", "Order matters for −. \'5 less than n\' starts at n: n − 5.", "Match the words: sum +, difference −, product ×, quotient ÷."}, Explanation := "Start at k and take 17 away: k − 17. \'Less than\' flips the order of the words."},
        fnm_item{Id := "expressions/t1/005", Tier := 1, Prompt := "t divided by 8", Choices := array{"t − 8", "8t", "t ÷ 8", "8 ÷ t"}, Answer := 2, Feedback := array{"Match the words: sum +, difference −, product ×, quotient ÷.", "Match the words: sum +, difference −, product ×, quotient ÷.", "", "Order matters for ÷. \'n divided by 3\' starts with n: n ÷ 3."}, Explanation := "t is the number being split into 8 equal parts: t ÷ 8."},
        fnm_item{Id := "expressions/t1/006", Tier := 1, Prompt := "9 times the sum of p and 3", Choices := array{"9(p + 3)", "9p + 3", "3(p + 9)", "9 + p + 3"}, Answer := 0, Feedback := array{"", "\'Times the sum\' multiplies the WHOLE sum, so use ( ): 3(n + 4).", "Check which number multiplies and which number is added or taken away.", "Match the words: sum +, difference −, product ×, quotient ÷."}, Explanation := "Find the sum p + 3 first, so keep it together in ( ), then times 9: 9(p + 3)."},
        fnm_item{Id := "expressions/t1/007", Tier := 1, Prompt := "12 less than p", Choices := array{"p + 12", "12 − p", "p − 12", "12p"}, Answer := 2, Feedback := array{"Match the words: sum +, difference −, product ×, quotient ÷.", "Order matters for −. \'5 less than n\' starts at n: n − 5.", "", "Match the words: sum +, difference −, product ×, quotient ÷."}, Explanation := "Start at p and take 12 away: p − 12. \'Less than\' flips the order of the words."},
        fnm_item{Id := "expressions/t1/008", Tier := 1, Prompt := "7 more than the product of 2 and m", Choices := array{"2m − 7", "2(m + 7)", "7m + 2", "2m + 7"}, Answer := 3, Feedback := array{"Match the words: sum +, difference −, product ×, quotient ÷.", "\'3 more than 2n\' adds 3 after multiplying: 2n + 3, no ( ).", "Check which number multiplies and which number is added or taken away.", ""}, Explanation := "The product of 2 and m is 2m. 7 more than that: 2m + 7."},
        fnm_item{Id := "expressions/t1/009", Tier := 1, Prompt := "Divide the sum of n and 5 by 10", Choices := array{"(n + 5) ÷ 10", "10 ÷ (n + 5)", "n + 5 ÷ 10", "(n + 10) ÷ 5"}, Answer := 0, Feedback := array{"", "Order matters for ÷. \'n divided by 3\' starts with n: n ÷ 3.", "\'Times the sum\' multiplies the WHOLE sum, so use ( ): 3(n + 4).", "Check which number multiplies and which number is added or taken away."}, Explanation := "The whole sum n + 5 is divided, so it goes in ( ): (n + 5) ÷ 10."},
        fnm_item{Id := "expressions/t1/010", Tier := 1, Prompt := "5 times the difference of k and 2", Choices := array{"5(2 − k)", "5(k − 2)", "5k − 2", "2(k − 5)"}, Answer := 1, Feedback := array{"Order matters for −. \'5 less than n\' starts at n: n − 5.", "", "\'Times the sum\' multiplies the WHOLE sum, so use ( ): 3(n + 4).", "Check which number multiplies and which number is added or taken away."}, Explanation := "The difference of k and 2 is k − 2. Keep it in ( ), then times 5: 5(k − 2)."},
        fnm_item{Id := "expressions/t1/011", Tier := 1, Prompt := "Subtract p from 17", Choices := array{"17 + p", "17p", "p − 17", "17 − p"}, Answer := 3, Feedback := array{"Match the words: sum +, difference −, product ×, quotient ÷.", "Match the words: sum +, difference −, product ×, quotient ÷.", "Order matters for −. \'5 less than n\' starts at n: n − 5.", ""}, Explanation := "Start with 17, then take p away from it: 17 − p."},
        fnm_item{Id := "expressions/t1/012", Tier := 1, Prompt := "6 times the difference of x and 2", Choices := array{"6(2 − x)", "6x − 2", "2(x − 6)", "6(x − 2)"}, Answer := 3, Feedback := array{"Order matters for −. \'5 less than n\' starts at n: n − 5.", "\'Times the sum\' multiplies the WHOLE sum, so use ( ): 3(n + 4).", "Check which number multiplies and which number is added or taken away.", ""}, Explanation := "The difference of x and 2 is x − 2. Keep it in ( ), then times 6: 6(x − 2)."},
        fnm_item{Id := "expressions/t1/013", Tier := 1, Prompt := "10 more than the product of 9 and w", Choices := array{"9(w + 10)", "9w − 10", "9w + 10", "10w + 9"}, Answer := 2, Feedback := array{"\'3 more than 2n\' adds 3 after multiplying: 2n + 3, no ( ).", "Match the words: sum +, difference −, product ×, quotient ÷.", "", "Check which number multiplies and which number is added or taken away."}, Explanation := "The product of 9 and w is 9w. 10 more than that: 9w + 10."},
        fnm_item{Id := "expressions/t1/014", Tier := 1, Prompt := "y divided by 5", Choices := array{"y ÷ 5", "y − 5", "5 ÷ y", "5y"}, Answer := 0, Feedback := array{"", "Match the words: sum +, difference −, product ×, quotient ÷.", "Order matters for ÷. \'n divided by 3\' starts with n: n ÷ 3.", "Match the words: sum +, difference −, product ×, quotient ÷."}, Explanation := "y is the number being split into 5 equal parts: y ÷ 5."},
        fnm_item{Id := "expressions/t1/015", Tier := 1, Prompt := "p divided by 2", Choices := array{"2p", "p − 2", "p ÷ 2", "2 ÷ p"}, Answer := 2, Feedback := array{"Match the words: sum +, difference −, product ×, quotient ÷.", "Match the words: sum +, difference −, product ×, quotient ÷.", "", "Order matters for ÷. \'n divided by 3\' starts with n: n ÷ 3."}, Explanation := "p is the number being split into 2 equal parts: p ÷ 2."},
        fnm_item{Id := "expressions/t1/016", Tier := 1, Prompt := "The quotient of y and 8", Choices := array{"8 ÷ y", "8y", "y − 8", "y ÷ 8"}, Answer := 3, Feedback := array{"Order matters for ÷. \'n divided by 3\' starts with n: n ÷ 3.", "Match the words: sum +, difference −, product ×, quotient ÷.", "Match the words: sum +, difference −, product ×, quotient ÷.", ""}, Explanation := "y is the number being split into 8 equal parts: y ÷ 8."},
