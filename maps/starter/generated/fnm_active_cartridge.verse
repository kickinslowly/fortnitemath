        fnm_item{Id := "proportional-relationships/t1/038", Tier := 1, Prompt := "A plant grows 3/4 inch in 1/8 day. Inches per day?", Choices := array{"1/6", "6", "10 2/3", "3"}, Answer := 1, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "", "Flip only the second fraction, then multiply. Not both.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour."}, Explanation := "3/4 ÷ 1/8 = 3/4 × 8 = 24/4 = 6 inches per day."},
