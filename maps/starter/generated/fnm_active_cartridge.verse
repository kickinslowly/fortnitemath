        fnm_item{Id := "rational-ops/t2/031", Tier := 2, Prompt := "−2/5 + (−4/5)", Choices := array{"−1 1/5", "1 1/5", "−3/5", "−2/5"}, Answer := 0, Feedback := array{"", "Two negatives make a positive only when you multiply or divide.", "Never add the bottoms. Make them the same, then add only the tops.", "Same signs: add the sizes and keep the sign. Don\'t subtract."}, Explanation := "Common bottom 5: −2/5 + (−4/5) = −6/5 = −1 1/5."},
