FnmCartridge_angle_relationships():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "angle-relationships",
    Version := "1.0.0",
    Title := "Angle Relationships",
    Subtitle := "Complementary, Supplementary, Vertical",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Complement \& Supplement", Description := "Find the angle that adds to 90 (complement) or to 180 (supplement)."},
        fnm_tier{Tier := 2, Name := "Vertical \& Adjacent", Description := "Two lines cross: vertical angles are equal, angles next to each other add to 180."},
        fnm_tier{Tier := 3, Name := "Name It \& Split Angles", Description := "Name the angle pairs, then find the missing part of a right angle or a straight line."},
        fnm_tier{Tier := 4, Name := "Solve for the Angle", Description := "Angle pairs with x in them: write the equation and solve for x."},
        fnm_tier{Tier := 5, Name := "Multi-Step Angles", Description := "Vertical and adjacent angles with 2x + 10 style expressions; find x or the angle."}
    },
    Items := array{
        fnm_item{Id := "angle-relationships/t1/001", Tier := 1, Prompt := "Angles 130 and x are supplementary. x in degrees?", Choices := array{"230", "70", "40", "50"}, Answer := 3, Feedback := array{"A right angle is 90 and a straight line is 180. 360 is a full turn.", "Check your arithmetic.", "Complementary adds to 90 (a corner). Supplementary adds to 180 (a line).", ""}, Explanation := "Supplementary angles add to 180: 180 − 130 = 50."},
