FnmCartridge_data_statistics():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "data-statistics",
    Version := "1.0.0",
    Title := "Data \& Statistics",
    Subtitle := "Mean, Median, Range, MAD",
    Grade := "6",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Range \& Mode", Description := "Range is largest minus smallest. Mode is the value that shows up most often."},
        fnm_tier{Tier := 2, Name := "Median", Description := "Put the numbers in order; the median is the middle one (or halfway between the two middles)."},
        fnm_tier{Tier := 3, Name := "Mean", Description := "Add the numbers, then divide by how many there are."},
        fnm_tier{Tier := 4, Name := "Missing Value \& Outliers", Description := "Work back from a mean to a missing value; see which measure an outlier moves."},
        fnm_tier{Tier := 5, Name := "Mean Absolute Deviation", Description := "Average distance from the mean: find the mean, each distance, then their mean."}
    },
    Items := array{
        fnm_item{Id := "data-statistics/t1/001", Tier := 1, Prompt := "Find the mode: 3, 3, 17, 17, 20, 17, 17", Choices := array{"4", "20", "3", "17"}, Answer := 3, Feedback := array{"That\'s how many times it shows up. The mode is the value itself.", "Mode is the value that shows up most often, not the biggest one.", "Count each value again. The mode shows up more times than any other.", ""}, Explanation := "17 shows up 4 times, more than any other value (3 shows up 2 times). Mode = 17."},
        fnm_item{Id := "data-statistics/t1/002", Tier := 1, Prompt := "Find the range: 2, 11, 20, 19, 15, 3, 12", Choices := array{"10", "18", "20", "19"}, Answer := 1, Feedback := array{"Find the largest and smallest first, wherever they sit in the list.", "", "Range is largest minus smallest, not just the largest.", "Check your arithmetic."}, Explanation := "Largest 20 − smallest 2 = 18."},
        fnm_item{Id := "data-statistics/t1/003", Tier := 1, Prompt := "Find the mode: 4, 4, 1, 1, 1, 16, 14", Choices := array{"16", "1", "3", "4"}, Answer := 1, Feedback := array{"Mode is the value that shows up most often, not the biggest one.", "", "That\'s how many times it shows up. The mode is the value itself.", "Count each value again. The mode shows up more times than any other."}, Explanation := "1 shows up 3 times, more than any other value (4 shows up 2 times). Mode = 1."},
        fnm_item{Id := "data-statistics/t1/004", Tier := 1, Prompt := "Find the mode: 6, 6, 11, 12, 6, 18, 11", Choices := array{"3", "18", "6", "11"}, Answer := 2, Feedback := array{"That\'s how many times it shows up. The mode is the value itself.", "Mode is the value that shows up most often, not the biggest one.", "", "Count each value again. The mode shows up more times than any other."}, Explanation := "6 shows up 3 times, more than any other value (11 shows up 2 times). Mode = 6."},
        fnm_item{Id := "data-statistics/t1/005", Tier := 1, Prompt := "Find the mode: 10, 2, 14, 10, 14, 16, 10", Choices := array{"14", "3", "10", "16"}, Answer := 2, Feedback := array{"Count each value again. The mode shows up more times than any other.", "That\'s how many times it shows up. The mode is the value itself.", "", "Mode is the value that shows up most often, not the biggest one."}, Explanation := "10 shows up 3 times, more than any other value (14 shows up 2 times). Mode = 10."},
        fnm_item{Id := "data-statistics/t1/006", Tier := 1, Prompt := "Find the mode: 7, 3, 7, 2, 12, 2, 7", Choices := array{"12", "3", "7", "2"}, Answer := 2, Feedback := array{"Mode is the value that shows up most often, not the biggest one.", "That\'s how many times it shows up. The mode is the value itself.", "", "Count each value again. The mode shows up more times than any other."}, Explanation := "7 shows up 3 times, more than any other value (2 shows up 2 times). Mode = 7."},
        fnm_item{Id := "data-statistics/t1/007", Tier := 1, Prompt := "Find the mode: 7, 4, 4, 4, 7, 17, 19", Choices := array{"7", "19", "4", "3"}, Answer := 2, Feedback := array{"Count each value again. The mode shows up more times than any other.", "Mode is the value that shows up most often, not the biggest one.", "", "That\'s how many times it shows up. The mode is the value itself."}, Explanation := "4 shows up 3 times, more than any other value (7 shows up 2 times). Mode = 4."},
        fnm_item{Id := "data-statistics/t1/008", Tier := 1, Prompt := "Find the mode: 12, 11, 9, 9, 11, 14, 11", Choices := array{"3", "14", "11", "9"}, Answer := 2, Feedback := array{"That\'s how many times it shows up. The mode is the value itself.", "Mode is the value that shows up most often, not the biggest one.", "", "Count each value again. The mode shows up more times than any other."}, Explanation := "11 shows up 3 times, more than any other value (9 shows up 2 times). Mode = 11."},
        fnm_item{Id := "data-statistics/t1/009", Tier := 1, Prompt := "Find the range: 4, 1, 9, 2, 6, 20", Choices := array{"20", "19", "18", "16"}, Answer := 1, Feedback := array{"Range is largest minus smallest, not just the largest.", "", "Check your arithmetic.", "Find the largest and smallest first, wherever they sit in the list."}, Explanation := "Largest 20 − smallest 1 = 19."},
        fnm_item{Id := "data-statistics/t1/010", Tier := 1, Prompt := "Find the mode: 10, 10, 10, 4, 4, 19", Choices := array{"4", "19", "10", "3"}, Answer := 2, Feedback := array{"Count each value again. The mode shows up more times than any other.", "Mode is the value that shows up most often, not the biggest one.", "", "That\'s how many times it shows up. The mode is the value itself."}, Explanation := "10 shows up 3 times, more than any other value (4 shows up 2 times). Mode = 10."},
        fnm_item{Id := "data-statistics/t1/011", Tier := 1, Prompt := "Find the range: 7, 15, 9, 8, 5, 18, 12", Choices := array{"13", "18", "14", "5"}, Answer := 0, Feedback := array{"", "Range is largest minus smallest, not just the largest.", "Check your arithmetic.", "Find the largest and smallest first, wherever they sit in the list."}, Explanation := "Largest 18 − smallest 5 = 13."},
        fnm_item{Id := "data-statistics/t1/012", Tier := 1, Prompt := "Find the range: 5, 7, 12, 2, 8, 10, 16", Choices := array{"11", "14", "16", "15"}, Answer := 1, Feedback := array{"Find the largest and smallest first, wherever they sit in the list.", "", "Range is largest minus smallest, not just the largest.", "Check your arithmetic."}, Explanation := "Largest 16 − smallest 2 = 14."},
        fnm_item{Id := "data-statistics/t1/013", Tier := 1, Prompt := "Find the mode: 3, 13, 7, 3, 7, 3, 3", Choices := array{"7", "3", "4", "13"}, Answer := 1, Feedback := array{"Count each value again. The mode shows up more times than any other.", "", "That\'s how many times it shows up. The mode is the value itself.", "Mode is the value that shows up most often, not the biggest one."}, Explanation := "3 shows up 4 times, more than any other value (7 shows up 2 times). Mode = 3."},
        fnm_item{Id := "data-statistics/t1/014", Tier := 1, Prompt := "Find the mode: 9, 16, 1, 9, 1, 17, 9", Choices := array{"9", "1", "17", "3"}, Answer := 0, Feedback := array{"", "Count each value again. The mode shows up more times than any other.", "Mode is the value that shows up most often, not the biggest one.", "That\'s how many times it shows up. The mode is the value itself."}, Explanation := "9 shows up 3 times, more than any other value (1 shows up 2 times). Mode = 9."},
        fnm_item{Id := "data-statistics/t1/015", Tier := 1, Prompt := "Find the range: 8, 18, 1, 6, 17, 12, 3", Choices := array{"18", "5", "16", "17"}, Answer := 3, Feedback := array{"Range is largest minus smallest, not just the largest.", "Find the largest and smallest first, wherever they sit in the list.", "Check your arithmetic.", ""}, Explanation := "Largest 18 − smallest 1 = 17."},
        fnm_item{Id := "data-statistics/t1/016", Tier := 1, Prompt := "Find the mode: 5, 3, 4, 4, 4, 7, 5", Choices := array{"7", "5", "3", "4"}, Answer := 3, Feedback := array{"Mode is the value that shows up most often, not the biggest one.", "Count each value again. The mode shows up more times than any other.", "That\'s how many times it shows up. The mode is the value itself.", ""}, Explanation := "4 shows up 3 times, more than any other value (5 shows up 2 times). Mode = 4."},
        fnm_item{Id := "data-statistics/t1/017", Tier := 1, Prompt := "Find the mode: 6, 14, 14, 5, 6, 6, 17", Choices := array{"17", "6", "14", "3"}, Answer := 1, Feedback := array{"Mode is the value that shows up most often, not the biggest one.", "", "Count each value again. The mode shows up more times than any other.", "That\'s how many times it shows up. The mode is the value itself."}, Explanation := "6 shows up 3 times, more than any other value (14 shows up 2 times). Mode = 6."},
        fnm_item{Id := "data-statistics/t1/018", Tier := 1, Prompt := "Find the range: 7, 17, 13, 12, 16, 14", Choices := array{"7", "11", "17", "10"}, Answer := 3, Feedback := array{"Find the largest and smallest first, wherever they sit in the list.", "Check your arithmetic.", "Range is largest minus smallest, not just the largest.", ""}, Explanation := "Largest 17 − smallest 7 = 10."},
