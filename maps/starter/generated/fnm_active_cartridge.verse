        fnm_item{Id := "two-step-equations/t5/003", Tier := 5, Prompt := "Save more than $20. Have $8, add $2 a week. Weeks w?", Choices := array{"w ≥ 6", "w \< 6", "w \> 14", "w \> 6"}, Answer := 3, Feedback := array{"Check the sign: ≤ and ≥ include the number, \< and \> do not.", "Check the words: at most and under mean less, at least and over mean more.", "Undo + with −, and − with +, on both sides.", ""}, Explanation := "2w + 8 \> 20. Subtract 8: 2w \> 12. Divide by 2: w \> 6. 6 does not count."},
        fnm_item{Id := "two-step-equations/t5/004", Tier := 5, Prompt := "Solve: −5m + 8 ≤ −12", Choices := array{"m ≤ 4", "m ≥ −4", "m ≥ 4", "m \> 4"}, Answer := 2, Feedback := array{"Dividing by a negative FLIPS the sign: \< becomes \>, ≤ becomes ≥.", "Same signs divide to positive; different signs divide to negative.", "", "Check the sign: ≤ and ≥ include the number, \< and \> do not."}, Explanation := "Subtract 8: −5m ≤ −20. Divide by −5 and flip the sign: m ≥ 4."},
