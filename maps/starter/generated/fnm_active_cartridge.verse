        fnm_item{Id := "expressions/t3/029", Tier := 3, Prompt := "Find 1 + 4n when n = 8", Choices := array{"33", "49", "40", "13"}, Answer := 0, Feedback := array{"", "3x means 3 times x. With x = 5 it is 3 × 5 = 15, not 35.", "Multiply before you add, unless ( ) say otherwise.", "A number next to a letter means multiply: 3x is 3 × x, not 3 + x."}, Explanation := "Multiply first: 4 × 8 = 32. Then 1 + 32 = 33."},
