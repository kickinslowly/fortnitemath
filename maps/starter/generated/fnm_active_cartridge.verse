        fnm_item{Id := "rational-ops/t2/039", Tier := 2, Prompt := "−1/6 − (−1/3)", Choices := array{"0", "−1/6", "1/2", "1/6"}, Answer := 3, Feedback := array{"Never add the bottoms. Make them the same, then add only the tops.", "Right size, wrong sign. Which number is farther from 0?", "Different signs: subtract the sizes, keep the sign of the bigger one.", ""}, Explanation := "Subtracting −1/3 is adding 1/3. Common bottom 6: −1/6 + 2/6 = 1/6."},
        fnm_item{Id := "rational-ops/t2/040", Tier := 2, Prompt := "1/7 + (−5/7)", Choices := array{"6/7", "−4/7", "−2/7", "−6/7"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes. The bigger size decides the sign.", "", "Never add the bottoms. Make them the same, then add only the tops.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Common bottom 7: 1/7 + (−5/7) = −4/7."},
        fnm_item{Id := "rational-ops/t3/001", Tier := 3, Prompt := "1/2 ÷ (−6)", Choices := array{"−3", "−1/12", "1/12", "−12"}, Answer := 1, Feedback := array{"You multiplied as is. To divide, multiply by the flipped divisor.", "", "One negative makes it negative. Two negatives make it positive.", "Flip the second fraction, not the first: keep, change, flip."}, Explanation := "One negative, so negative. Flip the divisor: 1/2 × 1/6 = 1/12, so −1/12."},
