FnmCartridge_rational_ops():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "rational-ops",
    Version := "1.0.0",
    Title := "Rational Number Operations",
    Subtitle := "Fractions \& Decimals with Signs",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Signed Decimals", Description := "Add and subtract decimals with negatives."},
        fnm_tier{Tier := 2, Name := "Signed Fractions", Description := "Add and subtract fractions with negatives. Same bottom first."},
        fnm_tier{Tier := 3, Name := "Multiply \& Divide", Description := "Multiply and divide fractions and decimals. Watch the signs."},
        fnm_tier{Tier := 4, Name := "Fractions as Decimals", Description := "Turn fractions into decimals. Some repeat forever."},
        fnm_tier{Tier := 5, Name := "Stories \& Two Steps", Description := "Temperature, money and elevation stories, plus two-step problems."}
    },
    Items := array{
        fnm_item{Id := "rational-ops/t1/001", Tier := 1, Prompt := "−0.9 + 0.2", Choices := array{"−0.7", "−1.1", "0.7", "−0.6"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Right size, wrong sign. Which number is farther from 0?", "Check your arithmetic."}, Explanation := "Signs differ: 0.9 − 0.2 = 0.7, and the bigger one is negative, so −0.7."},
        fnm_item{Id := "rational-ops/t1/002", Tier := 1, Prompt := "0.3 − 1.9", Choices := array{"1.6", "2.2", "−1.6", "−2.2"}, Answer := 2, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "Different signs: subtract the sizes. The bigger size decides the sign.", "", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Subtracting 1.9 is adding −1.9. Signs differ: 1.9 − 0.3 = 1.6, and the bigger one is negative, so −1.6."},
        fnm_item{Id := "rational-ops/t1/003", Tier := 1, Prompt := "0.5 − 0.7", Choices := array{"−1.2", "−0.2", "0.2", "1.2"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "", "Right size, wrong sign. Which number is farther from 0?", "Different signs: subtract the sizes. The bigger size decides the sign."}, Explanation := "Subtracting 0.7 is adding −0.7. Signs differ: 0.7 − 0.5 = 0.2, and the bigger one is negative, so −0.2."},
        fnm_item{Id := "rational-ops/t1/004", Tier := 1, Prompt := "−0.1 − 0.7", Choices := array{"−0.9", "0.8", "−0.8", "−0.6"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Two negatives make a positive only when you multiply or divide.", "", "Same signs: add the sizes and keep the sign. Don\'t subtract."}, Explanation := "Subtracting 0.7 is adding −0.7. Same signs: 0.1 + 0.7 = 0.8, both negative, so −0.8."},
        fnm_item{Id := "rational-ops/t1/005", Tier := 1, Prompt := "−0.6 − 1.1", Choices := array{"−0.5", "−1.8", "−1.7", "1.7"}, Answer := 2, Feedback := array{"Same signs: add the sizes and keep the sign. Don\'t subtract.", "Check your arithmetic.", "", "Two negatives make a positive only when you multiply or divide."}, Explanation := "Subtracting 1.1 is adding −1.1. Same signs: 0.6 + 1.1 = 1.7, both negative, so −1.7."},
        fnm_item{Id := "rational-ops/t1/006", Tier := 1, Prompt := "−1.2 + 0.6", Choices := array{"−1.8", "−0.7", "0.6", "−0.6"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Check your arithmetic.", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "Signs differ: 1.2 − 0.6 = 0.6, and the bigger one is negative, so −0.6."},
        fnm_item{Id := "rational-ops/t1/007", Tier := 1, Prompt := "0.2 − (−0.4)", Choices := array{"0.2", "−0.2", "−0.6", "0.6"}, Answer := 3, Feedback := array{"Same signs: add the sizes and keep the sign. Don\'t subtract.", "Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "Subtracting −0.4 is adding 0.4. Same signs: 0.2 + 0.4 = 0.6, both positive, so 0.6."},
        fnm_item{Id := "rational-ops/t1/008", Tier := 1, Prompt := "−1.2 − 0.4", Choices := array{"1.6", "−1.7", "−1.6", "−0.8"}, Answer := 2, Feedback := array{"Two negatives make a positive only when you multiply or divide.", "Check your arithmetic.", "", "Same signs: add the sizes and keep the sign. Don\'t subtract."}, Explanation := "Subtracting 0.4 is adding −0.4. Same signs: 1.2 + 0.4 = 1.6, both negative, so −1.6."},
        fnm_item{Id := "rational-ops/t1/009", Tier := 1, Prompt := "−0.8 − 0.3", Choices := array{"−0.5", "−1.1", "−1.2", "1.1"}, Answer := 1, Feedback := array{"Same signs: add the sizes and keep the sign. Don\'t subtract.", "", "Check your arithmetic.", "Two negatives make a positive only when you multiply or divide."}, Explanation := "Subtracting 0.3 is adding −0.3. Same signs: 0.8 + 0.3 = 1.1, both negative, so −1.1."},
        fnm_item{Id := "rational-ops/t1/010", Tier := 1, Prompt := "−0.3 + (−1.3)", Choices := array{"−1", "1.6", "−1.5", "−1.6"}, Answer := 3, Feedback := array{"Same signs: add the sizes and keep the sign. Don\'t subtract.", "Two negatives make a positive only when you multiply or divide.", "Check your arithmetic.", ""}, Explanation := "Same signs: 0.3 + 1.3 = 1.6, both negative, so −1.6."},
        fnm_item{Id := "rational-ops/t1/011", Tier := 1, Prompt := "0.7 + (−1.7)", Choices := array{"−1", "2.4", "−2.4", "1"}, Answer := 0, Feedback := array{"", "Different signs: subtract the sizes. The bigger size decides the sign.", "Different signs: subtract the sizes, keep the sign of the bigger one.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "Signs differ: 1.7 − 0.7 = 1, and the bigger one is negative, so −1."},
        fnm_item{Id := "rational-ops/t1/012", Tier := 1, Prompt := "−0.8 − 0.1", Choices := array{"0.9", "−0.7", "−0.9", "−0.8"}, Answer := 2, Feedback := array{"Two negatives make a positive only when you multiply or divide.", "Same signs: add the sizes and keep the sign. Don\'t subtract.", "", "Check your arithmetic."}, Explanation := "Subtracting 0.1 is adding −0.1. Same signs: 0.8 + 0.1 = 0.9, both negative, so −0.9."},
        fnm_item{Id := "rational-ops/t1/013", Tier := 1, Prompt := "0.7 − 1.2", Choices := array{"−0.5", "0.5", "1.9", "−1.9"}, Answer := 0, Feedback := array{"", "Right size, wrong sign. Which number is farther from 0?", "Different signs: subtract the sizes. The bigger size decides the sign.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Subtracting 1.2 is adding −1.2. Signs differ: 1.2 − 0.7 = 0.5, and the bigger one is negative, so −0.5."},
        fnm_item{Id := "rational-ops/t1/014", Tier := 1, Prompt := "0.6 − (−1.1)", Choices := array{"−0.5", "1.7", "0.5", "−1.7"}, Answer := 1, Feedback := array{"Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "", "Same signs: add the sizes and keep the sign. Don\'t subtract.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "Subtracting −1.1 is adding 1.1. Same signs: 0.6 + 1.1 = 1.7, both positive, so 1.7."},
        fnm_item{Id := "rational-ops/t1/015", Tier := 1, Prompt := "−1.9 + 1.7", Choices := array{"−3.6", "−0.2", "−0.3", "0.2"}, Answer := 1, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "", "Check your arithmetic.", "Right size, wrong sign. Which number is farther from 0?"}, Explanation := "Signs differ: 1.9 − 1.7 = 0.2, and the bigger one is negative, so −0.2."},
        fnm_item{Id := "rational-ops/t1/016", Tier := 1, Prompt := "−1.1 − (−1.5)", Choices := array{"−2.6", "0.4", "−0.4", "2.6"}, Answer := 1, Feedback := array{"Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "", "Right size, wrong sign. Which number is farther from 0?", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "Subtracting −1.5 is adding 1.5. Signs differ: 1.5 − 1.1 = 0.4, and the bigger one is positive, so 0.4."},
        fnm_item{Id := "rational-ops/t1/017", Tier := 1, Prompt := "−0.5 + 1.6", Choices := array{"2.1", "−2.1", "−1.1", "1.1"}, Answer := 3, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Different signs: subtract the sizes. The bigger size decides the sign.", "Right size, wrong sign. Which number is farther from 0?", ""}, Explanation := "Signs differ: 1.6 − 0.5 = 1.1, and the bigger one is positive, so 1.1."},
        fnm_item{Id := "rational-ops/t1/018", Tier := 1, Prompt := "−0.5 + 1.7", Choices := array{"2.2", "−1.2", "1.2", "−2.2"}, Answer := 2, Feedback := array{"Different signs: subtract the sizes, keep the sign of the bigger one.", "Right size, wrong sign. Which number is farther from 0?", "", "Different signs: subtract the sizes. The bigger size decides the sign."}, Explanation := "Signs differ: 1.7 − 0.5 = 1.2, and the bigger one is positive, so 1.2."},
