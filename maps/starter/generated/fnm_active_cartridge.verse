        fnm_item{Id := "two-step-equations/t5/001", Tier := 5, Prompt := "Solve: 10 − 5w \< −10", Choices := array{"w \> −4", "w \< 4", "w \> 4", "w ≥ 4"}, Answer := 2, Feedback := array{"Same signs divide to positive; different signs divide to negative.", "Dividing by a negative FLIPS the sign: \< becomes \>, ≤ becomes ≥.", "", "Check the sign: ≤ and ≥ include the number, \< and \> do not."}, Explanation := "Subtract 10: −5w \< −20. Divide by −5 and flip the sign: w \> 4."},
