        fnm_item{Id := "integer-ops/t1/005", Tier := 1, Prompt := "−6 + 3", Choices := array{"−1", "−3", "3", "−9"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Right size, wrong sign. Which number is farther from 0?", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "−6 + 3: signs differ, 6 − 3 = 3. −6 is farther from 0, so negative: −3."},
