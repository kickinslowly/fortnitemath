        fnm_item{Id := "probability/t5/018", Tier := 5, Prompt := "Flip a coin, roll a die. P(heads and an odd number)?", Choices := array{"1/6", "1/4", "1/2", "3/8"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Both parts must happen. Multiply by the other part\'s chance too.", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8."}, Explanation := "3 of 12 outcomes: 3/12 = 1/4."},
        fnm_item{Id := "probability/t5/019", Tier := 5, Prompt := "4-part spinner (1 to 4), coin. P(a 1 and heads)?", Choices := array{"1/8", "3/4", "1/2", "1/6"}, Answer := 0, Feedback := array{"", "For \'and\', multiply the chances. Adding makes a chance that\'s too big.", "Both parts must happen. Multiply by the other part\'s chance too.", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8."}, Explanation := "1/4 × 1/2 = 1/8."},
        fnm_item{Id := "probability/t5/020", Tier := 5, Prompt := "4-part spinner (1 to 4), coin. P(a 1 and tails)?", Choices := array{"1/2", "3/4", "1/6", "1/8"}, Answer := 3, Feedback := array{"Both parts must happen. Multiply by the other part\'s chance too.", "For \'and\', multiply the chances. Adding makes a chance that\'s too big.", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", ""}, Explanation := "1/4 × 1/2 = 1/8."},
        fnm_item{Id := "probability/t5/021", Tier := 5, Prompt := "Flip three coins. P(all heads)?", Choices := array{"1/4", "1/8", "7/8", "1/2"}, Answer := 1, Feedback := array{"HT and TH are different outcomes. Order counts, so count both.", "", "That is the opposite event. Find the one the question asks about.", "Both parts must happen. Multiply by the other part\'s chance too."}, Explanation := "1 of 8 outcomes (HHH): 1/8."},
        fnm_item{Id := "probability/t5/022", Tier := 5, Prompt := "Flip two coins. P(no heads)?", Choices := array{"1/4", "1/3", "3/4", "1/2"}, Answer := 0, Feedback := array{"", "HT and TH are different outcomes. Order counts, so count both.", "That is the opposite event. Find the one the question asks about.", "Both parts must happen. Multiply by the other part\'s chance too."}, Explanation := "1 of 4 outcomes (TT): 1/4."},
        fnm_item{Id := "probability/t5/023", Tier := 5, Prompt := "Flip a coin, roll a die. P(heads and a number under 5)?", Choices := array{"1/4", "1/3", "1/2", "2/3"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "Both parts must happen. Multiply by the other part\'s chance too."}, Explanation := "4 of 12 outcomes: 4/12 = 1/3."},
        fnm_item{Id := "probability/t5/024", Tier := 5, Prompt := "Flip two coins. P(one head, one tail)?", Choices := array{"3/4", "1/4", "1/2", "1/3"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Count ALL the outcomes that fit the event, not just one of them.", "", "HT and TH are different outcomes. Order counts, so count both."}, Explanation := "2 of 4 outcomes (HT, TH): 2/4 = 1/2."},
        fnm_item{Id := "probability/t5/025", Tier := 5, Prompt := "Flip three coins. P(H, H, T in that order)?", Choices := array{"1/2", "1/4", "7/8", "1/8"}, Answer := 3, Feedback := array{"Both parts must happen. Multiply by the other part\'s chance too.", "HT and TH are different outcomes. Order counts, so count both.", "That is the opposite event. Find the one the question asks about.", ""}, Explanation := "1 of 8 outcomes (HHT): 1/8."},
        fnm_item{Id := "probability/t5/026", Tier := 5, Prompt := "Flip three coins. P(at most one head)?", Choices := array{"2/3", "3/8", "1/8", "1/2"}, Answer := 3, Feedback := array{"Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "Check your arithmetic.", "Count ALL the outcomes that fit the event, not just one of them.", ""}, Explanation := "4 of 8 outcomes (HTT, THT, TTH, TTT): 4/8 = 1/2."},
        fnm_item{Id := "probability/t5/027", Tier := 5, Prompt := "Flip two coins. P(the coins match)?", Choices := array{"3/4", "1/4", "1/2", "2/3"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Count ALL the outcomes that fit the event, not just one of them.", "", "HT and TH are different outcomes. Order counts, so count both."}, Explanation := "2 of 4 outcomes (HH, TT): 2/4 = 1/2."},
        fnm_item{Id := "probability/t5/028", Tier := 5, Prompt := "Flip three coins. P(no heads)?", Choices := array{"1/8", "1/4", "7/8", "1/6"}, Answer := 0, Feedback := array{"", "HT and TH are different outcomes. Order counts, so count both.", "That is the opposite event. Find the one the question asks about.", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8."}, Explanation := "1 of 8 outcomes (TTT): 1/8."},
        fnm_item{Id := "probability/t5/029", Tier := 5, Prompt := "Flip two coins. P(at least one head)?", Choices := array{"1/2", "1/4", "2/3", "3/4"}, Answer := 3, Feedback := array{"Both parts must happen. Multiply by the other part\'s chance too.", "That is the opposite event. Find the one the question asks about.", "HT and TH are different outcomes. Order counts, so count both.", ""}, Explanation := "3 of 4 outcomes (HH, HT, TH): 3/4."},
        fnm_item{Id := "probability/t5/030", Tier := 5, Prompt := "Bag: 1 red, 2 white. Draw, replace, draw. P(red twice)?", Choices := array{"1/3", "1/9", "1/6", "2/3"}, Answer := 1, Feedback := array{"Both parts must happen. Multiply by the other part\'s chance too.", "", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "For \'and\', multiply the chances. Adding makes a chance that\'s too big."}, Explanation := "1/3 × 1/3 = 1/9."},
        fnm_item{Id := "probability/t5/031", Tier := 5, Prompt := "Flip a coin, roll a die. P(tails and a number over 4)?", Choices := array{"1/6", "5/6", "1/2", "1/4"}, Answer := 0, Feedback := array{"", "For \'and\', multiply the chances. Adding makes a chance that\'s too big.", "Both parts must happen. Multiply by the other part\'s chance too.", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8."}, Explanation := "2 of 12 outcomes: 2/12 = 1/6."},
        fnm_item{Id := "probability/t5/032", Tier := 5, Prompt := "4-part spinner (1 to 4), coin. P(under 4 and heads)?", Choices := array{"3/8", "3/4", "1/2", "5/8"}, Answer := 0, Feedback := array{"", "Both parts must happen. Multiply by the other part\'s chance too.", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "Check your arithmetic."}, Explanation := "3/4 × 1/2 = 3/8."},
        fnm_item{Id := "probability/t5/033", Tier := 5, Prompt := "Bag: 2 red, 1 white. Draw, replace, draw. P(white then red)?", Choices := array{"1/3", "2/9", "1/9", "4/9"}, Answer := 1, Feedback := array{"Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "", "Check your arithmetic.", "The order is given: \'red then blue\' is one order only. Don\'t double it."}, Explanation := "1/3 × 2/3 = 2/9."},
        fnm_item{Id := "probability/t5/034", Tier := 5, Prompt := "3-part spinner (red, blue, green), coin. P(red and heads)?", Choices := array{"1/3", "1/2", "1/6", "5/6"}, Answer := 2, Feedback := array{"Both parts must happen. Multiply by the other part\'s chance too.", "Both parts must happen. Multiply by the other part\'s chance too.", "", "For \'and\', multiply the chances. Adding makes a chance that\'s too big."}, Explanation := "1/3 × 1/2 = 1/6."},
        fnm_item{Id := "probability/t5/035", Tier := 5, Prompt := "Flip three coins. P(two or more heads)?", Choices := array{"2/3", "1/8", "1/4", "1/2"}, Answer := 3, Feedback := array{"Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "Count ALL the outcomes that fit the event, not just one of them.", "Check your arithmetic.", ""}, Explanation := "4 of 8 outcomes (HHH, HHT, HTH, THH): 4/8 = 1/2."},
        fnm_item{Id := "probability/t5/036", Tier := 5, Prompt := "Flip three coins. P(at least one head)?", Choices := array{"7/8", "1/8", "1/2", "3/4"}, Answer := 0, Feedback := array{"", "That is the opposite event. Find the one the question asks about.", "Both parts must happen. Multiply by the other part\'s chance too.", "HT and TH are different outcomes. Order counts, so count both."}, Explanation := "7 of 8 outcomes (HHH, HHT, HTH, HTT, THH, THT, TTH): 7/8."},
        fnm_item{Id := "probability/t5/037", Tier := 5, Prompt := "Bag: 1 red, 2 white. Draw, replace, draw. P(one of each)?", Choices := array{"1/3", "4/9", "1/9", "2/9"}, Answer := 1, Feedback := array{"Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "", "Check your arithmetic.", "Either order works (red then blue, or blue then red): count both."}, Explanation := "1/3 × 2/3 × 2 orders = 4/9."},
        fnm_item{Id := "probability/t5/038", Tier := 5, Prompt := "4-part spinner (1 to 4), coin. P(over 2 and heads)?", Choices := array{"1/2", "1/4", "1/3", "1/8"}, Answer := 1, Feedback := array{"Both parts must happen. Multiply by the other part\'s chance too.", "", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8.", "Check your arithmetic."}, Explanation := "1/2 × 1/2 = 1/4."},
        fnm_item{Id := "probability/t5/039", Tier := 5, Prompt := "Bag: 1 red, 2 blue. Draw, replace, draw. P(one of each)?", Choices := array{"2/9", "1/9", "4/9", "1/3"}, Answer := 2, Feedback := array{"Either order works (red then blue, or blue then red): count both.", "Check your arithmetic.", "", "Multiply fractions straight across: 1/2 × 1/6 = 1/12, not 1/8."}, Explanation := "1/3 × 2/3 × 2 orders = 4/9."},
        fnm_item{Id := "probability/t5/040", Tier := 5, Prompt := "Flip a coin, roll a die. P(heads and a multiple of 3)?", Choices := array{"1/2", "1/3", "1/6", "5/6"}, Answer := 2, Feedback := array{"Both parts must happen. Multiply by the other part\'s chance too.", "Both parts must happen. Multiply by the other part\'s chance too.", "", "For \'and\', multiply the chances. Adding makes a chance that\'s too big."}, Explanation := "2 of 12 outcomes: 2/12 = 1/6."}
    }
}

FnmCartridge_proportional_relationships():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "proportional-relationships",
    Version := "1.0.0",
    Title := "Proportional Relationships",
    Subtitle := "Unit Rates, Constant k, Scale Drawings",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Fraction Unit Rates", Description := "Find the rate per 1 when the amounts are fractions."},
        fnm_tier{Tier := 2, Name := "Proportional or Not?", Description := "Spot the equation, point or table where y is always k times x."},
        fnm_tier{Tier := 3, Name := "Finding the Constant k", Description := "Find k = y ÷ x from an equation, a point, a table or a story."},
        fnm_tier{Tier := 4, Name := "Write the Equation", Description := "Write y = kx from a story: totals, rates and unit conversions."},
        fnm_tier{Tier := 5, Name := "Scale Drawings", Description := "Scale lengths and areas up and down; areas scale by k × k."}
    },
    Items := array{
        fnm_item{Id := "proportional-relationships/t1/001", Tier := 1, Prompt := "Pipe A is 3/8 ft, pipe B is 1/4 ft. A is how many times B?", Choices := array{"3/32", "1/8", "2/3", "1 1/2"}, Answer := 3, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", ""}, Explanation := "3/8 ÷ 1/4 = 3/8 × 4 = 12/8 = 1 1/2 times as long."},
        fnm_item{Id := "proportional-relationships/t1/002", Tier := 1, Prompt := "1/2 yd of yarn makes 3/8 scarf. Yards for 1 scarf?", Choices := array{"1/3", "3/4", "5 1/3", "1 1/3"}, Answer := 3, Feedback := array{"The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Flip only the second fraction, then multiply. Not both.", ""}, Explanation := "1/2 ÷ 3/8 = 1/2 × 8/3 = 8/6 = 1 1/3 yards per scarf."},
        fnm_item{Id := "proportional-relationships/t1/003", Tier := 1, Prompt := "3/5 gal of paint covers 3/10 wall. Gallons for 1 wall?", Choices := array{"2", "1", "1/2", "9/50"}, Answer := 0, Feedback := array{"", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "3/5 ÷ 3/10 = 3/5 × 10/3 = 30/15 = 2 gallons per wall."},
        fnm_item{Id := "proportional-relationships/t1/004", Tier := 1, Prompt := "A cyclist rides 5/6 mile in 1/6 hour. Miles per hour?", Choices := array{"7 1/5", "1/5", "5/36", "5"}, Answer := 3, Feedback := array{"Flip only the second fraction, then multiply. Not both.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", ""}, Explanation := "5/6 ÷ 1/6 = 5/6 × 6 = 30/6 = 5 miles per hour."},
        fnm_item{Id := "proportional-relationships/t1/005", Tier := 1, Prompt := "2/3 lb of grapes costs $2. Cost per lb?", Choices := array{"$1", "$1 1/3", "$3", "$1/3"}, Answer := 2, Feedback := array{"The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount."}, Explanation := "$2 ÷ 2/3 = $2 × 3/2 = $3 per lb."},
        fnm_item{Id := "proportional-relationships/t1/006", Tier := 1, Prompt := "1/2 lb of fudge costs $3. Cost per lb?", Choices := array{"$1/6", "$1 1/2", "$6", "$3"}, Answer := 2, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour."}, Explanation := "$3 ÷ 1/2 = $3 × 2 = $6 per lb."},
        fnm_item{Id := "proportional-relationships/t1/007", Tier := 1, Prompt := "Tube A is 1/6 yd, tube B is 5/6 yd. A is how many times B?", Choices := array{"5", "1/5", "5/36", "2/3"}, Answer := 1, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract."}, Explanation := "1/6 ÷ 5/6 = 1/6 × 6/5 = 6/30 = 1/5 times as long."},
        fnm_item{Id := "proportional-relationships/t1/008", Tier := 1, Prompt := "A tap fills 7/8 gal in 1/8 minute. Gallons per minute?", Choices := array{"7/64", "9", "1/7", "7"}, Answer := 3, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "Check your arithmetic.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", ""}, Explanation := "7/8 ÷ 1/8 = 7/8 × 8 = 56/8 = 7 gallons per minute."},
        fnm_item{Id := "proportional-relationships/t1/009", Tier := 1, Prompt := "7/10 cup of sugar makes 1/10 batch. Cups for 1 batch?", Choices := array{"7/100", "7", "1/7", "9"}, Answer := 1, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Check your arithmetic."}, Explanation := "7/10 ÷ 1/10 = 7/10 × 10 = 70/10 = 7 cups per batch."},
        fnm_item{Id := "proportional-relationships/t1/010", Tier := 1, Prompt := "A hiker walks 5/8 mile in 3/8 hour. Miles per hour?", Choices := array{"3/5", "1 2/3", "3 2/3", "15/64"}, Answer := 1, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "", "Check your arithmetic.", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "5/8 ÷ 3/8 = 5/8 × 8/3 = 40/24 = 1 2/3 miles per hour."},
        fnm_item{Id := "proportional-relationships/t1/011", Tier := 1, Prompt := "A hose adds 4/5 gal in 2/5 minute. Gallons per minute?", Choices := array{"2", "1/2", "8/25", "1"}, Answer := 0, Feedback := array{"", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "Check your arithmetic."}, Explanation := "4/5 ÷ 2/5 = 4/5 × 5/2 = 20/10 = 2 gallons per minute."},
        fnm_item{Id := "proportional-relationships/t1/012", Tier := 1, Prompt := "Wire A is 2/5 yd, wire B is 1/5 yd. A is how many times B?", Choices := array{"2/25", "1/2", "2", "1/5"}, Answer := 2, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract."}, Explanation := "2/5 ÷ 1/5 = 2/5 × 5 = 10/5 = 2 times as long."},
        fnm_item{Id := "proportional-relationships/t1/013", Tier := 1, Prompt := "A hiker walks 3/10 mile in 1/10 hour. Miles per hour?", Choices := array{"3/100", "1", "3", "1/3"}, Answer := 2, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "Check your arithmetic.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount."}, Explanation := "3/10 ÷ 1/10 = 3/10 × 10 = 30/10 = 3 miles per hour."},
        fnm_item{Id := "proportional-relationships/t1/014", Tier := 1, Prompt := "A painter covers 3/10 wall in 1/2 hour. Walls per hour?", Choices := array{"1 2/3", "3/5", "3/20", "3"}, Answer := 1, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour."}, Explanation := "3/10 ÷ 1/2 = 3/10 × 2 = 6/10 = 3/5 walls per hour."},
        fnm_item{Id := "proportional-relationships/t1/015", Tier := 1, Prompt := "7/8 lb of grapes costs $7. Cost per lb?", Choices := array{"$8", "$1/8", "$6 1/8", "$1"}, Answer := 0, Feedback := array{"", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour."}, Explanation := "$7 ÷ 7/8 = $7 × 8/7 = $8 per lb."},
        fnm_item{Id := "proportional-relationships/t1/016", Tier := 1, Prompt := "Tube A is 3/4 yd, tube B is 1/2 yd. A is how many times B?", Choices := array{"1/4", "3", "3/8", "1 1/2"}, Answer := 3, Feedback := array{"A rate, or \'how many times\', is a quotient. Divide; don\'t subtract.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", ""}, Explanation := "3/4 ÷ 1/2 = 3/4 × 2 = 6/4 = 1 1/2 times as long."},
        fnm_item{Id := "proportional-relationships/t1/017", Tier := 1, Prompt := "Rope A is 5/6 ft, rope B is 1/3 ft. A is how many times B?", Choices := array{"2/5", "5", "2 1/2", "1/2"}, Answer := 2, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract."}, Explanation := "5/6 ÷ 1/3 = 5/6 × 3 = 15/6 = 2 1/2 times as long."},
        fnm_item{Id := "proportional-relationships/t1/018", Tier := 1, Prompt := "7/8 yd of yarn makes 1/8 scarf. Yards for 1 scarf?", Choices := array{"7/64", "7", "1/7", "9"}, Answer := 1, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Check your arithmetic."}, Explanation := "7/8 ÷ 1/8 = 7/8 × 8 = 56/8 = 7 yards per scarf."},
        fnm_item{Id := "proportional-relationships/t1/019", Tier := 1, Prompt := "3/10 cup of flour makes 1/10 batch. Cups for 1 batch?", Choices := array{"3", "1", "1/3", "3/100"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "3/10 ÷ 1/10 = 3/10 × 10 = 30/10 = 3 cups per batch."},
        fnm_item{Id := "proportional-relationships/t1/020", Tier := 1, Prompt := "1/2 lb of cheese costs $5. Cost per lb?", Choices := array{"$1/10", "$2 1/2", "$5", "$10"}, Answer := 3, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", ""}, Explanation := "$5 ÷ 1/2 = $5 × 2 = $10 per lb."},
        fnm_item{Id := "proportional-relationships/t1/021", Tier := 1, Prompt := "2/3 gal of paint covers 1/6 wall. Gallons for 1 wall?", Choices := array{"9", "1/9", "1/4", "4"}, Answer := 3, Feedback := array{"Flip only the second fraction, then multiply. Not both.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", ""}, Explanation := "2/3 ÷ 1/6 = 2/3 × 6 = 12/3 = 4 gallons per wall."},
        fnm_item{Id := "proportional-relationships/t1/022", Tier := 1, Prompt := "1/2 ft of wood builds 1/8 shelf. Feet for 1 shelf?", Choices := array{"16", "4", "1/4", "1/16"}, Answer := 1, Feedback := array{"Flip only the second fraction, then multiply. Not both.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "1/2 ÷ 1/8 = 1/2 × 8 = 8/2 = 4 feet per shelf."},
        fnm_item{Id := "proportional-relationships/t1/023", Tier := 1, Prompt := "1/3 lb of nuts costs $3. Cost per lb?", Choices := array{"$1", "$3", "$9", "$1/9"}, Answer := 2, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount."}, Explanation := "$3 ÷ 1/3 = $3 × 3 = $9 per lb."},
        fnm_item{Id := "proportional-relationships/t1/024", Tier := 1, Prompt := "Bar A is 1/2 ft, bar B is 3/10 ft. A is how many times B?", Choices := array{"1/3", "1/5", "3/20", "1 2/3"}, Answer := 3, Feedback := array{"The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", ""}, Explanation := "1/2 ÷ 3/10 = 1/2 × 10/3 = 10/6 = 1 2/3 times as long."},
        fnm_item{Id := "proportional-relationships/t1/025", Tier := 1, Prompt := "7/8 yd of yarn makes 1/2 scarf. Yards for 1 scarf?", Choices := array{"7/16", "1 3/4", "4/7", "7"}, Answer := 1, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour."}, Explanation := "7/8 ÷ 1/2 = 7/8 × 2 = 14/8 = 1 3/4 yards per scarf."},
        fnm_item{Id := "proportional-relationships/t1/026", Tier := 1, Prompt := "1/2 lb of grapes costs $3. Cost per lb?", Choices := array{"$1 1/2", "$6", "$1/6", "$3"}, Answer := 1, Feedback := array{"Per 1 means divide. Dividing by a fraction makes the answer bigger.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour."}, Explanation := "$3 ÷ 1/2 = $3 × 2 = $6 per lb."},
        fnm_item{Id := "proportional-relationships/t1/027", Tier := 1, Prompt := "A hiker walks 5/6 mile in 1/6 hour. Miles per hour?", Choices := array{"5", "1/5", "7 1/5", "5/36"}, Answer := 0, Feedback := array{"", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Flip only the second fraction, then multiply. Not both.", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "5/6 ÷ 1/6 = 5/6 × 6 = 30/6 = 5 miles per hour."},
        fnm_item{Id := "proportional-relationships/t1/028", Tier := 1, Prompt := "7/8 gal of paint covers 3/8 wall. Gallons for 1 wall?", Choices := array{"1 1/3", "21/64", "3/7", "2 1/3"}, Answer := 3, Feedback := array{"Check your arithmetic.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", ""}, Explanation := "7/8 ÷ 3/8 = 7/8 × 8/3 = 56/24 = 2 1/3 gallons per wall."},
        fnm_item{Id := "proportional-relationships/t1/029", Tier := 1, Prompt := "3/5 lb of nuts costs $3. Cost per lb?", Choices := array{"$5", "$1/5", "$1 4/5", "$1"}, Answer := 0, Feedback := array{"", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour."}, Explanation := "$3 ÷ 3/5 = $3 × 5/3 = $5 per lb."},
        fnm_item{Id := "proportional-relationships/t1/030", Tier := 1, Prompt := "Wire A is 2/5 yd, wire B is 1/10 yd. A is how many times B?", Choices := array{"1/4", "2", "3/10", "4"}, Answer := 3, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract.", ""}, Explanation := "2/5 ÷ 1/10 = 2/5 × 10 = 20/5 = 4 times as long."},
        fnm_item{Id := "proportional-relationships/t1/031", Tier := 1, Prompt := "A snail crawls 1/2 ft in 1/4 minute. Feet per minute?", Choices := array{"2", "8", "1", "1/8"}, Answer := 0, Feedback := array{"", "Flip only the second fraction, then multiply. Not both.", "The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "1/2 ÷ 1/4 = 1/2 × 4 = 4/2 = 2 feet per minute."},
        fnm_item{Id := "proportional-relationships/t1/032", Tier := 1, Prompt := "A painter covers 1/2 wall in 1/4 hour. Walls per hour?", Choices := array{"1", "1/2", "2", "1/8"}, Answer := 2, Feedback := array{"The bottoms count: 1/4 hour is a quarter of an hour, not 1 hour.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "1/2 ÷ 1/4 = 1/2 × 4 = 4/2 = 2 walls per hour."},
