    Tiers := array{
        fnm_tier{Tier := 1, Name := "Ratio Language", Description := "Write a ratio in the order asked: part to part, part to whole."},
        fnm_tier{Tier := 2, Name := "Equivalent Ratios", Description := "Scale both terms by the same number to fill the gap."},
        fnm_tier{Tier := 3, Name := "Unit Rates \& Units", Description := "Find the rate for 1, and convert units with a rate."},
        fnm_tier{Tier := 4, Name := "Percent of a Number", Description := "Find 10%, 25%, 50%, 75% and tens of percent of a whole."},
        fnm_tier{Tier := 5, Name := "Parts, Wholes \& Rates", Description := "Two steps: share a total by a ratio, find a whole from a percent, scale a price."}
    },
    Items := array{
        fnm_item{Id := "ratios-rates/t1/001", Tier := 1, Prompt := "10 pets: 3 are cats, the rest dogs. Ratio of cats to dogs?", Choices := array{"7:3", "3:10", "7:10", "3:7"}, Answer := 3, Feedback := array{"Order matters: write the first thing named first.", "Take the known group away from the total first to get the other group.", "It asks part to part. Compare the two groups, not a group to the total.", ""}, Explanation := "Dogs: 10 − 3 = 7. Cats to dogs is 3:7."},
        fnm_item{Id := "ratios-rates/t1/002", Tier := 1, Prompt := "9 hawks and 3 owls. Ratio of owls to hawks?", Choices := array{"3:12", "3:9", "9:3", "9:12"}, Answer := 1, Feedback := array{"It asks part to part. Compare the two groups, not a group to the total.", "", "Order matters: write the first thing named first.", "It asks part to part. Compare the two groups, not a group to the total."}, Explanation := "Owls first, then hawks: 3 to 9 is 3:9."},
        fnm_item{Id := "ratios-rates/t1/003", Tier := 1, Prompt := "16 kids: 7 are boys, the rest girls. Ratio of girls to boys?", Choices := array{"9:7", "9:16", "16:7", "7:9"}, Answer := 0, Feedback := array{"", "It asks part to part. Compare the two groups, not a group to the total.", "Take the known group away from the total first to get the other group.", "Order matters: write the first thing named first."}, Explanation := "Girls: 16 − 7 = 9. Girls to boys is 9:7."},
