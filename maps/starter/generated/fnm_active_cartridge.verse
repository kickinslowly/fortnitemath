        fnm_item{Id := "fraction-division/t5/038", Tier := 5, Prompt := "1/2 cup of flour, 1/3 cup per batch. How many batches?", Choices := array{"1/6", "1 1/2", "2/3", "6"}, Answer := 1, Feedback := array{"You multiplied as is. To divide, multiply by the flipped divisor.", "", "Backwards: start with the amount you have, then divide it.", "Flip only the second fraction. The first one stays as it is."}, Explanation := "Groups of 1/3 in 1/2: 1/2 ÷ 1/3 = 1/2 × 3 = 3/2 = 1 1/2."},
