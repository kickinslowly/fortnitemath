    },
    Items := array{
        fnm_item{Id := "rational-numbers/t1/001", Tier := 1, Prompt := "Start at −1 and move 8 right. Where are you?", Choices := array{"−9", "7", "8", "6"}, Answer := 1, Feedback := array{"Right means bigger numbers. Left means smaller numbers.", "", "Start at the starting number, not at 0, then count the move.", "Count the jumps between tick marks, not the tick marks themselves."}, Explanation := "Right means bigger: −1 + 8 = 7."},
