        fnm_item{Id := "factors-multiples/t5/001", Tier := 5, Prompt := "60 red, 70 blue beads. Most identical bags, none left?", Choices := array{"5", "10", "60", "420"}, Answer := 1, Feedback := array{"That\'s a common factor, but not the greatest. Look for a bigger one.", "", "The smaller number must divide the bigger one to be the GCF. It doesn\'t.", "Sharing into equal groups: GCF. Matching up or meeting again: LCM."}, Explanation := "Equal sharing needs a common factor of 60 and 70. 60 = 10 × 6, 70 = 10 × 7: GCF 10."},
