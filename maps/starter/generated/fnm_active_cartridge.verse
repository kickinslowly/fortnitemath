        fnm_item{Id := "circles/t1/035", Tier := 1, Prompt := "Circle: diameter 6. Radius?", Choices := array{"3", "1.5", "12", "6"}, Answer := 0, Feedback := array{"", "Halve just once: the radius is half the diameter.", "Radius is half the diameter: it only goes to the center.", "Radius and diameter are different: the diameter is twice the radius."}, Explanation := "Radius = diameter ÷ 2: 6 ÷ 2 = 3."},
        fnm_item{Id := "circles/t1/036", Tier := 1, Prompt := "A string around a circle is about how many radii?", Choices := array{"6", "8", "12", "3"}, Answer := 0, Feedback := array{"", "A square around it is longer. A circle is about 3 diameters, 6 radii.", "Check your arithmetic.", "Those are diameters. A diameter is 2 radii: about 6 radii."}, Explanation := "About 3 diameters, and each diameter is 2 radii: 3 × 2 = 6 radii."},
        fnm_item{Id := "circles/t1/037", Tier := 1, Prompt := "Circle: radius 2. Diameter?", Choices := array{"1", "2", "4", "4π"}, Answer := 2, Feedback := array{"Diameter is twice the radius: it goes all the way across.", "Radius and diameter are different: the diameter is twice the radius.", "", "Diameter is straight across. The distance around needs π."}, Explanation := "Diameter = 2 × radius: 2 × 2 = 4."},
        fnm_item{Id := "circles/t1/038", Tier := 1, Prompt := "Circle: diameter 8. Radius?", Choices := array{"2", "4", "8", "16"}, Answer := 1, Feedback := array{"Halve just once: the radius is half the diameter.", "", "Radius and diameter are different: the diameter is twice the radius.", "Radius is half the diameter: it only goes to the center."}, Explanation := "Radius = diameter ÷ 2: 8 ÷ 2 = 4."},
