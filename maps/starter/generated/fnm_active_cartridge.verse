        fnm_item{Id := "equations-inequalities/t5/026", Tier := 5, Prompt := "At most 10 kids, k, fit in the van. Which fits?", Choices := array{"k \< 10", "k ≤ 10", "k ≥ 10", "k \> 10"}, Answer := 1, Feedback := array{"At least / at most include the number (≥ ≤). More / fewer than do not.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "10 or less: k ≤ 10. 10 itself counts, so the line goes under the sign."},
