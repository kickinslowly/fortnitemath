        fnm_item{Id := "rational-ops/t3/003", Tier := 3, Prompt := "−0.4 × 9", Choices := array{"−3.6", "−0.36", "8.6", "3.6"}, Answer := 0, Feedback := array{"", "Do the digits, then put the decimal point back by counting places.", "× means groups of, not +. Multiply the two numbers.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "One negative, so negative. Digits: 4 × 9 = 36; 1 decimal place in all, so −3.6."},
