FnmCartridge_fraction_division():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "fraction-division",
    Version := "1.0.0",
    Title := "Dividing Fractions",
    Subtitle := "How Many Groups?",
    Grade := "6",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Whole ÷ Unit Fraction", Description := "How many 1/3s fit in 4? Each whole holds 3 of them."},
        fnm_tier{Tier := 2, Name := "Fraction ÷ Whole", Description := "Split a fraction into equal parts: the answer gets smaller."},
        fnm_tier{Tier := 3, Name := "Same Denominators", Description := "Same-size pieces: divide the numerators."},
        fnm_tier{Tier := 4, Name := "Any Two Fractions", Description := "Multiply by the reciprocal of the divisor."},
        fnm_tier{Tier := 5, Name := "Story Problems", Description := "How many groups, how much per share, or a missing side."}
    },
    Items := array{
        fnm_item{Id := "fraction-division/t1/001", Tier := 1, Prompt := "How many 1/9s are in 9?", Choices := array{"72", "1/81", "81", "1"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Upside down: that is the second number ÷ the first. Keep the order.", "", "Count the pieces: each whole holds as many as the denominator. Multiply."}, Explanation := "Each whole holds 9 pieces of size 1/9, so 9 ÷ 1/9 = 9 × 9 = 81."},
        fnm_item{Id := "fraction-division/t1/002", Tier := 1, Prompt := "How many 1/5s are in 4?", Choices := array{"1/20", "4/5", "25", "20"}, Answer := 3, Feedback := array{"Upside down: that is the second number ÷ the first. Keep the order.", "Count the pieces: each whole holds as many as the denominator. Multiply.", "Check your arithmetic.", ""}, Explanation := "Each whole holds 5 pieces of size 1/5, so 4 ÷ 1/5 = 4 × 5 = 20."},
        fnm_item{Id := "fraction-division/t1/003", Tier := 1, Prompt := "How many 1/8s are in 5?", Choices := array{"40", "1/40", "48", "5/8"}, Answer := 0, Feedback := array{"", "Upside down: that is the second number ÷ the first. Keep the order.", "Check your arithmetic.", "Count the pieces: each whole holds as many as the denominator. Multiply."}, Explanation := "Each whole holds 8 pieces of size 1/8, so 5 ÷ 1/8 = 5 × 8 = 40."},
