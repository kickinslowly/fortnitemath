        fnm_item{Id := "fraction-division/t5/014", Tier := 5, Prompt := "How many 1/3 mi laps make a 5/6 mi run?", Choices := array{"3 3/5", "5/18", "2/5", "2 1/2"}, Answer := 3, Feedback := array{"Flip only the second fraction. The first one stays as it is.", "You multiplied as is. To divide, multiply by the flipped divisor.", "Backwards: start with the amount you have, then divide it.", ""}, Explanation := "Groups of 1/3 in 5/6: 5/6 ÷ 1/3 = 5/6 × 3 = 15/6 = 2 1/2."},
        fnm_item{Id := "fraction-division/t5/015", Tier := 5, Prompt := "6 friends split 2/3 of a pizza equally. How much each?", Choices := array{"1/9", "4", "9", "1 1/9"}, Answer := 0, Feedback := array{"", "Dividing by a whole number makes it smaller: split it into that many parts.", "Backwards: start with the amount you have, then divide it.", "Check your arithmetic."}, Explanation := "Share 2/3 into 6 parts: 2/3 ÷ 6 = 2/3 × 1/6 = 2/18 = 1/9."},
        fnm_item{Id := "fraction-division/t5/016", Tier := 5, Prompt := "2/3 gal of paint covers 2 walls equally. Gal per wall?", Choices := array{"1 1/3 gal", "1/3 gal", "3 gal", "1/4 gal"}, Answer := 1, Feedback := array{"Dividing by a whole number makes it smaller: split it into that many parts.", "", "Backwards: start with the amount you have, then divide it.", "Check your arithmetic."}, Explanation := "Share 2/3 into 2 parts: 2/3 ÷ 2 = 2/3 × 1/2 = 2/6 = 1/3 gal."},
        fnm_item{Id := "fraction-division/t5/017", Tier := 5, Prompt := "How many 1/3 mi laps make a 1/2 mi run?", Choices := array{"6", "2/3", "1/6", "1 1/2"}, Answer := 3, Feedback := array{"Flip only the second fraction. The first one stays as it is.", "Backwards: start with the amount you have, then divide it.", "You multiplied as is. To divide, multiply by the flipped divisor.", ""}, Explanation := "Groups of 1/3 in 1/2: 1/2 ÷ 1/3 = 1/2 × 3 = 3/2 = 1 1/2."},
        fnm_item{Id := "fraction-division/t5/018", Tier := 5, Prompt := "2 cups of rice, 1/8 cup per bowl. How many bowls?", Choices := array{"18", "1/16", "16", "1/4"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Backwards: start with the amount you have, then divide it.", "", "Count the pieces: each whole holds as many as the denominator. Multiply."}, Explanation := "Groups of 1/8 in 2: 2 ÷ 1/8 = 2 × 8 = 16."},
        fnm_item{Id := "fraction-division/t5/019", Tier := 5, Prompt := "10 cups of rice, 1/2 cup per bowl. How many bowls?", Choices := array{"19", "20", "5", "1/20"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Count the pieces: each whole holds as many as the denominator. Multiply.", "Backwards: start with the amount you have, then divide it."}, Explanation := "Groups of 1/2 in 10: 10 ÷ 1/2 = 10 × 2 = 20."},
        fnm_item{Id := "fraction-division/t5/020", Tier := 5, Prompt := "1/2 lb of fudge shared equally by 3 kids. Lb each?", Choices := array{"1 1/2 lb", "1 1/6 lb", "1/6 lb", "6 lb"}, Answer := 2, Feedback := array{"Dividing by a whole number makes it smaller: split it into that many parts.", "Check your arithmetic.", "", "Backwards: start with the amount you have, then divide it."}, Explanation := "Share 1/2 into 3 parts: 1/2 ÷ 3 = 1/2 × 1/3 = 1/6 lb."},
        fnm_item{Id := "fraction-division/t5/021", Tier := 5, Prompt := "2 friends split 1/4 of a pizza equally. How much each?", Choices := array{"1/8", "1 1/8", "8", "1/2"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Backwards: start with the amount you have, then divide it.", "Dividing by a whole number makes it smaller: split it into that many parts."}, Explanation := "Share 1/4 into 2 parts: 1/4 ÷ 2 = 1/4 × 1/2 = 1/8."},
        fnm_item{Id := "fraction-division/t5/022", Tier := 5, Prompt := "1/2 lb of fudge shared equally by 6 kids. Lb each?", Choices := array{"12 lb", "1/12 lb", "3 lb", "1 1/12 lb"}, Answer := 1, Feedback := array{"Backwards: start with the amount you have, then divide it.", "", "Dividing by a whole number makes it smaller: split it into that many parts.", "Check your arithmetic."}, Explanation := "Share 1/2 into 6 parts: 1/2 ÷ 6 = 1/2 × 1/6 = 1/12 lb."},
        fnm_item{Id := "fraction-division/t5/023", Tier := 5, Prompt := "How many 1/2 mi laps make a 3/4 mi run?", Choices := array{"2 2/3", "1 1/2", "2/3", "3/8"}, Answer := 1, Feedback := array{"Flip only the second fraction. The first one stays as it is.", "", "Backwards: start with the amount you have, then divide it.", "You multiplied as is. To divide, multiply by the flipped divisor."}, Explanation := "Groups of 1/2 in 3/4: 3/4 ÷ 1/2 = 3/4 × 2 = 6/4 = 1 1/2."},
