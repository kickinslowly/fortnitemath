        fnm_item{Id := "fraction-division/t5/025", Tier := 5, Prompt := "How many 1/8 mi laps make a 3/4 mi run?", Choices := array{"3/32", "6", "1/6", "10 2/3"}, Answer := 1, Feedback := array{"You multiplied as is. To divide, multiply by the flipped divisor.", "", "Backwards: start with the amount you have, then divide it.", "Flip only the second fraction. The first one stays as it is."}, Explanation := "Groups of 1/8 in 3/4: 3/4 ÷ 1/8 = 3/4 × 8 = 24/4 = 6."},
        fnm_item{Id := "fraction-division/t5/026", Tier := 5, Prompt := "1/2 cup of flour, 1/4 cup per batch. How many batches?", Choices := array{"2", "1/8", "1/2", "8"}, Answer := 0, Feedback := array{"", "You multiplied as is. To divide, multiply by the flipped divisor.", "Backwards: start with the amount you have, then divide it.", "Flip only the second fraction. The first one stays as it is."}, Explanation := "Groups of 1/4 in 1/2: 1/2 ÷ 1/4 = 1/2 × 4 = 4/2 = 2."},
        fnm_item{Id := "fraction-division/t5/027", Tier := 5, Prompt := "2/3 of a bag of dog food weighs 3 lb. Whole bag?", Choices := array{"4 1/2 lb", "2 lb", "9 lb", "2/9 lb"}, Answer := 0, Feedback := array{"", "You multiplied as is. To divide, multiply by the flipped divisor.", "Flip the whole divisor: ÷ 3/4 means × 4/3, not just × 4.", "Backwards: start with the amount you have, then divide it."}, Explanation := "2/3 of the bag is 3 lb, so whole = 3 ÷ 2/3 = 3 × 3/2 = 9/2 = 4 1/2 lb."},
        fnm_item{Id := "fraction-division/t5/028", Tier := 5, Prompt := "Rectangle: area 1/4 sq ft, width 1/2 ft. Length?", Choices := array{"1/2 ft", "2 ft", "8 ft", "1/8 ft"}, Answer := 0, Feedback := array{"", "Backwards: start with the amount you have, then divide it.", "Flip only the second fraction. The first one stays as it is.", "You multiplied as is. To divide, multiply by the flipped divisor."}, Explanation := "Length = area ÷ width: 1/4 ÷ 1/2 = 1/4 × 2 = 2/4 = 1/2 ft."},
        fnm_item{Id := "fraction-division/t5/029", Tier := 5, Prompt := "Rectangle: area 7 sq ft, width 1/2 ft. Length?", Choices := array{"1/14 ft", "3 1/2 ft", "13 ft", "14 ft"}, Answer := 3, Feedback := array{"Backwards: start with the amount you have, then divide it.", "Count the pieces: each whole holds as many as the denominator. Multiply.", "Check your arithmetic.", ""}, Explanation := "Length = area ÷ width: 7 ÷ 1/2 = 7 × 2 = 14 ft."},
        fnm_item{Id := "fraction-division/t5/030", Tier := 5, Prompt := "4 lb of trail mix split into 1/4 lb bags. How many bags?", Choices := array{"17", "16", "1", "1/16"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Count the pieces: each whole holds as many as the denominator. Multiply.", "Backwards: start with the amount you have, then divide it."}, Explanation := "Groups of 1/4 in 4: 4 ÷ 1/4 = 4 × 4 = 16."},
        fnm_item{Id := "fraction-division/t5/031", Tier := 5, Prompt := "3/8 of a bag of dog food weighs 6 lb. Whole bag?", Choices := array{"1/16 lb", "16 lb", "2 1/4 lb", "48 lb"}, Answer := 1, Feedback := array{"Backwards: start with the amount you have, then divide it.", "", "You multiplied as is. To divide, multiply by the flipped divisor.", "Flip the whole divisor: ÷ 3/4 means × 4/3, not just × 4."}, Explanation := "3/8 of the bag is 6 lb, so whole = 6 ÷ 3/8 = 6 × 8/3 = 48/3 = 16 lb."},
        fnm_item{Id := "fraction-division/t5/032", Tier := 5, Prompt := "5/6 cup of flour, 1/3 cup per batch. How many batches?", Choices := array{"2/5", "5/18", "2 1/2", "3 3/5"}, Answer := 2, Feedback := array{"Backwards: start with the amount you have, then divide it.", "You multiplied as is. To divide, multiply by the flipped divisor.", "", "Flip only the second fraction. The first one stays as it is."}, Explanation := "Groups of 1/3 in 5/6: 5/6 ÷ 1/3 = 5/6 × 3 = 15/6 = 2 1/2."},
