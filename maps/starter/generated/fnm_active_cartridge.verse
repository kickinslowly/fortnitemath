        fnm_item{Id := "fraction-division/t5/001", Tier := 5, Prompt := "Rectangle: area 4 sq ft, width 1/2 ft. Length?", Choices := array{"6 ft", "8 ft", "2 ft", "1/8 ft"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Count the pieces: each whole holds as many as the denominator. Multiply.", "Backwards: start with the amount you have, then divide it."}, Explanation := "Length = area ÷ width: 4 ÷ 1/2 = 4 × 2 = 8 ft."},
        fnm_item{Id := "fraction-division/t5/002", Tier := 5, Prompt := "8 hours of practice, 1/2 hour per drill. How many drills?", Choices := array{"4", "14", "16", "1/16"}, Answer := 2, Feedback := array{"Count the pieces: each whole holds as many as the denominator. Multiply.", "Check your arithmetic.", "", "Backwards: start with the amount you have, then divide it."}, Explanation := "Groups of 1/2 in 8: 8 ÷ 1/2 = 8 × 2 = 16."},
        fnm_item{Id := "fraction-division/t5/003", Tier := 5, Prompt := "Rectangle: area 3 sq ft, width 1/3 ft. Length?", Choices := array{"9 ft", "10 ft", "1 ft", "1/9 ft"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Count the pieces: each whole holds as many as the denominator. Multiply.", "Backwards: start with the amount you have, then divide it."}, Explanation := "Length = area ÷ width: 3 ÷ 1/3 = 3 × 3 = 9 ft."},
        fnm_item{Id := "fraction-division/t5/004", Tier := 5, Prompt := "3/4 cup of flour, 1/2 cup per batch. How many batches?", Choices := array{"3/8", "2 2/3", "1 1/2", "2/3"}, Answer := 2, Feedback := array{"You multiplied as is. To divide, multiply by the flipped divisor.", "Flip only the second fraction. The first one stays as it is.", "", "Backwards: start with the amount you have, then divide it."}, Explanation := "Groups of 1/2 in 3/4: 3/4 ÷ 1/2 = 3/4 × 2 = 6/4 = 1 1/2."},
        fnm_item{Id := "fraction-division/t5/005", Tier := 5, Prompt := "9 cups of rice, 1/2 cup per bowl. How many bowls?", Choices := array{"4 1/2", "20", "1/18", "18"}, Answer := 3, Feedback := array{"Count the pieces: each whole holds as many as the denominator. Multiply.", "Check your arithmetic.", "Backwards: start with the amount you have, then divide it.", ""}, Explanation := "Groups of 1/2 in 9: 9 ÷ 1/2 = 9 × 2 = 18."},
        fnm_item{Id := "fraction-division/t5/006", Tier := 5, Prompt := "5 friends split 1/2 of a pizza equally. How much each?", Choices := array{"1/11", "2 1/2", "1/10", "10"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Dividing by a whole number makes it smaller: split it into that many parts.", "", "Backwards: start with the amount you have, then divide it."}, Explanation := "Share 1/2 into 5 parts: 1/2 ÷ 5 = 1/2 × 1/5 = 1/10."},
        fnm_item{Id := "fraction-division/t5/007", Tier := 5, Prompt := "8 lb of trail mix split into 2/3 lb bags. How many bags?", Choices := array{"12", "5 1/3", "1/12", "24"}, Answer := 0, Feedback := array{"", "You multiplied as is. To divide, multiply by the flipped divisor.", "Backwards: start with the amount you have, then divide it.", "Flip the whole divisor: ÷ 3/4 means × 4/3, not just × 4."}, Explanation := "Groups of 2/3 in 8: 8 ÷ 2/3 = 8 × 3/2 = 24/2 = 12."},
