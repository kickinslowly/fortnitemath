        fnm_item{Id := "equations-inequalities/t5/001", Tier := 5, Prompt := "Which is a solution of m ≤ 16?", Choices := array{"18", "19", "17", "15"}, Answer := 3, Feedback := array{"Plug it in: the statement comes out false. Pick from the other side.", "Plug it in: the statement comes out false. Pick from the other side.", "Plug it in: the statement comes out false. Pick from the other side.", ""}, Explanation := "Try 15: 15 ≤ 16 is true."},
        fnm_item{Id := "equations-inequalities/t5/002", Tier := 5, Prompt := "At most 19 guests, g, can come. Which fits?", Choices := array{"g \> 19", "g ≤ 19", "g ≥ 19", "g \< 19"}, Answer := 1, Feedback := array{"Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "At least / at most include the number (≥ ≤). More / fewer than do not."}, Explanation := "19 or less: g ≤ 19. 19 itself counts, so the line goes under the sign."},
        fnm_item{Id := "equations-inequalities/t5/003", Tier := 5, Prompt := "The trip took over 9 days, d. Which fits?", Choices := array{"d ≤ 9", "d \> 9", "d \< 9", "d ≥ 9"}, Answer := 1, Feedback := array{"Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "At least / at most include the number (≥ ≤). More / fewer than do not."}, Explanation := "More than 9: d \> 9. 9 itself does not count, so no line under the sign."},
