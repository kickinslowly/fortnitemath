FnmCartridge_percent_problems():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "percent-problems",
    Version := "1.0.0",
    Title := "Percent Problems",
    Subtitle := "Tax, Tips, Discounts \& Percent Change",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Tax \& Tip", Description := "Find the tip or tax, then add it on to get the total."},
        fnm_tier{Tier := 2, Name := "Discounts", Description := "Find the discount, then take it off to get the sale price."},
        fnm_tier{Tier := 3, Name := "Markup \& Interest", Description := "Markups add to a price. Simple interest repeats every year."},
        fnm_tier{Tier := 4, Name := "Percent Change", Description := "Find the percent increase or decrease from the original value."},
        fnm_tier{Tier := 5, Name := "Error \& Two Steps", Description := "Percent error, and two percents one after the other."}
    },
    Items := array{
        fnm_item{Id := "percent-problems/t1/001", Tier := 1, Prompt := "$40 meal plus a 25% tip. Total?", Choices := array{"$10", "$44", "$65", "$50"}, Answer := 3, Feedback := array{"That is only the extra amount. Add it to the price to get the total.", "Only 10% is 1/10 of the price. Find 10% first, then scale to the percent.", "The % number is not dollars. Find that percent OF the price first.", ""}, Explanation := "25% is 1/4 of $40: $10. $40 + $10 = $50."},
        fnm_item{Id := "percent-problems/t1/002", Tier := 1, Prompt := "The $8 bill gets a 25% tip. Total paid?", Choices := array{"$2", "$6", "$33", "$10"}, Answer := 3, Feedback := array{"That is only the extra amount. Add it to the price to get the total.", "Tax, tips and markups add to the price. They do not take away.", "The % number is not dollars. Find that percent OF the price first.", ""}, Explanation := "25% is 1/4 of $8: $2. $8 + $2 = $10."},
        fnm_item{Id := "percent-problems/t1/003", Tier := 1, Prompt := "The $20 game has 20% tax. Tax in dollars?", Choices := array{"$24", "$2", "$4", "$20"}, Answer := 2, Feedback := array{"That is the total. The question asks only for the extra amount.", "Only 10% is 1/10 of the price. Find 10% first, then scale to the percent.", "", "The % number is not dollars. Find that percent OF the price first."}, Explanation := "10% of $20 is $2, so 20% is $4."},
        fnm_item{Id := "percent-problems/t1/004", Tier := 1, Prompt := "The $70 game has 20% tax. Tax in dollars?", Choices := array{"$84", "$14", "$20", "$7"}, Answer := 1, Feedback := array{"That is the total. The question asks only for the extra amount.", "", "The % number is not dollars. Find that percent OF the price first.", "Only 10% is 1/10 of the price. Find 10% first, then scale to the percent."}, Explanation := "10% of $70 is $7, so 20% is $14."},
