FnmCartridge_probability():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "probability",
    Version := "1.0.0",
    Title := "Probability",
    Subtitle := "Chance, Outcomes \& Compound Events",
    Grade := "7",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "How Likely?", Description := "Place chances on the 0 to 1 scale, from impossible to certain."},
        fnm_tier{Tier := 2, Name := "Simple Probability", Description := "Favorable outcomes over all outcomes, in simplest form."},
        fnm_tier{Tier := 3, Name := "Complement \& Predict", Description := "The chance of not, expected counts, and predicting from a sample."},
        fnm_tier{Tier := 4, Name := "Sample Spaces", Description := "Count the outcomes of two- and three-stage events."},
        fnm_tier{Tier := 5, Name := "Compound Events", Description := "The chance of two or more events happening together."}
    },
    Items := array{
        fnm_item{Id := "probability/t1/001", Tier := 1, Prompt := "P(event) = 9/10. How likely is the event?", Choices := array{"Unlikely", "Certain", "Likely", "Equally likely"}, Answer := 2, Feedback := array{"Closer to 1 means MORE likely. 0 is impossible, 1 is certain.", "Certain means exactly 1 and impossible exactly 0. Close is just likely.", "", "Only 1/2 is equally likely. Near 1 is likely, near 0 is unlikely."}, Explanation := "9/10 is well over half, near 1, so the event is likely."},
        fnm_item{Id := "probability/t1/002", Tier := 1, Prompt := "Roll a die. Get a 7. How likely?", Choices := array{"Likely", "Equally likely", "Impossible", "Certain"}, Answer := 2, Feedback := array{"0 is impossible, 1 is certain, 1/2 is the middle. Place the number first.", "Only 1/2 is equally likely. Near 1 is likely, near 0 is unlikely.", "", "Closer to 1 means MORE likely. 0 is impossible, 1 is certain."}, Explanation := "P = 0, exactly 0: impossible."},
        fnm_item{Id := "probability/t1/003", Tier := 1, Prompt := "Bag: 7 red, 1 blue. Pick red. How likely?", Choices := array{"Likely", "Unlikely", "Equally likely", "Certain"}, Answer := 0, Feedback := array{"", "Closer to 1 means MORE likely. 0 is impossible, 1 is certain.", "Only 1/2 is equally likely. Near 1 is likely, near 0 is unlikely.", "Certain means exactly 1 and impossible exactly 0. Close is just likely."}, Explanation := "P = 7/8, well over half: likely."},
        fnm_item{Id := "probability/t1/004", Tier := 1, Prompt := "Which can\'t be the chance of a goal?", Choices := array{"1", "0.25", "0.1", "−0.5"}, Answer := 3, Feedback := array{"0 and 1 ARE probabilities: impossible and certain events.", "A probability is 0 to 1 (0% to 100%). Look for the one outside that.", "A probability is 0 to 1 (0% to 100%). Look for the one outside that.", ""}, Explanation := "−0.5 is less than 0, and a probability is from 0 to 1. It can\'t be −0.5."},
        fnm_item{Id := "probability/t1/005", Tier := 1, Prompt := "A 20% chance means the event is?", Choices := array{"Equally likely", "Likely", "Unlikely", "Impossible"}, Answer := 2, Feedback := array{"Only 1/2 is equally likely. Near 1 is likely, near 0 is unlikely.", "Closer to 1 means MORE likely. 0 is impossible, 1 is certain.", "", "Certain means exactly 1 and impossible exactly 0. Close is just likely."}, Explanation := "20% is well under half, near 0, so the event is unlikely."},
        fnm_item{Id := "probability/t1/006", Tier := 1, Prompt := "A probability of 0.2 means the event is?", Choices := array{"Likely", "Unlikely", "Impossible", "Equally likely"}, Answer := 1, Feedback := array{"Closer to 1 means MORE likely. 0 is impossible, 1 is certain.", "", "Certain means exactly 1 and impossible exactly 0. Close is just likely.", "Only 1/2 is equally likely. Near 1 is likely, near 0 is unlikely."}, Explanation := "0.2 is well under half, near 0, so the event is unlikely."},
        fnm_item{Id := "probability/t1/007", Tier := 1, Prompt := "P(event) = 1/10. How likely is the event?", Choices := array{"Impossible", "Equally likely", "Likely", "Unlikely"}, Answer := 3, Feedback := array{"Certain means exactly 1 and impossible exactly 0. Close is just likely.", "Only 1/2 is equally likely. Near 1 is likely, near 0 is unlikely.", "Closer to 1 means MORE likely. 0 is impossible, 1 is certain.", ""}, Explanation := "1/10 is well under half, near 0, so the event is unlikely."},
        fnm_item{Id := "probability/t1/008", Tier := 1, Prompt := "As a decimal, the least a probability can be?", Choices := array{"0", "−1", "No limit", "1"}, Answer := 0, Feedback := array{"", "A probability is never below 0. Impossible is 0, the lowest it goes.", "A probability is never below 0. Impossible is 0, the lowest it goes.", "Closer to 1 means MORE likely. 0 is impossible, 1 is certain."}, Explanation := "An impossible event has probability 0, and nothing is less likely: 0."},
        fnm_item{Id := "probability/t1/009", Tier := 1, Prompt := "Which could be the chance of a goal?", Choices := array{"−0.5", "0.1", "−0.1", "1.2"}, Answer := 1, Feedback := array{"A probability is never below 0. Impossible is 0, the lowest it goes.", "", "A probability is never below 0. Impossible is 0, the lowest it goes.", "A probability is never more than 1. Even a sure thing is just 1."}, Explanation := "A probability is from 0 to 1, so the one that fits is 0.1."},
        fnm_item{Id := "probability/t1/010", Tier := 1, Prompt := "Which could be the chance of drawing red?", Choices := array{"3", "0.5", "−0.5", "1.5"}, Answer := 1, Feedback := array{"A probability is never more than 1. Even a sure thing is just 1.", "", "A probability is never below 0. Impossible is 0, the lowest it goes.", "A probability is never more than 1. Even a sure thing is just 1."}, Explanation := "A probability is from 0 to 1, so the one that fits is 0.5."},
