        fnm_item{Id := "proportional-relationships/t5/001", Tier := 5, Prompt := "Plan scale 1 in : 3 ft. A 15 ft wall is how many in?", Choices := array{"12", "3", "5", "45"}, Answer := 2, Feedback := array{"Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is just the scale. Use it to multiply (or divide) the length.", "", "Real to drawing: divide by the scale. The drawing is smaller."}, Explanation := "Each in is 3 ft: 15 ÷ 3 = 5 in."},
        fnm_item{Id := "proportional-relationships/t5/002", Tier := 5, Prompt := "Map scale 1 cm : 9 km. 6 cm is how many km?", Choices := array{"2/3", "15", "9", "54"}, Answer := 3, Feedback := array{"The real thing is bigger than the drawing: multiply by the scale.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is just the scale. Use it to multiply (or divide) the length.", ""}, Explanation := "Each cm is 9 km: 6 × 9 = 54 km."},
        fnm_item{Id := "proportional-relationships/t5/003", Tier := 5, Prompt := "Each side is 7 times as long. Area is ? times as big.", Choices := array{"343", "49", "14", "7"}, Answer := 1, Feedback := array{"Area uses 2 lengths, not 3. Multiply the scale by itself once: k × k.", "", "Each side is scaled and then multiplied: k × k, not k + k.", "Area has two sides to scale, so the scale counts twice: k × k."}, Explanation := "Area multiplies both sides: 7 × 7 = 49."},
        fnm_item{Id := "proportional-relationships/t5/004", Tier := 5, Prompt := "Scale a 2 by 4 rectangle by 2. New size?", Choices := array{"4 by 8", "2 by 8", "4 by 6", "4 by 4"}, Answer := 0, Feedback := array{"", "Scale both sides, not just one.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "Scale both sides, not just one."}, Explanation := "Multiply both sides by 2: 2 × 2 = 4, 4 × 2 = 8."},
        fnm_item{Id := "proportional-relationships/t5/005", Tier := 5, Prompt := "Map scale 1 in : 4 mi. A 28 mi trail is how many in?", Choices := array{"4", "24", "7", "112"}, Answer := 2, Feedback := array{"That is just the scale. Use it to multiply (or divide) the length.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "Real to drawing: divide by the scale. The drawing is smaller."}, Explanation := "Each in is 4 mi: 28 ÷ 4 = 7 in."},
        fnm_item{Id := "proportional-relationships/t5/006", Tier := 5, Prompt := "Each side is 9 times as long. Area is ? times as big.", Choices := array{"81", "18", "9", "729"}, Answer := 0, Feedback := array{"", "Each side is scaled and then multiplied: k × k, not k + k.", "Area has two sides to scale, so the scale counts twice: k × k.", "Area uses 2 lengths, not 3. Multiply the scale by itself once: k × k."}, Explanation := "Area multiplies both sides: 9 × 9 = 81."},
        fnm_item{Id := "proportional-relationships/t5/007", Tier := 5, Prompt := "Scale 1 cm = 4 m. A room is drawn 2 cm by 2 cm. Real area?", Choices := array{"64 sq m", "4 sq m", "16 sq m", "36 sq m"}, Answer := 0, Feedback := array{"", "That is the area on the drawing. Scale each side up to get the real area.", "Area has two sides to scale, so the scale counts twice: k × k.", "Scaling multiplies or divides. Adding or subtracting is not scaling."}, Explanation := "Sides: 2 × 4 = 8 m, 2 × 4 = 8 m. Area 8 × 8 = 64 sq m."},
        fnm_item{Id := "proportional-relationships/t5/008", Tier := 5, Prompt := "Divide each side of a 6 by 9 rectangle by 3. New size?", Choices := array{"2 by 4", "2 by 9", "3 by 6", "2 by 3"}, Answer := 3, Feedback := array{"Check your arithmetic.", "Scale both sides, not just one.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", ""}, Explanation := "Divide both sides by 3: 6 ÷ 3 = 2, 9 ÷ 3 = 3."},
        fnm_item{Id := "proportional-relationships/t5/009", Tier := 5, Prompt := "Divide each side of a 6 by 10 rectangle by 2. New size?", Choices := array{"4 by 8", "3 by 5", "3 by 10", "6 by 5"}, Answer := 1, Feedback := array{"Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "Scale both sides, not just one.", "Scale both sides, not just one."}, Explanation := "Divide both sides by 2: 6 ÷ 2 = 3, 10 ÷ 2 = 5."},
        fnm_item{Id := "proportional-relationships/t5/010", Tier := 5, Prompt := "Scale 1 in = 5 ft. A room is 10 ft by 10 ft. Drawing area?", Choices := array{"2 sq in", "4 sq in", "20 sq in", "100 sq in"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Area has two sides to scale, so the scale counts twice: k × k.", "That is the real area. The drawing is smaller: scale each side down."}, Explanation := "Sides: 10 ÷ 5 = 2 in, 10 ÷ 5 = 2 in. Area 2 × 2 = 4 sq in."},
        fnm_item{Id := "proportional-relationships/t5/011", Tier := 5, Prompt := "10 cm on the map is 60 km. 1 cm = ? km", Choices := array{"6", "50", "60", "1/6"}, Answer := 0, Feedback := array{"", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is the whole real length. The scale is the real length of 1 unit.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount."}, Explanation := "60 ÷ 10 = 6, so 1 cm = 6 km."},
        fnm_item{Id := "proportional-relationships/t5/012", Tier := 5, Prompt := "8 in on the map is 64 mi. 1 in = ? mi", Choices := array{"8", "56", "64", "1/8"}, Answer := 0, Feedback := array{"", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is the whole real length. The scale is the real length of 1 unit.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount."}, Explanation := "64 ÷ 8 = 8, so 1 in = 8 mi."},
        fnm_item{Id := "proportional-relationships/t5/013", Tier := 5, Prompt := "Map scale 1 cm : 7 km. A 28 km road is how many cm?", Choices := array{"7", "196", "4", "21"}, Answer := 2, Feedback := array{"That is just the scale. Use it to multiply (or divide) the length.", "Real to drawing: divide by the scale. The drawing is smaller.", "", "Scaling multiplies or divides. Adding or subtracting is not scaling."}, Explanation := "Each cm is 7 km: 28 ÷ 7 = 4 cm."},
        fnm_item{Id := "proportional-relationships/t5/014", Tier := 5, Prompt := "Each side is 4 times as long. Area is ? times as big.", Choices := array{"64", "4", "8", "16"}, Answer := 3, Feedback := array{"Area uses 2 lengths, not 3. Multiply the scale by itself once: k × k.", "Area has two sides to scale, so the scale counts twice: k × k.", "Each side is scaled and then multiplied: k × k, not k + k.", ""}, Explanation := "Area multiplies both sides: 4 × 4 = 16."},
        fnm_item{Id := "proportional-relationships/t5/015", Tier := 5, Prompt := "Map scale 1 in : 3 mi. 10 in is how many mi?", Choices := array{"3", "30", "3 1/3", "13"}, Answer := 1, Feedback := array{"That is just the scale. Use it to multiply (or divide) the length.", "", "The real thing is bigger than the drawing: multiply by the scale.", "Scaling multiplies or divides. Adding or subtracting is not scaling."}, Explanation := "Each in is 3 mi: 10 × 3 = 30 mi."},
        fnm_item{Id := "proportional-relationships/t5/016", Tier := 5, Prompt := "Scale 1 in = 5 ft. A room is drawn 2 in by 2 in. Real area?", Choices := array{"4 sq ft", "100 sq ft", "20 sq ft", "49 sq ft"}, Answer := 1, Feedback := array{"That is the area on the drawing. Scale each side up to get the real area.", "", "Area has two sides to scale, so the scale counts twice: k × k.", "Scaling multiplies or divides. Adding or subtracting is not scaling."}, Explanation := "Sides: 2 × 5 = 10 ft, 2 × 5 = 10 ft. Area 10 × 10 = 100 sq ft."},
        fnm_item{Id := "proportional-relationships/t5/017", Tier := 5, Prompt := "Plan scale 1 in : 4 ft. 8 in is how many ft?", Choices := array{"12", "32", "2", "4"}, Answer := 1, Feedback := array{"Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "The real thing is bigger than the drawing: multiply by the scale.", "That is just the scale. Use it to multiply (or divide) the length."}, Explanation := "Each in is 4 ft: 8 × 4 = 32 ft."},
        fnm_item{Id := "proportional-relationships/t5/018", Tier := 5, Prompt := "Scale 1 in = 2 ft. A room is 8 ft by 4 ft. Drawing area?", Choices := array{"8 sq in", "16 sq in", "32 sq in", "6 sq in"}, Answer := 0, Feedback := array{"", "Area has two sides to scale, so the scale counts twice: k × k.", "That is the real area. The drawing is smaller: scale each side down.", "Check your arithmetic."}, Explanation := "Sides: 8 ÷ 2 = 4 in, 4 ÷ 2 = 2 in. Area 4 × 2 = 8 sq in."},
        fnm_item{Id := "proportional-relationships/t5/019", Tier := 5, Prompt := "Scale 1 cm = 2 m. A room is drawn 4 cm by 4 cm. Real area?", Choices := array{"16 sq m", "36 sq m", "64 sq m", "32 sq m"}, Answer := 2, Feedback := array{"That is the area on the drawing. Scale each side up to get the real area.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "Area has two sides to scale, so the scale counts twice: k × k."}, Explanation := "Sides: 4 × 2 = 8 m, 4 × 2 = 8 m. Area 8 × 8 = 64 sq m."},
        fnm_item{Id := "proportional-relationships/t5/020", Tier := 5, Prompt := "Scale 1 in = 2 ft. A room is 10 ft by 8 ft. Drawing area?", Choices := array{"19 sq in", "40 sq in", "80 sq in", "20 sq in"}, Answer := 3, Feedback := array{"Check your arithmetic.", "Area has two sides to scale, so the scale counts twice: k × k.", "That is the real area. The drawing is smaller: scale each side down.", ""}, Explanation := "Sides: 10 ÷ 2 = 5 in, 8 ÷ 2 = 4 in. Area 5 × 4 = 20 sq in."},
        fnm_item{Id := "proportional-relationships/t5/021", Tier := 5, Prompt := "4 in on the map is 40 mi. 1 in = ? mi", Choices := array{"10", "40", "36", "1/10"}, Answer := 0, Feedback := array{"", "That is the whole real length. The scale is the real length of 1 unit.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount."}, Explanation := "40 ÷ 4 = 10, so 1 in = 10 mi."},
        fnm_item{Id := "proportional-relationships/t5/022", Tier := 5, Prompt := "Plan scale 1 in : 5 ft. 2 in is how many ft?", Choices := array{"5", "7", "10", "2/5"}, Answer := 2, Feedback := array{"That is just the scale. Use it to multiply (or divide) the length.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "The real thing is bigger than the drawing: multiply by the scale."}, Explanation := "Each in is 5 ft: 2 × 5 = 10 ft."},
        fnm_item{Id := "proportional-relationships/t5/023", Tier := 5, Prompt := "Scale 1 in = 3 ft. A room is 6 ft by 9 ft. Drawing area?", Choices := array{"4 sq in", "18 sq in", "6 sq in", "54 sq in"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Area has two sides to scale, so the scale counts twice: k × k.", "", "That is the real area. The drawing is smaller: scale each side down."}, Explanation := "Sides: 6 ÷ 3 = 2 in, 9 ÷ 3 = 3 in. Area 2 × 3 = 6 sq in."},
        fnm_item{Id := "proportional-relationships/t5/024", Tier := 5, Prompt := "Plan scale 1 cm : 3 m. 2 cm is how many m?", Choices := array{"6", "5", "3", "2/3"}, Answer := 0, Feedback := array{"", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is just the scale. Use it to multiply (or divide) the length.", "The real thing is bigger than the drawing: multiply by the scale."}, Explanation := "Each cm is 3 m: 2 × 3 = 6 m."},
        fnm_item{Id := "proportional-relationships/t5/025", Tier := 5, Prompt := "Plan scale 1 cm : 5 m. A 15 m wall is how many cm?", Choices := array{"75", "5", "10", "3"}, Answer := 3, Feedback := array{"Real to drawing: divide by the scale. The drawing is smaller.", "That is just the scale. Use it to multiply (or divide) the length.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", ""}, Explanation := "Each cm is 5 m: 15 ÷ 5 = 3 cm."},
        fnm_item{Id := "proportional-relationships/t5/026", Tier := 5, Prompt := "Each side is 3 times as long. Area is ? times as big.", Choices := array{"6", "3", "27", "9"}, Answer := 3, Feedback := array{"Each side is scaled and then multiplied: k × k, not k + k.", "Area has two sides to scale, so the scale counts twice: k × k.", "Area uses 2 lengths, not 3. Multiply the scale by itself once: k × k.", ""}, Explanation := "Area multiplies both sides: 3 × 3 = 9."},
        fnm_item{Id := "proportional-relationships/t5/027", Tier := 5, Prompt := "7 in on the plan is 28 ft. 1 in = ? ft", Choices := array{"28", "4", "1/4", "21"}, Answer := 1, Feedback := array{"That is the whole real length. The scale is the real length of 1 unit.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Scaling multiplies or divides. Adding or subtracting is not scaling."}, Explanation := "28 ÷ 7 = 4, so 1 in = 4 ft."},
        fnm_item{Id := "proportional-relationships/t5/028", Tier := 5, Prompt := "Plan scale 1 in : 5 ft. A 40 ft wall is how many in?", Choices := array{"200", "35", "5", "8"}, Answer := 3, Feedback := array{"Real to drawing: divide by the scale. The drawing is smaller.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is just the scale. Use it to multiply (or divide) the length.", ""}, Explanation := "Each in is 5 ft: 40 ÷ 5 = 8 in."},
        fnm_item{Id := "proportional-relationships/t5/029", Tier := 5, Prompt := "Each side is 2 times as long. Area is ? times as big.", Choices := array{"8", "3", "2", "4"}, Answer := 3, Feedback := array{"Area uses 2 lengths, not 3. Multiply the scale by itself once: k × k.", "Check your arithmetic.", "Area has two sides to scale, so the scale counts twice: k × k.", ""}, Explanation := "Area multiplies both sides: 2 × 2 = 4."},
        fnm_item{Id := "proportional-relationships/t5/030", Tier := 5, Prompt := "Scale 1 in = 3 ft. A room is drawn 2 in by 3 in. Real area?", Choices := array{"30 sq ft", "6 sq ft", "54 sq ft", "18 sq ft"}, Answer := 2, Feedback := array{"Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is the area on the drawing. Scale each side up to get the real area.", "", "Area has two sides to scale, so the scale counts twice: k × k."}, Explanation := "Sides: 2 × 3 = 6 ft, 3 × 3 = 9 ft. Area 6 × 9 = 54 sq ft."},
        fnm_item{Id := "proportional-relationships/t5/031", Tier := 5, Prompt := "Map scale 1 in : 7 mi. 2 in is how many mi?", Choices := array{"14", "2/7", "9", "7"}, Answer := 0, Feedback := array{"", "The real thing is bigger than the drawing: multiply by the scale.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is just the scale. Use it to multiply (or divide) the length."}, Explanation := "Each in is 7 mi: 2 × 7 = 14 mi."},
        fnm_item{Id := "proportional-relationships/t5/032", Tier := 5, Prompt := "4 cm on the plan is 40 m. 1 cm = ? m", Choices := array{"40", "1/10", "10", "36"}, Answer := 2, Feedback := array{"That is the whole real length. The scale is the real length of 1 unit.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "", "Scaling multiplies or divides. Adding or subtracting is not scaling."}, Explanation := "40 ÷ 4 = 10, so 1 cm = 10 m."},
        fnm_item{Id := "proportional-relationships/t5/033", Tier := 5, Prompt := "Enlarge a 4 by 5 rectangle with scale factor 2. New size?", Choices := array{"6 by 7", "8 by 10", "4 by 10", "8 by 5"}, Answer := 1, Feedback := array{"Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "Scale both sides, not just one.", "Scale both sides, not just one."}, Explanation := "Multiply both sides by 2: 4 × 2 = 8, 5 × 2 = 10."},
        fnm_item{Id := "proportional-relationships/t5/034", Tier := 5, Prompt := "Scale factor 6. Area is multiplied by what?", Choices := array{"36", "12", "216", "6"}, Answer := 0, Feedback := array{"", "Each side is scaled and then multiplied: k × k, not k + k.", "Area uses 2 lengths, not 3. Multiply the scale by itself once: k × k.", "Area has two sides to scale, so the scale counts twice: k × k."}, Explanation := "Area multiplies both sides: 6 × 6 = 36."},
        fnm_item{Id := "proportional-relationships/t5/035", Tier := 5, Prompt := "8 in on the map is 40 mi. 1 in = ? mi", Choices := array{"1/5", "32", "40", "5"}, Answer := 3, Feedback := array{"Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "That is the whole real length. The scale is the real length of 1 unit.", ""}, Explanation := "40 ÷ 8 = 5, so 1 in = 5 mi."},
        fnm_item{Id := "proportional-relationships/t5/036", Tier := 5, Prompt := "Plan scale 1 in : 9 ft. A 81 ft wall is how many in?", Choices := array{"729", "11", "72", "9"}, Answer := 3, Feedback := array{"Real to drawing: divide by the scale. The drawing is smaller.", "Check your arithmetic.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", ""}, Explanation := "Each in is 9 ft: 81 ÷ 9 = 9 in."},
        fnm_item{Id := "proportional-relationships/t5/037", Tier := 5, Prompt := "Scale a 4 by 5 rectangle by 2. New size?", Choices := array{"6 by 7", "8 by 10", "4 by 10", "8 by 5"}, Answer := 1, Feedback := array{"Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "Scale both sides, not just one.", "Scale both sides, not just one."}, Explanation := "Multiply both sides by 2: 4 × 2 = 8, 5 × 2 = 10."},
        fnm_item{Id := "proportional-relationships/t5/038", Tier := 5, Prompt := "Plan scale 1 cm : 2 m. A 10 m wall is how many cm?", Choices := array{"20", "8", "5", "2"}, Answer := 2, Feedback := array{"Real to drawing: divide by the scale. The drawing is smaller.", "Scaling multiplies or divides. Adding or subtracting is not scaling.", "", "That is just the scale. Use it to multiply (or divide) the length."}, Explanation := "Each cm is 2 m: 10 ÷ 2 = 5 cm."},
