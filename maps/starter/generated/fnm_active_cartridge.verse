        fnm_item{Id := "data-statistics/t4/001", Tier := 4, Prompt := "The mean of 0, 2, 20, 5, ? is 9. What is ?", Choices := array{"9", "18", "19", "45"}, Answer := 1, Feedback := array{"The ? is not the mean. Find the total, then take away the others.", "", "Check your arithmetic.", "That\'s the total. Now take away the numbers you already know."}, Explanation := "Total = 9 × 5 = 45. Known: 0 + 2 + 20 + 5 = 27. 45 − 27 = 18."},
