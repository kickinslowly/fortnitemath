        fnm_item{Id := "expressions/t2/031", Tier := 2, Prompt := "Coefficient of a in 10 + 2a?", Choices := array{"2", "2a", "10", "a"}, Answer := 0, Feedback := array{"", "That\'s the whole term. The coefficient is just its number: 7 in 7x.", "Coefficient: the number times a letter. Constant: a number all alone.", "That\'s the letter (the variable). The question asks for a number."}, Explanation := "In 10 + 2a, 2 multiplies a, so 2 is the coefficient. 10 stands alone: it is the constant."},
