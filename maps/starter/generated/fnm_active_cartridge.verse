        fnm_item{Id := "proportional-relationships/t3/001", Tier := 3, Prompt := "10 pens cost $60. In c = kn, what is k?", Choices := array{"$6", "$1/6", "$600", "$50"}, Answer := 0, Feedback := array{"", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "k is y ÷ x. Multiplying x and y gives something else.", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract."}, Explanation := "k = c ÷ n = $60 ÷ 10 = $6."},
