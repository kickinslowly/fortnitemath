        fnm_item{Id := "ratios-rates/t1/006", Tier := 1, Prompt := "For every 6 cars there are 2 vans. Ratio of vans to cars?", Choices := array{"2:6", "6:2", "2:8", "6:8"}, Answer := 0, Feedback := array{"", "Order matters: write the first thing named first.", "It asks part to part. Compare the two groups, not a group to the total.", "It asks part to part. Compare the two groups, not a group to the total."}, Explanation := "Vans first, then cars: 2 to 6 is 2:6."},
