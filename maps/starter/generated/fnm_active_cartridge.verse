        fnm_item{Id := "expressions/t4/013", Tier := 4, Prompt := "Distribute: 3(t − 5)", Choices := array{"3t − 8", "3t − 15", "3t + 15", "3t − 5"}, Answer := 1, Feedback := array{"The outside number multiplies each term: 3(x + 4) = 3x + 12.", "", "Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "Multiply each term by 3: 3 × t = 3t and 3 × 5 = 15. So 3t − 15."},
        fnm_item{Id := "expressions/t4/014", Tier := 4, Prompt := "Distribute: 6(9 + m)", Choices := array{"54 + 6m", "15 + 6m", "60m", "54 + m"}, Answer := 0, Feedback := array{"", "The outside number multiplies each term: 3(x + 4) = 3x + 12.", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "Multiply each term by 6: 6 × 9 = 54 and 6 × m = 6m. So 54 + 6m."},
        fnm_item{Id := "expressions/t4/015", Tier := 4, Prompt := "Distribute: 10(y + 2)", Choices := array{"10y + 2", "10y + 12", "10y + 20", "30y"}, Answer := 2, Feedback := array{"Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "The outside number multiplies each term: 3(x + 4) = 3x + 12.", "", "Only like terms combine. 3x + 12 can\'t become 15x."}, Explanation := "Multiply each term by 10: 10 × y = 10y and 10 × 2 = 20. So 10y + 20."},
        fnm_item{Id := "expressions/t4/016", Tier := 4, Prompt := "Factor out the GCF: 6b + 21", Choices := array{"3(2b + 21)", "3(2b + 7)", "3(3b + 18)", "3b(2 + 7)"}, Answer := 1, Feedback := array{"Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3).", "", "Factoring divides each term: 6x ÷ 3 = 2x, not 6x − 3.", "Only take out what EVERY term has. 9 has no x, so x can\'t come out."}, Explanation := "GCF of 6 and 21 is 3. 6b ÷ 3 = 2b, 21 ÷ 3 = 7. So 3(2b + 7)."},
        fnm_item{Id := "expressions/t4/017", Tier := 4, Prompt := "Factor out the GCF: 30x − 48", Choices := array{"6(5x − 48)", "7(5x − 8)", "6(24x − 42)", "6(5x − 8)"}, Answer := 3, Feedback := array{"Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3).", "Check your arithmetic.", "Factoring divides each term: 6x ÷ 3 = 2x, not 6x − 3.", ""}, Explanation := "GCF of 30 and 48 is 6. 30x ÷ 6 = 5x, 48 ÷ 6 = 8. So 6(5x − 8)."},
        fnm_item{Id := "expressions/t4/018", Tier := 4, Prompt := "Distribute: 2(3k + 10)", Choices := array{"26k", "6k + 20", "6k + 10", "6k + 12"}, Answer := 1, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "Multiply each term by 2: 2 × 3k = 6k and 2 × 10 = 20. So 6k + 20."},
        fnm_item{Id := "expressions/t4/019", Tier := 4, Prompt := "Factor out the GCF: 40w + 36", Choices := array{"4(36w + 32)", "4(10w + 9)", "4w(10 + 9)", "4(10w + 36)"}, Answer := 1, Feedback := array{"Factoring divides each term: 6x ÷ 3 = 2x, not 6x − 3.", "", "Only take out what EVERY term has. 9 has no x, so x can\'t come out.", "Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3)."}, Explanation := "GCF of 40 and 36 is 4. 40w ÷ 4 = 10w, 36 ÷ 4 = 9. So 4(10w + 9)."},
        fnm_item{Id := "expressions/t4/020", Tier := 4, Prompt := "Factor out the GCF: 35x − 7", Choices := array{"7x(5 − 1)", "7(5x − 1)", "7(5x − 7)", "8(5x − 1)"}, Answer := 1, Feedback := array{"Only take out what EVERY term has. 9 has no x, so x can\'t come out.", "", "Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3).", "Check your arithmetic."}, Explanation := "GCF of 35 and 7 is 7. 35x ÷ 7 = 5x, 7 ÷ 7 = 1. So 7(5x − 1)."},
        fnm_item{Id := "expressions/t4/021", Tier := 4, Prompt := "Distribute: 2(x + 10)", Choices := array{"2x + 12", "22x", "2x + 10", "2x + 20"}, Answer := 3, Feedback := array{"The outside number multiplies each term: 3(x + 4) = 3x + 12.", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", ""}, Explanation := "Multiply each term by 2: 2 × x = 2x and 2 × 10 = 20. So 2x + 20."},
