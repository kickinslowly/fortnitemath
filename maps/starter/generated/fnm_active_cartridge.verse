        fnm_item{Id := "rational-numbers/t1/010", Tier := 1, Prompt := "Owe $13, then earn $3. As integers?", Choices := array{"−13 and −3", "−13 and 3", "13 and −3", "13 and 3"}, Answer := 1, Feedback := array{"Below, owe, lose, down, withdraw are negative. Above, earn, gain, up are +.", "", "Below, owe, lose, down, withdraw are negative. Above, earn, gain, up are +.", "Below, owe, lose, down, withdraw are negative. Above, earn, gain, up are +."}, Explanation := "Owe means negative: −13. Earn means positive: 3. So −13 and 3."},
        fnm_item{Id := "rational-numbers/t1/011", Tier := 1, Prompt := "Start at −3 and move 4 right. Where are you?", Choices := array{"−7", "4", "1", "0"}, Answer := 2, Feedback := array{"Right means bigger numbers. Left means smaller numbers.", "Start at the starting number, not at 0, then count the move.", "", "Count the jumps between tick marks, not the tick marks themselves."}, Explanation := "Right means bigger: −3 + 4 = 1."},
