        fnm_item{Id := "linear-expressions/t4/001", Tier := 4, Prompt := "−12k + 10 = −2(6k + ?)", Choices := array{"−5", "5", "12", "10"}, Answer := 0, Feedback := array{"", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Factoring divides each term by the factor. Subtracting it is wrong.", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: 10 ÷ (−2) = −5. So −2(6k − 5)."},
        fnm_item{Id := "linear-expressions/t4/002", Tier := 4, Prompt := "Factor out the GCF: 4p − 10", Choices := array{"2(2p + 5)", "4(p − 10)", "2(2p − 10)", "2(2p − 5)"}, Answer := 3, Feedback := array{"Don\'t lose a minus sign. It stays with the term it belongs to.", "Pull out what BOTH terms share, not just one term\'s number.", "Divide EVERY term by the factor you take out, not just the first.", ""}, Explanation := "GCF of 4 and 10 is 2. Divide each term by 2: 2p − 5. So 2(2p − 5)."},
        fnm_item{Id := "linear-expressions/t4/003", Tier := 4, Prompt := "Factor out −2: −6k − 10", Choices := array{"−2(3k − 5)", "2(3k − 5)", "−2(3k − 10)", "−2(3k + 5)"}, Answer := 3, Feedback := array{"Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Divide EVERY term by the factor you take out, not just the first.", ""}, Explanation := "Divide each term by −2: −6k ÷ (−2) = 3k, −10 ÷ (−2) = 5. So −2(3k + 5)."},
        fnm_item{Id := "linear-expressions/t4/004", Tier := 4, Prompt := "Factor out the GCF: 6x − 4", Choices := array{"2(4x − 2)", "2(3x − 2)", "6(x − 4)", "2(3x + 2)"}, Answer := 1, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "", "Pull out what BOTH terms share, not just one term\'s number.", "Don\'t lose a minus sign. It stays with the term it belongs to."}, Explanation := "GCF of 6 and 4 is 2. Divide each term by 2: 3x − 2. So 2(3x − 2)."},
        fnm_item{Id := "linear-expressions/t4/005", Tier := 4, Prompt := "2b + 10 = 2(b + ?)", Choices := array{"8", "5", "−5", "10"}, Answer := 1, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by 2: 10 ÷ 2 = 5. So 2(b + 5)."},
        fnm_item{Id := "linear-expressions/t4/006", Tier := 4, Prompt := "Factor out the GCF: 4m − 10", Choices := array{"4(m − 10)", "2(2m − 8)", "2(2m + 5)", "2(2m − 5)"}, Answer := 3, Feedback := array{"Pull out what BOTH terms share, not just one term\'s number.", "Factoring divides each term by the factor. Subtracting it is wrong.", "Don\'t lose a minus sign. It stays with the term it belongs to.", ""}, Explanation := "GCF of 4 and 10 is 2. Divide each term by 2: 2m − 5. So 2(2m − 5)."},
        fnm_item{Id := "linear-expressions/t4/007", Tier := 4, Prompt := "−10y − 5 = −5(2y + ?)", Choices := array{"−1", "1", "−5", "2"}, Answer := 1, Feedback := array{"Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Divide EVERY term by the factor you take out, not just the first.", "Check your arithmetic."}, Explanation := "Divide each term by −5: −5 ÷ (−5) = 1. So −5(2y + 1)."},
        fnm_item{Id := "linear-expressions/t4/008", Tier := 4, Prompt := "Factor out −2: −6k + 2", Choices := array{"−2(3k − 1)", "2(3k + 1)", "−2(3k + 1)", "−2(3k + 2)"}, Answer := 0, Feedback := array{"", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −6k ÷ (−2) = 3k, 2 ÷ (−2) = −1. So −2(3k − 1)."},
        fnm_item{Id := "linear-expressions/t4/009", Tier := 4, Prompt := "Factor out the GCF: 2n + 4", Choices := array{"2(n + 4)", "4(2n + 1)", "2(n + 2)", "3(n + 2)"}, Answer := 2, Feedback := array{"Pull out what BOTH terms share, not just one term\'s number.", "Pull out what BOTH terms share, not just one term\'s number.", "", "Check your arithmetic."}, Explanation := "GCF of 2 and 4 is 2. Divide each term by 2: n + 2. So 2(n + 2)."},
        fnm_item{Id := "linear-expressions/t4/010", Tier := 4, Prompt := "Factor out the GCF: 10n − 8", Choices := array{"2(8n − 6)", "2(5n − 4)", "10(n − 8)", "2(5n + 4)"}, Answer := 1, Feedback := array{"Factoring divides each term by the factor. Subtracting it is wrong.", "", "Pull out what BOTH terms share, not just one term\'s number.", "Don\'t lose a minus sign. It stays with the term it belongs to."}, Explanation := "GCF of 10 and 8 is 2. Divide each term by 2: 5n − 4. So 2(5n − 4)."},
        fnm_item{Id := "linear-expressions/t4/011", Tier := 4, Prompt := "−6x − 9 = −3(2x + ?)", Choices := array{"3", "−6", "−3", "−9"}, Answer := 0, Feedback := array{"", "Factoring divides each term by the factor. Subtracting it is wrong.", "Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −3: −9 ÷ (−3) = 3. So −3(2x + 3)."},
        fnm_item{Id := "linear-expressions/t4/012", Tier := 4, Prompt := "Factor out −2: −4x − 6", Choices := array{"−2(2x − 3)", "−2(2x + 3)", "2(2x − 3)", "−2(2x − 6)"}, Answer := 1, Feedback := array{"Dividing by a negative flips the sign: −4x + 8 = −4(x − 2).", "", "Don\'t lose a minus sign. It stays with the term it belongs to.", "Divide EVERY term by the factor you take out, not just the first."}, Explanation := "Divide each term by −2: −4x ÷ (−2) = 2x, −6 ÷ (−2) = 3. So −2(2x + 3)."},
        fnm_item{Id := "linear-expressions/t4/013", Tier := 4, Prompt := "Factor out the GCF: 2k − 6", Choices := array{"2(k − 6)", "2(k − 3)", "2(k − 4)", "2(k + 3)"}, Answer := 1, Feedback := array{"Pull out what BOTH terms share, not just one term\'s number.", "", "Factoring divides each term by the factor. Subtracting it is wrong.", "Don\'t lose a minus sign. It stays with the term it belongs to."}, Explanation := "GCF of 2 and 6 is 2. Divide each term by 2: k − 3. So 2(k − 3)."},
