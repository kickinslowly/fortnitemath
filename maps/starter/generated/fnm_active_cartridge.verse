        fnm_item{Id := "factors-multiples/t2/001", Tier := 2, Prompt := "GCF of 4 and 36?", Choices := array{"7", "36", "4", "2"}, Answer := 2, Feedback := array{"Check your arithmetic.", "That\'s a common multiple. The GCF divides both numbers, so it\'s small.", "", "That\'s a common factor, but not the greatest. Look for a bigger one."}, Explanation := "4 = 4 × 1, 36 = 4 × 9. 1 and 9 share no factor, so GCF = 4."},
