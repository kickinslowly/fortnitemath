        fnm_item{Id := "factors-multiples/t4/001", Tier := 4, Prompt := "Factor out the GCF: 80 + 56", Choices := array{"8(10 + 7)", "8(72 + 48)", "8(10 + 56)", "8(10 + 6)"}, Answer := 0, Feedback := array{"", "Divide each number by the GCF. Don\'t subtract it.", "Divide BOTH numbers by the GCF, not just one.", "Check your arithmetic."}, Explanation := "80 = 8 × 10, 56 = 8 × 7. GCF 8; 10 and 7 share no factor. 80 + 56 = 8(10 + 7)."},
        fnm_item{Id := "factors-multiples/t4/002", Tier := 4, Prompt := "48 + 56 = 8(? + ?)", Choices := array{"6 + 7", "6 + 56", "12 + 14", "40 + 48"}, Answer := 0, Feedback := array{"", "Divide BOTH numbers by the GCF, not just one.", "That\'s a common factor, but not the greatest. Look for a bigger one.", "Divide each number by the GCF. Don\'t subtract it."}, Explanation := "48 = 8 × 6, 56 = 8 × 7. GCF 8; 6 and 7 share no factor. 48 + 56 = 8(6 + 7)."},
        fnm_item{Id := "factors-multiples/t4/003", Tier := 4, Prompt := "16 + 24 = 8(? + ?)", Choices := array{"4 + 6", "8 + 16", "2 + 3", "2 + 24"}, Answer := 2, Feedback := array{"That\'s a common factor, but not the greatest. Look for a bigger one.", "Divide each number by the GCF. Don\'t subtract it.", "", "Divide BOTH numbers by the GCF, not just one."}, Explanation := "16 = 8 × 2, 24 = 8 × 3. GCF 8; 2 and 3 share no factor. 16 + 24 = 8(2 + 3)."},
        fnm_item{Id := "factors-multiples/t4/004", Tier := 4, Prompt := "Factor out the GCF: 40 + 70", Choices := array{"10(4 + 6)", "10(30 + 60)", "10(4 + 7)", "10(40 + 7)"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Divide each number by the GCF. Don\'t subtract it.", "", "Divide BOTH numbers by the GCF, not just one."}, Explanation := "40 = 10 × 4, 70 = 10 × 7. GCF 10; 4 and 7 share no factor. 40 + 70 = 10(4 + 7)."},
        fnm_item{Id := "factors-multiples/t4/005", Tier := 4, Prompt := "Factor out the GCF: 40 + 24", Choices := array{"8(5 + 2)", "8(5 + 3)", "8(32 + 16)", "8(40 + 3)"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Divide each number by the GCF. Don\'t subtract it.", "Divide BOTH numbers by the GCF, not just one."}, Explanation := "40 = 8 × 5, 24 = 8 × 3. GCF 8; 5 and 3 share no factor. 40 + 24 = 8(5 + 3)."},
        fnm_item{Id := "factors-multiples/t4/006", Tier := 4, Prompt := "Factor out the GCF: 21 + 35", Choices := array{"7(14 + 28)", "7(3 + 5)", "7(3 + 4)", "7(3 + 35)"}, Answer := 1, Feedback := array{"Divide each number by the GCF. Don\'t subtract it.", "", "Check your arithmetic.", "Divide BOTH numbers by the GCF, not just one."}, Explanation := "21 = 7 × 3, 35 = 7 × 5. GCF 7; 3 and 5 share no factor. 21 + 35 = 7(3 + 5)."},
        fnm_item{Id := "factors-multiples/t4/007", Tier := 4, Prompt := "24 + 21 = 3(? + ?)", Choices := array{"8 + 6", "8 + 7", "8 + 21", "21 + 18"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Divide BOTH numbers by the GCF, not just one.", "Divide each number by the GCF. Don\'t subtract it."}, Explanation := "24 = 3 × 8, 21 = 3 × 7. GCF 3; 8 and 7 share no factor. 24 + 21 = 3(8 + 7)."},
        fnm_item{Id := "factors-multiples/t4/008", Tier := 4, Prompt := "63 + 70 = 7(? + ?)", Choices := array{"56 + 63", "63 + 10", "8 + 10", "9 + 10"}, Answer := 3, Feedback := array{"Divide each number by the GCF. Don\'t subtract it.", "Divide BOTH numbers by the GCF, not just one.", "Check your arithmetic.", ""}, Explanation := "63 = 7 × 9, 70 = 7 × 10. GCF 7; 9 and 10 share no factor. 63 + 70 = 7(9 + 10)."},
        fnm_item{Id := "factors-multiples/t4/009", Tier := 4, Prompt := "Factor out the GCF: 54 + 42", Choices := array{"6(9 + 6)", "6(9 + 7)", "6(48 + 36)", "6(9 + 42)"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Divide each number by the GCF. Don\'t subtract it.", "Divide BOTH numbers by the GCF, not just one."}, Explanation := "54 = 6 × 9, 42 = 6 × 7. GCF 6; 9 and 7 share no factor. 54 + 42 = 6(9 + 7)."},
        fnm_item{Id := "factors-multiples/t4/010", Tier := 4, Prompt := "28 + 8 = 4(? + ?)", Choices := array{"28 + 2", "7 + 2", "24 + 4", "14 + 4"}, Answer := 1, Feedback := array{"Divide BOTH numbers by the GCF, not just one.", "", "Divide each number by the GCF. Don\'t subtract it.", "That\'s a common factor, but not the greatest. Look for a bigger one."}, Explanation := "28 = 4 × 7, 8 = 4 × 2. GCF 4; 7 and 2 share no factor. 28 + 8 = 4(7 + 2)."},
