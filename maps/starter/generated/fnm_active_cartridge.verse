        fnm_item{Id := "proportional-relationships/t1/040", Tier := 1, Prompt := "A hose adds 1/4 gal in 3/4 minute. Gallons per minute?", Choices := array{"5 1/3", "3/16", "1/3", "3"}, Answer := 2, Feedback := array{"Flip only the second fraction, then multiply. Not both.", "Per 1 means divide. Dividing by a fraction makes the answer bigger.", "", "Divided the wrong way. Per 1 means: divide by the \'per\' amount."}, Explanation := "1/4 ÷ 3/4 = 1/4 × 4/3 = 4/12 = 1/3 gallons per minute."},
        fnm_item{Id := "proportional-relationships/t2/001", Tier := 2, Prompt := "x: 3, 4, 5. y: 12, 16, 20. Which equation fits?", Choices := array{"y = 12x", "y = x + 9", "x = 4y", "y = 4x"}, Answer := 3, Feedback := array{"That is a y value, not k. Divide: k = y ÷ x.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx.", "Swapped. y is the one that equals k times x, so y = kx.", ""}, Explanation := "y ÷ x is 4 every time (12 ÷ 3 = 4), so y = 4x."},
        fnm_item{Id := "proportional-relationships/t2/002", Tier := 2, Prompt := "x: 2, 3, 4. y: 8, 12, 16. Which equation fits?", Choices := array{"y = 4x", "x = 4y", "y = x + 6", "y = 8x"}, Answer := 0, Feedback := array{"", "Swapped. y is the one that equals k times x, so y = kx.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx.", "That is a y value, not k. Divide: k = y ÷ x."}, Explanation := "y ÷ x is 4 every time (8 ÷ 2 = 4), so y = 4x."},
        fnm_item{Id := "proportional-relationships/t2/003", Tier := 2, Prompt := "Which equation has w proportional to d with k = 2?", Choices := array{"w = 2d + 2", "w = 2d", "d = 2w", "w = d + 2"}, Answer := 1, Feedback := array{"y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "", "Swapped. y is the one that equals k times x, so y = kx.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx."}, Explanation := "Proportional means w = kd with nothing added. With k = 2: w = 2d."},
        fnm_item{Id := "proportional-relationships/t2/004", Tier := 2, Prompt := "x: 1, 3, 5. y: 6, 8, 10. Which equation fits?", Choices := array{"y = 5x", "y = 6x", "y = x + 5", "x = y + 5"}, Answer := 2, Feedback := array{"The table adds the same amount each time: y = x + c, not y = cx.", "Check every pair. y ÷ x changes, so this is not proportional.", "", "Swapped. y is the one that equals k times x, so y = kx."}, Explanation := "6 ÷ 1 and 8 ÷ 3 differ, so not proportional. Each y is x + 5: y = x + 5."},
        fnm_item{Id := "proportional-relationships/t2/005", Tier := 2, Prompt := "x: 1, 2, 4. y: 7, 8, 10. Which equation fits?", Choices := array{"y = x + 6", "y = 6x", "x = y + 6", "y = 7x"}, Answer := 0, Feedback := array{"", "The table adds the same amount each time: y = x + c, not y = cx.", "Swapped. y is the one that equals k times x, so y = kx.", "Check every pair. y ÷ x changes, so this is not proportional."}, Explanation := "7 ÷ 1 and 8 ÷ 2 differ, so not proportional. Each y is x + 6: y = x + 6."},
        fnm_item{Id := "proportional-relationships/t2/006", Tier := 2, Prompt := "x: 1, 3, 5. y: 3, 5, 7. Which equation fits?", Choices := array{"y = 3x", "x = y + 2", "y = x + 2", "y = 2x"}, Answer := 2, Feedback := array{"Check every pair. y ÷ x changes, so this is not proportional.", "Swapped. y is the one that equals k times x, so y = kx.", "", "The table adds the same amount each time: y = x + c, not y = cx."}, Explanation := "3 ÷ 1 and 5 ÷ 3 differ, so not proportional. Each y is x + 2: y = x + 2."},
        fnm_item{Id := "proportional-relationships/t2/007", Tier := 2, Prompt := "Which shows w proportional to d, k = 4?", Choices := array{"w = 4d + 4", "w = 4d", "w = d + 4", "d = 4w"}, Answer := 1, Feedback := array{"y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "", "y = x + 4 adds the same amount. Proportional means multiply: y = kx.", "Swapped. y is the one that equals k times x, so y = kx."}, Explanation := "Proportional means w = kd with nothing added. With k = 4: w = 4d."},
        fnm_item{Id := "proportional-relationships/t2/008", Tier := 2, Prompt := "Which shows c proportional to n, k = 7?", Choices := array{"c = 7n + 2", "n = 7c", "c = n + 7", "c = 7n"}, Answer := 3, Feedback := array{"y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "Swapped. y is the one that equals k times x, so y = kx.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx.", ""}, Explanation := "Proportional means c = kn with nothing added. With k = 7: c = 7n."},
        fnm_item{Id := "proportional-relationships/t2/009", Tier := 2, Prompt := "x: 4, 5, 6. y: 36, 45, 54. Which equation fits?", Choices := array{"y = x + 32", "y = 9x", "x = 9y", "y = 36x"}, Answer := 1, Feedback := array{"y = x + 4 adds the same amount. Proportional means multiply: y = kx.", "", "Swapped. y is the one that equals k times x, so y = kx.", "That is a y value, not k. Divide: k = y ÷ x."}, Explanation := "y ÷ x is 9 every time (36 ÷ 4 = 9), so y = 9x."},
        fnm_item{Id := "proportional-relationships/t2/010", Tier := 2, Prompt := "Which equation has c proportional to n with k = 10?", Choices := array{"c = 10n + 5", "n = 10c", "c = 10n", "c = n + 10"}, Answer := 2, Feedback := array{"y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "Swapped. y is the one that equals k times x, so y = kx.", "", "y = x + 4 adds the same amount. Proportional means multiply: y = kx."}, Explanation := "Proportional means c = kn with nothing added. With k = 10: c = 10n."},
        fnm_item{Id := "proportional-relationships/t2/011", Tier := 2, Prompt := "Which shows p proportional to h, k = 7?", Choices := array{"p = 7h + 4", "p = h + 7", "h = 7p", "p = 7h"}, Answer := 3, Feedback := array{"y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx.", "Swapped. y is the one that equals k times x, so y = kx.", ""}, Explanation := "Proportional means p = kh with nothing added. With k = 7: p = 7h."},
        fnm_item{Id := "proportional-relationships/t2/012", Tier := 2, Prompt := "Which shows p proportional to h, k = 9?", Choices := array{"p = 9h", "p = 9h + 1", "p = h + 9", "h = 9p"}, Answer := 0, Feedback := array{"", "y = 4x + 1 does not start at 0. Proportional means (0, 0) is on it.", "y = x + 4 adds the same amount. Proportional means multiply: y = kx.", "Swapped. y is the one that equals k times x, so y = kx."}, Explanation := "Proportional means p = kh with nothing added. With k = 9: p = 9h."},
