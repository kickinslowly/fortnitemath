        fnm_item{Id := "fraction-division/t5/029", Tier := 5, Prompt := "Rectangle: area 7 sq ft, width 1/2 ft. Length?", Choices := array{"1/14 ft", "3 1/2 ft", "13 ft", "14 ft"}, Answer := 3, Feedback := array{"Backwards: start with the amount you have, then divide it.", "Count the pieces: each whole holds as many as the denominator. Multiply.", "Check your arithmetic.", ""}, Explanation := "Length = area ÷ width: 7 ÷ 1/2 = 7 × 2 = 14 ft."},
