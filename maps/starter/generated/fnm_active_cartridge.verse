        fnm_item{Id := "circles/t4/006", Tier := 4, Prompt := "A rug has radius 3. Its area? Use 3 for π.", Choices := array{"18", "27", "9", "108"}, Answer := 1, Feedback := array{"That\'s the circumference. Area is π × radius × radius.", "", "Area needs r × r: square the radius, don\'t just use it.", "Square the radius as given: π × r × r. Don\'t double it first."}, Explanation := "Area = 3 × radius × radius: radius 3, 3 × 3 = 9, 3 × 9 = 27."},
