        fnm_item{Id := "expressions/t5/004", Tier := 5, Prompt := "Simplify: 6a + 15 + 8a", Choices := array{"6a + 15", "14a + 15", "14a² + 15", "29a"}, Answer := 1, Feedback := array{"Keep every term. Count all the x terms before you stop.", "", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Only like terms combine. 3x + 12 can\'t become 15x."}, Explanation := "Like terms 6a and 8a make 14a. 15 has no a, so it stays: 14a + 15."},
        fnm_item{Id := "expressions/t5/005", Tier := 5, Prompt := "Simplify: 5(p + 5) + 4(p + 3)", Choices := array{"9p + 37", "46p", "9p + 8", "9p + 17"}, Answer := 0, Feedback := array{"", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "5p + 25 and 4p + 12. p terms: 9p. Numbers: 25 + 12 = 37. So 9p + 37."},
        fnm_item{Id := "expressions/t5/006", Tier := 5, Prompt := "Simplify: 5(b + 9) + 2b", Choices := array{"5b + 45", "52b", "7b + 45", "7b + 9"}, Answer := 2, Feedback := array{"Keep every term. Count all the x terms before you stop.", "Only like terms combine. 3x + 12 can\'t become 15x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "5(b + 9) = 5b + 45. Then 5b + 2b = 7b. So 7b + 45."},
        fnm_item{Id := "expressions/t5/007", Tier := 5, Prompt := "Simplify: 4(x + 4) + 2x", Choices := array{"4x + 16", "22x", "6x + 4", "6x + 16"}, Answer := 3, Feedback := array{"Keep every term. Count all the x terms before you stop.", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", ""}, Explanation := "4(x + 4) = 4x + 16. Then 4x + 2x = 6x. So 6x + 16."},
        fnm_item{Id := "expressions/t5/008", Tier := 5, Prompt := "Simplify: n + n", Choices := array{"2n", "3n", "2n²", "n²"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Adding like terms adds the numbers: x + x + x = 3x, not x³."}, Explanation := "2 groups of n added together is 2 × n = 2n."},
        fnm_item{Id := "expressions/t5/009", Tier := 5, Prompt := "Simplify: 9y + 2 + 7y", Choices := array{"16y² + 2", "18y", "9y + 2", "16y + 2"}, Answer := 3, Feedback := array{"Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Only like terms combine. 3x + 12 can\'t become 15x.", "Keep every term. Count all the x terms before you stop.", ""}, Explanation := "Like terms 9y and 7y make 16y. 2 has no y, so it stays: 16y + 2."},
        fnm_item{Id := "expressions/t5/010", Tier := 5, Prompt := "Simplify: 8(t + 8) − t", Choices := array{"71t", "7t + 64", "7t + 8", "9t + 64"}, Answer := 1, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x."}, Explanation := "8(t + 8) = 8t + 64. Then 8t − t = 7t. So 7t + 64."},
        fnm_item{Id := "expressions/t5/011", Tier := 5, Prompt := "Simplify: 6y + 4 + 8y", Choices := array{"14y + 4", "6y + 4", "18y", "14y² + 4"}, Answer := 0, Feedback := array{"", "Keep every term. Count all the x terms before you stop.", "Only like terms combine. 3x + 12 can\'t become 15x.", "Adding like terms adds the numbers: x + x + x = 3x, not x³."}, Explanation := "Like terms 6y and 8y make 14y. 4 has no y, so it stays: 14y + 4."},
        fnm_item{Id := "expressions/t5/012", Tier := 5, Prompt := "Simplify: n + n + n + n + n", Choices := array{"n⁵", "6n", "5n", "5n⁵"}, Answer := 2, Feedback := array{"Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Check your arithmetic.", "", "Adding like terms adds the numbers: x + x + x = 3x, not x³."}, Explanation := "5 groups of n added together is 5 × n = 5n."},
        fnm_item{Id := "expressions/t5/013", Tier := 5, Prompt := "Simplify: 5a + 10 + 6a", Choices := array{"21a", "11a² + 10", "5a + 10", "11a + 10"}, Answer := 3, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Keep every term. Count all the x terms before you stop.", ""}, Explanation := "Like terms 5a and 6a make 11a. 10 has no a, so it stays: 11a + 10."},
        fnm_item{Id := "expressions/t5/014", Tier := 5, Prompt := "Simplify: k × k × k", Choices := array{"k⁴", "3k³", "k³", "3k"}, Answer := 2, Feedback := array{"Check your arithmetic.", "y × y is y². Adding gives 2y; multiplying gives y².", "", "y × y is y². Adding gives 2y; multiplying gives y²."}, Explanation := "k multiplied by itself 3 times is k³. (3k would be k added 3 times.)"},
        fnm_item{Id := "expressions/t5/015", Tier := 5, Prompt := "Simplify: 6(k + 4) − k", Choices := array{"29k", "5k + 4", "5k + 24", "7k + 24"}, Answer := 2, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "", "Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x."}, Explanation := "6(k + 4) = 6k + 24. Then 6k − k = 5k. So 5k + 24."},
        fnm_item{Id := "expressions/t5/016", Tier := 5, Prompt := "Simplify: 6x + 15 + 5x", Choices := array{"11x + 15", "6x + 15", "11x² + 15", "26x"}, Answer := 0, Feedback := array{"", "Keep every term. Count all the x terms before you stop.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Only like terms combine. 3x + 12 can\'t become 15x."}, Explanation := "Like terms 6x and 5x make 11x. 15 has no x, so it stays: 11x + 15."},
        fnm_item{Id := "expressions/t5/017", Tier := 5, Prompt := "Simplify: 5(k + 2) + 3(k + 4)", Choices := array{"30k", "8k + 6", "8k + 22", "8k + 14"}, Answer := 2, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "5k + 10 and 3k + 12. k terms: 8k. Numbers: 10 + 12 = 22. So 8k + 22."},
        fnm_item{Id := "expressions/t5/018", Tier := 5, Prompt := "Simplify: 2(p + 5) + 8p", Choices := array{"2p + 10", "10p + 5", "10p + 10", "20p"}, Answer := 2, Feedback := array{"Keep every term. Count all the x terms before you stop.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "", "Only like terms combine. 3x + 12 can\'t become 15x."}, Explanation := "2(p + 5) = 2p + 10. Then 2p + 8p = 10p. So 10p + 10."},
        fnm_item{Id := "expressions/t5/019", Tier := 5, Prompt := "Simplify: 7x + 8x", Choices := array{"56x", "15x", "16x", "15x²"}, Answer := 1, Feedback := array{"Add like terms: 5a + 3a is 8a. Multiply only when you see ×.", "", "Check your arithmetic.", "Adding like terms adds the numbers: x + x + x = 3x, not x³."}, Explanation := "Like terms: add the coefficients. 7 + 8 = 15, so 15x."},
        fnm_item{Id := "expressions/t5/020", Tier := 5, Prompt := "Simplify: 7x + 6x", Choices := array{"42x", "14x", "13x", "13x²"}, Answer := 2, Feedback := array{"Add like terms: 5a + 3a is 8a. Multiply only when you see ×.", "Check your arithmetic.", "", "Adding like terms adds the numbers: x + x + x = 3x, not x³."}, Explanation := "Like terms: add the coefficients. 7 + 6 = 13, so 13x."},
        fnm_item{Id := "expressions/t5/021", Tier := 5, Prompt := "Simplify: 4(a + 9) + 5a", Choices := array{"9a + 36", "4a + 36", "45a", "9a + 9"}, Answer := 0, Feedback := array{"", "Keep every term. Count all the x terms before you stop.", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "4(a + 9) = 4a + 36. Then 4a + 5a = 9a. So 9a + 36."},
        fnm_item{Id := "expressions/t5/022", Tier := 5, Prompt := "Simplify: 4(m + 3) + m", Choices := array{"5m + 3", "4m + 12", "17m", "5m + 12"}, Answer := 3, Feedback := array{"Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Keep every term. Count all the x terms before you stop.", "Only like terms combine. 3x + 12 can\'t become 15x.", ""}, Explanation := "4(m + 3) = 4m + 12. Then 4m + m = 5m. So 5m + 12."},
        fnm_item{Id := "expressions/t5/023", Tier := 5, Prompt := "Simplify: y × y", Choices := array{"y³", "2y²", "2y", "y²"}, Answer := 3, Feedback := array{"Check your arithmetic.", "y × y is y². Adding gives 2y; multiplying gives y².", "y × y is y². Adding gives 2y; multiplying gives y².", ""}, Explanation := "y multiplied by itself 2 times is y². (2y would be y added 2 times.)"},
        fnm_item{Id := "expressions/t5/024", Tier := 5, Prompt := "Simplify: 6w + 2w", Choices := array{"12w", "9w", "8w²", "8w"}, Answer := 3, Feedback := array{"Add like terms: 5a + 3a is 8a. Multiply only when you see ×.", "Check your arithmetic.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", ""}, Explanation := "Like terms: add the coefficients. 6 + 2 = 8, so 8w."},
        fnm_item{Id := "expressions/t5/025", Tier := 5, Prompt := "Simplify: 2(y + 3) + 4(y + 3)", Choices := array{"6y + 6", "6y + 12", "6y + 18", "24y"}, Answer := 2, Feedback := array{"Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "The outside number multiplies each term: 3(x + 4) = 3x + 12.", "", "Only like terms combine. 3x + 12 can\'t become 15x."}, Explanation := "2y + 6 and 4y + 12. y terms: 6y. Numbers: 6 + 12 = 18. So 6y + 18."},
        fnm_item{Id := "expressions/t5/026", Tier := 5, Prompt := "Simplify: 4(w + 1) + 2(w + 1)", Choices := array{"12w", "6w + 2", "6w + 8", "6w + 6"}, Answer := 3, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "The outside number multiplies each term: 3(x + 4) = 3x + 12.", ""}, Explanation := "4w + 4 and 2w + 2. w terms: 6w. Numbers: 4 + 2 = 6. So 6w + 6."},
        fnm_item{Id := "expressions/t5/027", Tier := 5, Prompt := "Simplify: 4(w + 3) + w", Choices := array{"17w", "5w + 12", "5w + 3", "4w + 12"}, Answer := 1, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Keep every term. Count all the x terms before you stop."}, Explanation := "4(w + 3) = 4w + 12. Then 4w + w = 5w. So 5w + 12."},
        fnm_item{Id := "expressions/t5/028", Tier := 5, Prompt := "Simplify: 3(w + 9) + 6w", Choices := array{"3w + 27", "36w", "9w + 27", "9w + 9"}, Answer := 2, Feedback := array{"Keep every term. Count all the x terms before you stop.", "Only like terms combine. 3x + 12 can\'t become 15x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "3(w + 9) = 3w + 27. Then 3w + 6w = 9w. So 9w + 27."},
        fnm_item{Id := "expressions/t5/029", Tier := 5, Prompt := "Simplify: 10y + 9y", Choices := array{"19y", "90y", "19y²", "20y"}, Answer := 0, Feedback := array{"", "Add like terms: 5a + 3a is 8a. Multiply only when you see ×.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Check your arithmetic."}, Explanation := "Like terms: add the coefficients. 10 + 9 = 19, so 19y."},
        fnm_item{Id := "expressions/t5/030", Tier := 5, Prompt := "Simplify: y × y × y", Choices := array{"y⁴", "y³", "3y", "3y³"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "y × y is y². Adding gives 2y; multiplying gives y².", "y × y is y². Adding gives 2y; multiplying gives y²."}, Explanation := "y multiplied by itself 3 times is y³. (3y would be y added 3 times.)"},
        fnm_item{Id := "expressions/t5/031", Tier := 5, Prompt := "Simplify: w + w + w + w + w", Choices := array{"5w⁵", "6w", "w⁵", "5w"}, Answer := 3, Feedback := array{"Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Check your arithmetic.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", ""}, Explanation := "5 groups of w added together is 5 × w = 5w."},
        fnm_item{Id := "expressions/t5/032", Tier := 5, Prompt := "Simplify: m × m", Choices := array{"m²", "2m", "m³", "2m²"}, Answer := 0, Feedback := array{"", "y × y is y². Adding gives 2y; multiplying gives y².", "Check your arithmetic.", "y × y is y². Adding gives 2y; multiplying gives y²."}, Explanation := "m multiplied by itself 2 times is m². (2m would be m added 2 times.)"},
        fnm_item{Id := "expressions/t5/033", Tier := 5, Prompt := "Simplify: p + p + p", Choices := array{"3p", "3p³", "p³", "4p"}, Answer := 0, Feedback := array{"", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Check your arithmetic."}, Explanation := "3 groups of p added together is 3 × p = 3p."},
        fnm_item{Id := "expressions/t5/034", Tier := 5, Prompt := "Simplify: 6(m + 7) − m", Choices := array{"7m + 42", "5m + 42", "5m + 7", "47m"}, Answer := 1, Feedback := array{"Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Only like terms combine. 3x + 12 can\'t become 15x."}, Explanation := "6(m + 7) = 6m + 42. Then 6m − m = 5m. So 5m + 42."},
        fnm_item{Id := "expressions/t5/035", Tier := 5, Prompt := "Simplify: 5(k + 5) − k", Choices := array{"4k + 5", "6k + 25", "29k", "4k + 25"}, Answer := 3, Feedback := array{"Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "Only like terms combine. 3x + 12 can\'t become 15x.", ""}, Explanation := "5(k + 5) = 5k + 25. Then 5k − k = 4k. So 4k + 25."},
        fnm_item{Id := "expressions/t5/036", Tier := 5, Prompt := "Simplify: 4(b + 7) − b", Choices := array{"5b + 28", "3b + 28", "31b", "3b + 7"}, Answer := 1, Feedback := array{"Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "4(b + 7) = 4b + 28. Then 4b − b = 3b. So 3b + 28."},
        fnm_item{Id := "expressions/t5/037", Tier := 5, Prompt := "Simplify: 5t + 9t", Choices := array{"14t²", "14t", "15t", "45t"}, Answer := 1, Feedback := array{"Adding like terms adds the numbers: x + x + x = 3x, not x³.", "", "Check your arithmetic.", "Add like terms: 5a + 3a is 8a. Multiply only when you see ×."}, Explanation := "Like terms: add the coefficients. 5 + 9 = 14, so 14t."},
        fnm_item{Id := "expressions/t5/038", Tier := 5, Prompt := "Simplify: 4(b + 8) − b", Choices := array{"5b + 32", "3b + 32", "35b", "3b + 8"}, Answer := 1, Feedback := array{"Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4."}, Explanation := "4(b + 8) = 4b + 32. Then 4b − b = 3b. So 3b + 32."},
        fnm_item{Id := "expressions/t5/039", Tier := 5, Prompt := "Simplify: 3(m + 2) + 5(m + 1)", Choices := array{"8m + 11", "19m", "8m + 3", "9m + 11"}, Answer := 0, Feedback := array{"", "Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Check your arithmetic."}, Explanation := "3m + 6 and 5m + 5. m terms: 8m. Numbers: 6 + 5 = 11. So 8m + 11."},
        fnm_item{Id := "expressions/t5/040", Tier := 5, Prompt := "Simplify: 6a − 2a", Choices := array{"4a", "8a", "4a²", "5a"}, Answer := 0, Feedback := array{"", "Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "Adding like terms adds the numbers: x + x + x = 3x, not x³.", "Check your arithmetic."}, Explanation := "Like terms: subtract the coefficients. 6 − 2 = 4, so 4a."}
    }
}

FnmCartridge_factors_multiples():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "factors-multiples",
    Version := "1.0.0",
    Title := "GCF \& LCM",
    Subtitle := "Factors, Multiples, Distributing",
    Grade := "6",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Factors \& Primes", Description := "Factors, multiples, primes, and counting factors."},
        fnm_tier{Tier := 2, Name := "Greatest Common Factor", Description := "Find the GCF of two numbers up to 100."},
        fnm_tier{Tier := 3, Name := "Least Common Multiple", Description := "Find the LCM of two or three small numbers."},
        fnm_tier{Tier := 4, Name := "Factor Out the GCF", Description := "Write a sum as the GCF times a sum: 18 + 24 = 6(3 + 4)."},
        fnm_tier{Tier := 5, Name := "GCF or LCM?", Description := "Story problems: pick the right tool, then use it."}
    },
    Items := array{
        fnm_item{Id := "factors-multiples/t1/001", Tier := 1, Prompt := "How many factors does 8 have?", Choices := array{"3", "6", "4", "2"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Check your arithmetic.", "", "Count 1 and the number itself too. They are factors."}, Explanation := "Factors of 8: 1, 2, 4, 8. That\'s 4."},
        fnm_item{Id := "factors-multiples/t1/002", Tier := 1, Prompt := "Only one of these is prime. Which?", Choices := array{"25", "9", "7", "1"}, Answer := 2, Feedback := array{"Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", "Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", "", "1 is not prime. A prime has exactly two factors: 1 and itself."}, Explanation := "7 has only two factors, 1 and 7, so 7 is prime."},
        fnm_item{Id := "factors-multiples/t1/003", Tier := 1, Prompt := "Which is a factor of 90?", Choices := array{"4", "180", "8", "10"}, Answer := 3, Feedback := array{"Sharing a factor isn\'t enough. The division must come out even.", "That\'s a multiple. A factor divides the number evenly, so it\'s not bigger.", "Sharing a factor isn\'t enough. The division must come out even.", ""}, Explanation := "90 ÷ 10 = 9, so 10 is a factor of 90."},
        fnm_item{Id := "factors-multiples/t1/004", Tier := 1, Prompt := "Which has exactly two factors?", Choices := array{"9", "1", "27", "19"}, Answer := 3, Feedback := array{"Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", "1 is not prime. A prime has exactly two factors: 1 and itself.", "Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", ""}, Explanation := "19 has only two factors, 1 and 19, so 19 is prime."},
        fnm_item{Id := "factors-multiples/t1/005", Tier := 1, Prompt := "Which is a multiple of 10?", Choices := array{"66", "92", "2", "80"}, Answer := 3, Feedback := array{"Sharing a factor isn\'t enough. The division must come out even.", "Sharing a factor isn\'t enough. The division must come out even.", "That\'s a factor. A multiple is the number times 1, 2, 3, and so on.", ""}, Explanation := "10 × 8 = 80, so 80 is a multiple of 10."},
        fnm_item{Id := "factors-multiples/t1/006", Tier := 1, Prompt := "Find the prime.", Choices := array{"43", "49", "9", "27"}, Answer := 0, Feedback := array{"", "Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", "Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", "Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?"}, Explanation := "43 has only two factors, 1 and 43, so 43 is prime."},
        fnm_item{Id := "factors-multiples/t1/007", Tier := 1, Prompt := "Which number is prime?", Choices := array{"27", "1", "45", "17"}, Answer := 3, Feedback := array{"Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", "1 is not prime. A prime has exactly two factors: 1 and itself.", "Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", ""}, Explanation := "17 has only two factors, 1 and 17, so 17 is prime."},
        fnm_item{Id := "factors-multiples/t1/008", Tier := 1, Prompt := "How many factors does 21 have?", Choices := array{"6", "4", "5", "2"}, Answer := 1, Feedback := array{"Check your arithmetic.", "", "Check your arithmetic.", "Count 1 and the number itself too. They are factors."}, Explanation := "Factors of 21: 1, 3, 7, 21. That\'s 4."},
        fnm_item{Id := "factors-multiples/t1/009", Tier := 1, Prompt := "Which is a multiple of 6?", Choices := array{"56", "51", "26", "42"}, Answer := 3, Feedback := array{"Ending in the same digit doesn\'t make a multiple. Skip-count to check.", "Sharing a factor isn\'t enough. The division must come out even.", "Ending in the same digit doesn\'t make a multiple. Skip-count to check.", ""}, Explanation := "6 × 7 = 42, so 42 is a multiple of 6."},
        fnm_item{Id := "factors-multiples/t1/010", Tier := 1, Prompt := "How many factors does 27 have?", Choices := array{"5", "6", "2", "4"}, Answer := 3, Feedback := array{"Check your arithmetic.", "Check your arithmetic.", "Count 1 and the number itself too. They are factors.", ""}, Explanation := "Factors of 27: 1, 3, 9, 27. That\'s 4."},
        fnm_item{Id := "factors-multiples/t1/011", Tier := 1, Prompt := "Which is a factor of 18?", Choices := array{"12", "4", "3", "36"}, Answer := 2, Feedback := array{"Sharing a factor isn\'t enough. The division must come out even.", "Sharing a factor isn\'t enough. The division must come out even.", "", "That\'s a multiple. A factor divides the number evenly, so it\'s not bigger."}, Explanation := "18 ÷ 3 = 6, so 3 is a factor of 18."},
        fnm_item{Id := "factors-multiples/t1/012", Tier := 1, Prompt := "How many factors does 28 have?", Choices := array{"3", "5", "6", "4"}, Answer := 2, Feedback := array{"Each factor pair gives two factors. Count every number, not the pairs.", "Check your arithmetic.", "", "Count 1 and the number itself too. They are factors."}, Explanation := "Factors of 28: 1, 2, 4, 7, 14, 28. That\'s 6."},
        fnm_item{Id := "factors-multiples/t1/013", Tier := 1, Prompt := "Which number is a prime number?", Choices := array{"27", "1", "9", "29"}, Answer := 3, Feedback := array{"Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", "1 is not prime. A prime has exactly two factors: 1 and itself.", "Odd isn\'t the same as prime. Try 3, 5, 7: does one divide it?", ""}, Explanation := "29 has only two factors, 1 and 29, so 29 is prime."},
        fnm_item{Id := "factors-multiples/t1/014", Tier := 1, Prompt := "Which is a multiple of 4?", Choices := array{"34", "16", "14", "2"}, Answer := 1, Feedback := array{"Ending in the same digit doesn\'t make a multiple. Skip-count to check.", "", "Ending in the same digit doesn\'t make a multiple. Skip-count to check.", "That\'s a factor. A multiple is the number times 1, 2, 3, and so on."}, Explanation := "4 × 4 = 16, so 16 is a multiple of 4."},
        fnm_item{Id := "factors-multiples/t1/015", Tier := 1, Prompt := "Which is a multiple of 8?", Choices := array{"32", "98", "30", "38"}, Answer := 0, Feedback := array{"", "Ending in the same digit doesn\'t make a multiple. Skip-count to check.", "Sharing a factor isn\'t enough. The division must come out even.", "Ending in the same digit doesn\'t make a multiple. Skip-count to check."}, Explanation := "8 × 4 = 32, so 32 is a multiple of 8."},
        fnm_item{Id := "factors-multiples/t1/016", Tier := 1, Prompt := "How many factors does 15 have?", Choices := array{"2", "5", "4", "3"}, Answer := 2, Feedback := array{"Count 1 and the number itself too. They are factors.", "Check your arithmetic.", "", "Check your arithmetic."}, Explanation := "Factors of 15: 1, 3, 5, 15. That\'s 4."},
        fnm_item{Id := "factors-multiples/t1/017", Tier := 1, Prompt := "Which is a factor of 63?", Choices := array{"9", "6", "126", "12"}, Answer := 0, Feedback := array{"", "Sharing a factor isn\'t enough. The division must come out even.", "That\'s a multiple. A factor divides the number evenly, so it\'s not bigger.", "Sharing a factor isn\'t enough. The division must come out even."}, Explanation := "63 ÷ 9 = 7, so 9 is a factor of 63."},
        fnm_item{Id := "factors-multiples/t1/018", Tier := 1, Prompt := "Which is a factor of 42?", Choices := array{"7", "84", "10", "9"}, Answer := 0, Feedback := array{"", "That\'s a multiple. A factor divides the number evenly, so it\'s not bigger.", "Sharing a factor isn\'t enough. The division must come out even.", "Sharing a factor isn\'t enough. The division must come out even."}, Explanation := "42 ÷ 7 = 6, so 7 is a factor of 42."},
        fnm_item{Id := "factors-multiples/t1/019", Tier := 1, Prompt := "Which is a factor of 6?", Choices := array{"9", "12", "3", "4"}, Answer := 2, Feedback := array{"Sharing a factor isn\'t enough. The division must come out even.", "That\'s a multiple. A factor divides the number evenly, so it\'s not bigger.", "", "Sharing a factor isn\'t enough. The division must come out even."}, Explanation := "6 ÷ 3 = 2, so 3 is a factor of 6."},
        fnm_item{Id := "factors-multiples/t1/020", Tier := 1, Prompt := "Which is a factor of 36?", Choices := array{"9", "72", "10", "8"}, Answer := 0, Feedback := array{"", "That\'s a multiple. A factor divides the number evenly, so it\'s not bigger.", "Sharing a factor isn\'t enough. The division must come out even.", "Sharing a factor isn\'t enough. The division must come out even."}, Explanation := "36 ÷ 9 = 4, so 9 is a factor of 36."},
        fnm_item{Id := "factors-multiples/t1/021", Tier := 1, Prompt := "Which is a factor of 24?", Choices := array{"48", "8", "9", "10"}, Answer := 1, Feedback := array{"That\'s a multiple. A factor divides the number evenly, so it\'s not bigger.", "", "Sharing a factor isn\'t enough. The division must come out even.", "Sharing a factor isn\'t enough. The division must come out even."}, Explanation := "24 ÷ 8 = 3, so 8 is a factor of 24."},
        fnm_item{Id := "factors-multiples/t1/022", Tier := 1, Prompt := "How many factors does 24 have?", Choices := array{"4", "10", "6", "8"}, Answer := 3, Feedback := array{"Each factor pair gives two factors. Count every number, not the pairs.", "Check your arithmetic.", "Count 1 and the number itself too. They are factors.", ""}, Explanation := "Factors of 24: 1, 2, 3, 4, 6, 8, 12, 24. That\'s 8."},
