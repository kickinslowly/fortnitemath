FnmCartridge_equations_inequalities():fnm_cartridge = fnm_cartridge{
    Protocol := "fnm-cart/1",
    Id := "equations-inequalities",
    Version := "1.0.0",
    Title := "Equations \& Inequalities",
    Subtitle := "Solve One Step",
    Grade := "6",
    Tiers := array{
        fnm_tier{Tier := 1, Name := "Is It a Solution?", Description := "Plug a value in: which one makes the equation true?"},
        fnm_tier{Tier := 2, Name := "Add \& Subtract", Description := "Solve x + a = b and x − a = b by undoing the step."},
        fnm_tier{Tier := 3, Name := "Multiply \& Divide", Description := "Solve ax = b and x ÷ a = b by undoing the step."},
        fnm_tier{Tier := 4, Name := "Write the Equation", Description := "Turn a short story into a one-step equation."},
        fnm_tier{Tier := 5, Name := "Inequalities", Description := "Write x \> c or x ≤ c from words, and pick a value that makes one true."}
    },
    Items := array{
        fnm_item{Id := "equations-inequalities/t1/001", Tier := 1, Prompt := "Which makes x ÷ 2 = 5 true?", Choices := array{"5", "8", "7", "10"}, Answer := 3, Feedback := array{"That number is already in the equation. Plug your pick in: is it true?", "Check your arithmetic.", "x ÷ 5 means x split by 5. Undo divide by multiplying, not adding.", ""}, Explanation := "Try 10: 10 ÷ 2 = 5. True, so x = 10 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/002", Tier := 1, Prompt := "Which makes n + 9 = 10 true?", Choices := array{"9", "10", "1", "19"}, Answer := 2, Feedback := array{"That number is already in the equation. Plug your pick in: is it true?", "That number is already in the equation. Plug your pick in: is it true?", "", "Undo the step with the opposite: + undoes −, × undoes ÷."}, Explanation := "Try 1: 1 + 9 = 10. True, so n = 1 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/003", Tier := 1, Prompt := "Which makes x + 10 = 11 true?", Choices := array{"10", "1", "11", "21"}, Answer := 1, Feedback := array{"That number is already in the equation. Plug your pick in: is it true?", "", "That number is already in the equation. Plug your pick in: is it true?", "Undo the step with the opposite: + undoes −, × undoes ÷."}, Explanation := "Try 1: 1 + 10 = 11. True, so x = 1 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/004", Tier := 1, Prompt := "Which makes 2m = 4 true?", Choices := array{"4", "8", "2", "3"}, Answer := 2, Feedback := array{"That number is already in the equation. Plug your pick in: is it true?", "Undo the step with the opposite: + undoes −, × undoes ÷.", "", "Check your arithmetic."}, Explanation := "Try 2: 2 × 2 = 4. True, so m = 2 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/005", Tier := 1, Prompt := "Which makes x ÷ 2 = 3 true?", Choices := array{"5", "6", "3", "8"}, Answer := 1, Feedback := array{"x ÷ 5 means x split by 5. Undo divide by multiplying, not adding.", "", "That number is already in the equation. Plug your pick in: is it true?", "Check your arithmetic."}, Explanation := "Try 6: 6 ÷ 2 = 3. True, so x = 6 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/006", Tier := 1, Prompt := "Which makes m + 6 = 8 true?", Choices := array{"14", "2", "8", "6"}, Answer := 1, Feedback := array{"Undo the step with the opposite: + undoes −, × undoes ÷.", "", "That number is already in the equation. Plug your pick in: is it true?", "That number is already in the equation. Plug your pick in: is it true?"}, Explanation := "Try 2: 2 + 6 = 8. True, so m = 2 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/007", Tier := 1, Prompt := "Which makes m + 7 = 11 true?", Choices := array{"7", "11", "18", "4"}, Answer := 3, Feedback := array{"That number is already in the equation. Plug your pick in: is it true?", "That number is already in the equation. Plug your pick in: is it true?", "Undo the step with the opposite: + undoes −, × undoes ÷.", ""}, Explanation := "Try 4: 4 + 7 = 11. True, so m = 4 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/008", Tier := 1, Prompt := "Which makes m − 7 = 4 true?", Choices := array{"7", "11", "4", "9"}, Answer := 1, Feedback := array{"That number is already in the equation. Plug your pick in: is it true?", "", "That number is already in the equation. Plug your pick in: is it true?", "Check your arithmetic."}, Explanation := "Try 11: 11 − 7 = 4. True, so m = 11 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/009", Tier := 1, Prompt := "Which makes 3n = 18 true?", Choices := array{"15", "54", "6", "18"}, Answer := 2, Feedback := array{"4x means 4 times x. Undo times by dividing, not subtracting.", "Undo the step with the opposite: + undoes −, × undoes ÷.", "", "That number is already in the equation. Plug your pick in: is it true?"}, Explanation := "Try 6: 3 × 6 = 18. True, so n = 6 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/010", Tier := 1, Prompt := "Which makes m + 6 = 7 true?", Choices := array{"7", "13", "1", "6"}, Answer := 2, Feedback := array{"That number is already in the equation. Plug your pick in: is it true?", "Undo the step with the opposite: + undoes −, × undoes ÷.", "", "That number is already in the equation. Plug your pick in: is it true?"}, Explanation := "Try 1: 1 + 6 = 7. True, so m = 1 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/011", Tier := 1, Prompt := "Which makes x ÷ 5 = 2 true?", Choices := array{"9", "2", "7", "10"}, Answer := 3, Feedback := array{"Check your arithmetic.", "That number is already in the equation. Plug your pick in: is it true?", "x ÷ 5 means x split by 5. Undo divide by multiplying, not adding.", ""}, Explanation := "Try 10: 10 ÷ 5 = 2. True, so x = 10 is the solution."},
        fnm_item{Id := "equations-inequalities/t1/012", Tier := 1, Prompt := "Which makes 4k = 20 true?", Choices := array{"16", "20", "5", "80"}, Answer := 2, Feedback := array{"4x means 4 times x. Undo times by dividing, not subtracting.", "That number is already in the equation. Plug your pick in: is it true?", "", "Undo the step with the opposite: + undoes −, × undoes ÷."}, Explanation := "Try 5: 4 × 5 = 20. True, so k = 5 is the solution."},
