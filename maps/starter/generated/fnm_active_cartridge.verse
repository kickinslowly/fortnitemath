        fnm_item{Id := "proportional-relationships/t1/034", Tier := 1, Prompt := "Rope A is 9/10 ft, rope B is 3/5 ft. A is how many times B?", Choices := array{"1 1/2", "3/10", "2/3", "27/50"}, Answer := 0, Feedback := array{"", "A rate, or \'how many times\', is a quotient. Divide; don\'t subtract.", "Divided the wrong way. Per 1 means: divide by the \'per\' amount.", "Per 1 means divide. Dividing by a fraction makes the answer bigger."}, Explanation := "9/10 ÷ 3/5 = 9/10 × 5/3 = 45/30 = 1 1/2 times as long."},
