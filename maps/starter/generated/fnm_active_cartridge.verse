        fnm_item{Id := "expressions/t4/001", Tier := 4, Prompt := "Distribute: 2(k − 5)", Choices := array{"2k − 5", "2k + 10", "2k − 10", "2k − 7"}, Answer := 2, Feedback := array{"Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "Multiply each term by 2: 2 × k = 2k and 2 × 5 = 10. So 2k − 10."},
        fnm_item{Id := "expressions/t4/002", Tier := 4, Prompt := "Factor out the GCF: 56t − 8", Choices := array{"8t(7 − 1)", "9(7t − 1)", "8(7t − 8)", "8(7t − 1)"}, Answer := 3, Feedback := array{"Only take out what EVERY term has. 9 has no x, so x can\'t come out.", "Check your arithmetic.", "Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3).", ""}, Explanation := "GCF of 56 and 8 is 8. 56t ÷ 8 = 7t, 8 ÷ 8 = 1. So 8(7t − 1)."},
        fnm_item{Id := "expressions/t4/003", Tier := 4, Prompt := "Distribute: 4(4k + 9)", Choices := array{"52k", "16k + 9", "16k + 13", "16k + 36"}, Answer := 3, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "The outside number multiplies each term: 3(x + 4) = 3x + 12.", ""}, Explanation := "Multiply each term by 4: 4 × 4k = 16k and 4 × 9 = 36. So 16k + 36."},
        fnm_item{Id := "expressions/t4/004", Tier := 4, Prompt := "Distribute: 3(b + 7)", Choices := array{"3b + 21", "3b + 7", "24b", "3b + 10"}, Answer := 0, Feedback := array{"", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Only like terms combine. 3x + 12 can\'t become 15x.", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "Multiply each term by 3: 3 × b = 3b and 3 × 7 = 21. So 3b + 21."},
        fnm_item{Id := "expressions/t4/005", Tier := 4, Prompt := "Factor out the GCF: 20y + 2", Choices := array{"2(10y + 2)", "2y(10 + 1)", "3(10y + 1)", "2(10y + 1)"}, Answer := 3, Feedback := array{"Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3).", "Only take out what EVERY term has. 9 has no x, so x can\'t come out.", "Check your arithmetic.", ""}, Explanation := "GCF of 20 and 2 is 2. 20y ÷ 2 = 10y, 2 ÷ 2 = 1. So 2(10y + 1)."},
        fnm_item{Id := "expressions/t4/006", Tier := 4, Prompt := "Distribute: 5(2y + 5)", Choices := array{"35y", "10y + 5", "10y + 25", "10y + 10"}, Answer := 2, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "Multiply each term by 5: 5 × 2y = 10y and 5 × 5 = 25. So 10y + 25."},
        fnm_item{Id := "expressions/t4/007", Tier := 4, Prompt := "Factor out the GCF: 25b + 5", Choices := array{"6(5b + 1)", "5b(5 + 1)", "5(5b + 5)", "5(5b + 1)"}, Answer := 3, Feedback := array{"Check your arithmetic.", "Only take out what EVERY term has. 9 has no x, so x can\'t come out.", "Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3).", ""}, Explanation := "GCF of 25 and 5 is 5. 25b ÷ 5 = 5b, 5 ÷ 5 = 1. So 5(5b + 1)."},
        fnm_item{Id := "expressions/t4/008", Tier := 4, Prompt := "Distribute: 3(2b + 10)", Choices := array{"6b + 13", "6b + 10", "6b + 30", "36b"}, Answer := 2, Feedback := array{"The outside number multiplies each term: 3(x + 4) = 3x + 12.", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "", "Only like terms combine. 3x + 12 can\'t become 15x."}, Explanation := "Multiply each term by 3: 3 × 2b = 6b and 3 × 10 = 30. So 6b + 30."},
        fnm_item{Id := "expressions/t4/009", Tier := 4, Prompt := "Distribute: 3(t − 9)", Choices := array{"3t − 27", "3t − 9", "3t + 27", "3t − 12"}, Answer := 0, Feedback := array{"", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "Keep the minus: 3(x − 4) = 3x − 12, and 5x − x = 4x.", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "Multiply each term by 3: 3 × t = 3t and 3 × 9 = 27. So 3t − 27."},
        fnm_item{Id := "expressions/t4/010", Tier := 4, Prompt := "Factor out the GCF: 8x − 14", Choices := array{"2(6x − 12)", "2(4x − 7)", "2(4x − 14)", "3(4x − 7)"}, Answer := 1, Feedback := array{"Factoring divides each term: 6x ÷ 3 = 2x, not 6x − 3.", "", "Divide EVERY term by the factor you take out: 6x + 9 = 3(2x + 3).", "Check your arithmetic."}, Explanation := "GCF of 8 and 14 is 2. 8x ÷ 2 = 4x, 14 ÷ 2 = 7. So 2(4x − 7)."},
        fnm_item{Id := "expressions/t4/011", Tier := 4, Prompt := "Distribute: 4(5p + 2)", Choices := array{"28p", "20p + 8", "20p + 2", "20p + 6"}, Answer := 1, Feedback := array{"Only like terms combine. 3x + 12 can\'t become 15x.", "", "Multiply EVERY term inside: 3(x + 4) = 3x + 12, not 3x + 4.", "The outside number multiplies each term: 3(x + 4) = 3x + 12."}, Explanation := "Multiply each term by 4: 4 × 5p = 20p and 4 × 2 = 8. So 20p + 8."},
