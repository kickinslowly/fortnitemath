        fnm_item{Id := "two-step-equations/t4/017", Tier := 4, Prompt := "3 pens at $c each plus a $4 bag cost $10. Find c.", Choices := array{"3", "6", "2", "18"}, Answer := 2, Feedback := array{"2x means 2 times x. Undo times by dividing, not subtracting.", "You stopped early. After undoing + or −, divide to get x alone.", "", "x is multiplied by the number, so divide to undo it. Don\'t multiply again."}, Explanation := "3c + 4 = 10. Subtract 4: 3c = 6. Divide by 3: c = 2."},
