        fnm_item{Id := "expressions/t2/033", Tier := 2, Prompt := "How many terms in 9x + 9y + 2?", Choices := array{"2", "3", "5", "4"}, Answer := 1, Feedback := array{"A number alone is a term too: 3a + 2b + 5 has 3 terms.", "", "A term is a whole piece between + signs: 3a is one term, not two.", "Check your arithmetic."}, Explanation := "Terms are the pieces joined by +: 9x, 9y, 2. That is 3 terms."},
