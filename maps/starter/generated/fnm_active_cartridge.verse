        fnm_item{Id := "integer-ops/t5/022", Tier := 5, Prompt := "−3² × 3 − (−7) × 6", Choices := array{"15", "−120", "69", "−15"}, Answer := 0, Feedback := array{"", "Do × and ÷ before + and −.", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "One negative makes it negative. Two negatives make it positive."}, Explanation := "3² = 9, then −3² = −9, then −9 × 3 = −27, then −7 × 6 = −42, then −27 − (−42) = 15."},
        fnm_item{Id := "integer-ops/t5/023", Tier := 5, Prompt := "6 × ((−2)³ ÷ 2)", Choices := array{"2", "24", "−24", "−96"}, Answer := 2, Feedback := array{"× means groups: 4 × (−3) is 4 groups of −3, not 4 + (−3).", "One negative makes it negative. Two negatives make it positive.", "", "Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12."}, Explanation := "(−2)³ = −8, then −8 ÷ 2 = −4, then 6 × (−4) = −24."},
        fnm_item{Id := "integer-ops/t5/024", Tier := 5, Prompt := "(−4² + (−8)) ÷ (−8)", Choices := array{"3", "−3", "−1", "192"}, Answer := 0, Feedback := array{"", "Two negatives make a positive only when you multiply or divide.", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12."}, Explanation := "4² = 16, then −4² = −16, then −16 + (−8) = −24, then −24 ÷ (−8) = 3."},
        fnm_item{Id := "integer-ops/t5/025", Tier := 5, Prompt := "(−2² + (−5)) × (−3) − (−7)", Choices := array{"−20", "10", "34", "20"}, Answer := 2, Feedback := array{"Two negatives make a positive only when you multiply or divide.", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "", "Subtracting a negative is adding: 4 − (−6) = 4 + 6."}, Explanation := "2² = 4, then −2² = −4, then −4 + (−5) = −9, then −9 × (−3) = 27, then 27 − (−7) = 34."},
        fnm_item{Id := "integer-ops/t5/026", Tier := 5, Prompt := "−4² + (−6) − 3", Choices := array{"25", "7", "−25", "19"}, Answer := 2, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "", "Two negatives make a positive only when you multiply or divide."}, Explanation := "4² = 16, then −4² = −16, then −16 + (−6) = −22, then −22 − 3 = −25."},
        fnm_item{Id := "integer-ops/t5/027", Tier := 5, Prompt := "−3 × (−7) − (−8 + 9) × (−4)", Choices := array{"−80", "25", "−7", "89"}, Answer := 1, Feedback := array{"Do × and ÷ before + and −.", "", "× means groups: 4 × (−3) is 4 groups of −3, not 4 + (−3).", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "−8 + 9 = 1, then −3 × (−7) = 21, then 1 × (−4) = −4, then 21 − (−4) = 25."},
        fnm_item{Id := "integer-ops/t5/028", Tier := 5, Prompt := "−3² + (−3) + (−10)", Choices := array{"2", "−22", "22", "−4"}, Answer := 1, Feedback := array{"Two negatives make a positive only when you multiply or divide.", "", "Right size, wrong sign. Which number is farther from 0?", "−3² means −(3 × 3). (−3)² means (−3) × (−3)."}, Explanation := "3² = 9, then −3² = −9, then −9 + (−3) = −12, then −12 + (−10) = −22."},
        fnm_item{Id := "integer-ops/t5/029", Tier := 5, Prompt := "(−7)² − 5 + 7", Choices := array{"−51", "51", "−47", "52"}, Answer := 1, Feedback := array{"Right size, wrong sign. Which number is farther from 0?", "", "−3² means −(3 × 3). (−3)² means (−3) × (−3).", "Check your arithmetic."}, Explanation := "(−7)² = 49, then 49 − 5 = 44, then 44 + 7 = 51."},
        fnm_item{Id := "integer-ops/t5/030", Tier := 5, Prompt := "−4 − 6 ÷ 2 + (−6) × 3", Choices := array{"25", "−33", "−25", "−10"}, Answer := 2, Feedback := array{"Two negatives make a positive only when you multiply or divide.", "Do × and ÷ before + and −.", "", "× means groups: 4 × (−3) is 4 groups of −3, not 4 + (−3)."}, Explanation := "6 ÷ 2 = 3, then −6 × 3 = −18, then −4 − 3 = −7, then −7 + (−18) = −25."},
