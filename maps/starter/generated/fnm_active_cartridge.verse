        fnm_item{Id := "circles/t4/028", Tier := 4, Prompt := "A rug\'s distance around is 8π. Its area?", Choices := array{"16", "64π", "16π", "8π"}, Answer := 2, Feedback := array{"Don\'t drop π: it is part of every circle formula (use 3 if told).", "In π × r × r, r is the RADIUS. Use half the diameter.", "", "That\'s the circumference. Area is π × radius × radius."}, Explanation := "C = 2πr gives r = 8 ÷ 2 = 4. Area = π × 4 × 4 = 16π."},
        fnm_item{Id := "circles/t4/029", Tier := 4, Prompt := "Circle: circumference 6π. Radius?", Choices := array{"12", "6", "1.5", "3"}, Answer := 3, Feedback := array{"Going backward means undoing: divide here, don\'t multiply.", "The number beside π is the diameter. The radius is half of it.", "Halve just once: the radius is half the diameter.", ""}, Explanation := "C = 2πr, so the radius is 6 ÷ 2 = 3."},
        fnm_item{Id := "circles/t4/030", Tier := 4, Prompt := "Circle: circumference 48. Radius? Use 3 for π.", Choices := array{"8", "16", "24", "4"}, Answer := 0, Feedback := array{"", "The number beside π is the diameter. The radius is half of it.", "Don\'t forget π (3 here): C = 6 × radius, or 3 × diameter.", "Halve just once: the radius is half the diameter."}, Explanation := "C = 2 × 3 × radius = 6 × radius, so radius = 48 ÷ 6 = 8."},
        fnm_item{Id := "circles/t4/031", Tier := 4, Prompt := "Circle: circumference 12. Radius? Use 3 for π.", Choices := array{"4", "6", "1", "2"}, Answer := 3, Feedback := array{"The number beside π is the diameter. The radius is half of it.", "Don\'t forget π (3 here): C = 6 × radius, or 3 × diameter.", "Halve just once: the radius is half the diameter.", ""}, Explanation := "C = 2 × 3 × radius = 6 × radius, so radius = 12 ÷ 6 = 2."},
        fnm_item{Id := "circles/t4/032", Tier := 4, Prompt := "Radius 3. Area? Use 3 for π.", Choices := array{"27", "108", "9", "18"}, Answer := 0, Feedback := array{"", "Square the radius as given: π × r × r. Don\'t double it first.", "Area needs r × r: square the radius, don\'t just use it.", "That\'s the circumference. Area is π × radius × radius."}, Explanation := "Area = 3 × radius × radius: radius 3, 3 × 3 = 9, 3 × 9 = 27."},
        fnm_item{Id := "circles/t4/033", Tier := 4, Prompt := "A wheel\'s circumference is 3π. Its diameter?", Choices := array{"1.5", "6", "1", "3"}, Answer := 3, Feedback := array{"The number beside π is the diameter itself, not half of it.", "Going backward means undoing: divide here, don\'t multiply.", "Check your arithmetic.", ""}, Explanation := "C = π × diameter, so 3π means the diameter is 3."},
        fnm_item{Id := "circles/t4/034", Tier := 4, Prompt := "A pond\'s distance around is 4π. Its radius?", Choices := array{"1", "2", "4", "8"}, Answer := 1, Feedback := array{"Halve just once: the radius is half the diameter.", "", "The number beside π is the diameter. The radius is half of it.", "Going backward means undoing: divide here, don\'t multiply."}, Explanation := "C = 2πr, so the radius is 4 ÷ 2 = 2."},
        fnm_item{Id := "circles/t4/035", Tier := 4, Prompt := "A rug\'s distance around is 12π. Its area?", Choices := array{"12π", "144π", "36", "36π"}, Answer := 3, Feedback := array{"That\'s the circumference. Area is π × radius × radius.", "In π × r × r, r is the RADIUS. Use half the diameter.", "Don\'t drop π: it is part of every circle formula (use 3 if told).", ""}, Explanation := "C = 2πr gives r = 12 ÷ 2 = 6. Area = π × 6 × 6 = 36π."},
        fnm_item{Id := "circles/t4/036", Tier := 4, Prompt := "A wheel\'s circumference is 54. Its radius? Use 3 for π.", Choices := array{"18", "27", "4.5", "9"}, Answer := 3, Feedback := array{"The number beside π is the diameter. The radius is half of it.", "Don\'t forget π (3 here): C = 6 × radius, or 3 × diameter.", "Halve just once: the radius is half the diameter.", ""}, Explanation := "C = 2 × 3 × radius = 6 × radius, so radius = 54 ÷ 6 = 9."},
        fnm_item{Id := "circles/t4/037", Tier := 4, Prompt := "A pond\'s distance around is 30. Diameter? Use 3 for π.", Choices := array{"90", "10", "30", "5"}, Answer := 1, Feedback := array{"Going backward means undoing: divide here, don\'t multiply.", "", "Don\'t forget π (3 here): C = 6 × radius, or 3 × diameter.", "The number beside π is the diameter itself, not half of it."}, Explanation := "C = 3 × diameter, so diameter = 30 ÷ 3 = 10."},
        fnm_item{Id := "circles/t4/038", Tier := 4, Prompt := "A rug has diameter 6. Its area? Use 3 for π.", Choices := array{"108", "27", "9", "18"}, Answer := 1, Feedback := array{"In π × r × r, r is the RADIUS. Use half the diameter.", "", "Area needs r × r: square the radius, don\'t just use it.", "That\'s the circumference. Area is π × radius × radius."}, Explanation := "Area = 3 × radius × radius: radius 3, 3 × 3 = 9, 3 × 9 = 27."},
        fnm_item{Id := "circles/t4/039", Tier := 4, Prompt := "Radius 9. Circumference? Use 3 for π.", Choices := array{"18", "27", "54", "243"}, Answer := 2, Feedback := array{"Don\'t drop π: it is part of every circle formula (use 3 if told).", "Circumference = π × diameter. The radius is only half of that.", "", "That\'s the area. Circumference goes around the edge: 2πr, or π × diameter."}, Explanation := "C = 2 × 3 × radius: 2 × 3 = 6, 6 × 9 = 54."},
        fnm_item{Id := "circles/t4/040", Tier := 4, Prompt := "A pond has radius 10. Distance around it? Use 3 for π.", Choices := array{"20", "30", "300", "60"}, Answer := 3, Feedback := array{"Don\'t drop π: it is part of every circle formula (use 3 if told).", "Circumference = π × diameter. The radius is only half of that.", "That\'s the area. Circumference goes around the edge: 2πr, or π × diameter.", ""}, Explanation := "C = 2 × 3 × radius: 2 × 3 = 6, 6 × 10 = 60."},
        fnm_item{Id := "circles/t5/001", Tier := 5, Prompt := "Quarter circle: radius 10. Area?", Choices := array{"5π", "100π", "25π", "50π"}, Answer := 2, Feedback := array{"Area needs r × r: square the radius, don\'t just use it.", "That\'s the whole circle. Take only the half or quarter you need.", "", "A quarter is 1/4 of the circle, not 1/2."}, Explanation := "A quarter circle is (r ÷ 2) × (r ÷ 2) × π: 10 ÷ 2 = 5, 5 × 5 = 25, so 25π."},
        fnm_item{Id := "circles/t5/002", Tier := 5, Prompt := "A quarter-circle garden has radius 8. Its area?", Choices := array{"4π", "64π", "16π", "32π"}, Answer := 2, Feedback := array{"Area needs r × r: square the radius, don\'t just use it.", "That\'s the whole circle. Take only the half or quarter you need.", "", "A quarter is 1/4 of the circle, not 1/2."}, Explanation := "A quarter circle is (r ÷ 2) × (r ÷ 2) × π: 8 ÷ 2 = 4, 4 × 4 = 16, so 16π."},
        fnm_item{Id := "circles/t5/003", Tier := 5, Prompt := "A quarter-circle rug has radius 4. Its area?", Choices := array{"π", "4π", "2π", "16π"}, Answer := 1, Feedback := array{"Take 1/4 of the area, not 1/4 of the radius.", "", "Area needs r × r: square the radius, don\'t just use it.", "That\'s the whole circle. Take only the half or quarter you need."}, Explanation := "A quarter circle is (r ÷ 2) × (r ÷ 2) × π: 4 ÷ 2 = 2, 2 × 2 = 4, so 4π."},
        fnm_item{Id := "circles/t5/004", Tier := 5, Prompt := "Semicircle: radius 4. Perimeter, flat side included?", Choices := array{"8π + 8", "4π + 4", "4π", "4π + 8"}, Answer := 3, Feedback := array{"Only half the circumference is curved. Then add the diameter.", "The flat side is the whole diameter, not just the radius.", "Perimeter also includes the flat side: add the diameter.", ""}, Explanation := "Curved edge πr = 4π, flat side = diameter = 2 × 4 = 8. Total 4π + 8."},
        fnm_item{Id := "circles/t5/005", Tier := 5, Prompt := "A half-circle window has radius 3. Curved edge length?", Choices := array{"π", "6π", "3π", "3π + 6"}, Answer := 2, Feedback := array{"Check your arithmetic.", "That\'s the whole circle. Take only the half or quarter you need.", "", "That adds the flat side. The curved edge alone is just the curve."}, Explanation := "Half of the circumference 2πr is πr = 3π."},
        fnm_item{Id := "circles/t5/006", Tier := 5, Prompt := "A quarter-circle rug has radius 6. Its area?", Choices := array{"3π", "36π", "9π", "18π"}, Answer := 2, Feedback := array{"Area needs r × r: square the radius, don\'t just use it.", "That\'s the whole circle. Take only the half or quarter you need.", "", "A quarter is 1/4 of the circle, not 1/2."}, Explanation := "A quarter circle is (r ÷ 2) × (r ÷ 2) × π: 6 ÷ 2 = 3, 3 × 3 = 9, so 9π."},
        fnm_item{Id := "circles/t5/007", Tier := 5, Prompt := "A quarter of a circle has radius 10. Its area?", Choices := array{"25π", "50π", "100π", "5π"}, Answer := 0, Feedback := array{"", "A quarter is 1/4 of the circle, not 1/2.", "That\'s the whole circle. Take only the half or quarter you need.", "Area needs r × r: square the radius, don\'t just use it."}, Explanation := "A quarter circle is (r ÷ 2) × (r ÷ 2) × π: 10 ÷ 2 = 5, 5 × 5 = 25, so 25π."},
