        fnm_item{Id := "circles/t3/019", Tier := 3, Prompt := "Radius quadruples. Area is how many times as big?", Choices := array{"1", "4", "16", "64"}, Answer := 2, Feedback := array{"Check your arithmetic.", "Area uses r × r, so it grows by the scale factor squared.", "", "Cubing is for volume. Lengths scale by k, areas by k × k."}, Explanation := "Area uses r × r, so the factor is squared: 4 × 4 = 16."},
        fnm_item{Id := "circles/t3/020", Tier := 3, Prompt := "A pizza has diameter 10. Its area?", Choices := array{"25π", "10π", "5π", "100π"}, Answer := 0, Feedback := array{"", "That\'s the circumference. Area is π × radius × radius.", "Area needs r × r: square the radius, don\'t just use it.", "In π × r × r, r is the RADIUS. Use half the diameter."}, Explanation := "Radius = 10 ÷ 2 = 5. Area = π × 5 × 5 = 25π."},
