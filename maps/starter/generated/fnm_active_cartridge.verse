        fnm_item{Id := "integer-ops/t5/014", Tier := 5, Prompt := "(−5² − (−4)) ÷ 7", Choices := array{"−3", "−1", "−147", "3"}, Answer := 0, Feedback := array{"", "Check your arithmetic.", "Divide, don\'t multiply: −12 ÷ 3 asks what times 3 makes −12.", "One negative makes it negative. Two negatives make it positive."}, Explanation := "5² = 25, then −5² = −25, then −25 − (−4) = −21, then −21 ÷ 7 = −3."},
        fnm_item{Id := "integer-ops/t5/015", Tier := 5, Prompt := "−5 + (−8 − (−3) × 4) × (−3)", Choices := array{"55", "−65", "75", "−17"}, Answer := 3, Feedback := array{"Subtracting a negative is adding: 4 − (−6) = 4 + 6.", "One negative makes it negative. Two negatives make it positive.", "Do × and ÷ before + and −.", ""}, Explanation := "−3 × 4 = −12, then −8 − (−12) = 4, then 4 × (−3) = −12, then −5 + (−12) = −17."},
        fnm_item{Id := "integer-ops/t5/016", Tier := 5, Prompt := "−10 + (−3) + (−4 + (−8) × (−7))", Choices := array{"71", "39", "65", "73"}, Answer := 1, Feedback := array{"Do × and ÷ before + and −.", "", "Two negatives make a positive only when you multiply or divide.", "Different signs: subtract the sizes, keep the sign of the bigger one."}, Explanation := "−8 × (−7) = 56, then −4 + 56 = 52, then −10 + (−3) = −13, then −13 + 52 = 39."},
