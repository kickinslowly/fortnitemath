        fnm_item{Id := "equations-inequalities/t5/009", Tier := 5, Prompt := "Fewer than 13 seats, s, are left. Which fits?", Choices := array{"s ≤ 13", "s \> 13", "s \< 13", "s ≥ 13"}, Answer := 2, Feedback := array{"At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "Less than 13: s \< 13. 13 itself does not count, so no line under the sign."},
