        fnm_item{Id := "percent-problems/t5/008", Tier := 5, Prompt := "$40 coat, 50% off, then 20% tax. Cost?", Choices := array{"$40", "$28", "$24", "$20"}, Answer := 2, Feedback := array{"The % number is not dollars. Find that percent OF the price first.", "Do one percent at a time. The second is of the new price, not the original.", "", "There is a second step. Take the second percent of the new price too."}, Explanation := "50% is half of $40: $20; $40 − $20 = $20. 10% of $20 is $2, so 20% is $4; $20 + $4 = $24."},
        fnm_item{Id := "percent-problems/t5/009", Tier := 5, Prompt := "Scale shows 21 lb. True weight: 30 lb. Percent error?", Choices := array{"30%", "70%", "25%", "9%"}, Answer := 0, Feedback := array{"", "That is guess compared to actual. Percent error is only the miss.", "Check your arithmetic.", "A change of 5 is not 5%. Divide the change by the original (or actual) value."}, Explanation := "Miss: 30 − 21 = 9. Compare with the actual 30. 10% of 30 is 3; 9 is 3 of those, so 30%."},
        fnm_item{Id := "percent-problems/t5/010", Tier := 5, Prompt := "$40 shirt, 25% off, then 20% off that. Price?", Choices := array{"$22", "$36", "$24", "$30"}, Answer := 2, Feedback := array{"Do one percent at a time. The second is of the new price, not the original.", "Check the direction: tax and markups add, discounts take away.", "", "There is a second step. Take the second percent of the new price too."}, Explanation := "25% is 1/4 of $40: $10; $40 − $10 = $30. 10% of $30 is $3, so 20% is $6; $30 − $6 = $24."},
        fnm_item{Id := "percent-problems/t5/011", Tier := 5, Prompt := "The $50 game is 20% off, then 20% tax. Total?", Choices := array{"$32", "$48", "$40", "$50"}, Answer := 1, Feedback := array{"Check the direction: tax and markups add, discounts take away.", "", "There is a second step. Take the second percent of the new price too.", "Do one percent at a time. The second is of the new price, not the original."}, Explanation := "10% of $50 is $5, so 20% is $10; $50 − $10 = $40. 10% of $40 is $4, so 20% is $8; $40 + $8 = $48."},
        fnm_item{Id := "percent-problems/t5/012", Tier := 5, Prompt := "$40 shirt, 50% off, then 20% off that. Price?", Choices := array{"$20", "$16", "$12", "$24"}, Answer := 1, Feedback := array{"There is a second step. Take the second percent of the new price too.", "", "Do one percent at a time. The second is of the new price, not the original.", "Check the direction: tax and markups add, discounts take away."}, Explanation := "50% is half of $40: $20; $40 − $20 = $20. 10% of $20 is $2, so 20% is $4; $20 − $4 = $16."},
        fnm_item{Id := "percent-problems/t5/013", Tier := 5, Prompt := "Cost $24, marked up 25%, then 20% off that. Price?", Choices := array{"$10", "$30", "$24", "$36"}, Answer := 2, Feedback := array{"The % number is not dollars. Find that percent OF the price first.", "There is a second step. Take the second percent of the new price too.", "", "Check the direction: tax and markups add, discounts take away."}, Explanation := "25% is 1/4 of $24: $6; $24 + $6 = $30. 10% of $30 is $3, so 20% is $6; $30 − $6 = $24."},
        fnm_item{Id := "percent-problems/t5/014", Tier := 5, Prompt := "$50 shirt, 20% off, then 20% off that. Price?", Choices := array{"$20", "$30", "$40", "$32"}, Answer := 3, Feedback := array{"The % number is not dollars. Find that percent OF the price first.", "Do one percent at a time. The second is of the new price, not the original.", "There is a second step. Take the second percent of the new price too.", ""}, Explanation := "10% of $50 is $5, so 20% is $10; $50 − $10 = $40. 10% of $40 is $4, so 20% is $8; $40 − $8 = $32."},
        fnm_item{Id := "percent-problems/t5/015", Tier := 5, Prompt := "$20 shirt, 40% off, then 25% off that. Price?", Choices := array{"$15", "$9", "$7", "$12"}, Answer := 1, Feedback := array{"Check the direction: tax and markups add, discounts take away.", "", "Do one percent at a time. The second is of the new price, not the original.", "There is a second step. Take the second percent of the new price too."}, Explanation := "10% of $20 is $2, so 40% is $8; $20 − $8 = $12. 25% is 1/4 of $12: $3; $12 − $3 = $9."},
        fnm_item{Id := "percent-problems/t5/016", Tier := 5, Prompt := "The $32 item is marked up 25%, then 25% off that. Price?", Choices := array{"$40", "$32", "$15", "$30"}, Answer := 3, Feedback := array{"There is a second step. Take the second percent of the new price too.", "Do one percent at a time. The second is of the new price, not the original.", "The % number is not dollars. Find that percent OF the price first.", ""}, Explanation := "25% is 1/4 of $32: $8; $32 + $8 = $40. 25% is 1/4 of $40: $10; $40 − $10 = $30."},
        fnm_item{Id := "percent-problems/t5/017", Tier := 5, Prompt := "$40 jacket, 30% off, then 25% off the sale price. Price?", Choices := array{"$18", "$21", "$35", "$28"}, Answer := 1, Feedback := array{"Do one percent at a time. The second is of the new price, not the original.", "", "Check the direction: tax and markups add, discounts take away.", "There is a second step. Take the second percent of the new price too."}, Explanation := "10% of $40 is $4, so 30% is $12; $40 − $12 = $28. 25% is 1/4 of $28: $7; $28 − $7 = $21."},
        fnm_item{Id := "percent-problems/t5/018", Tier := 5, Prompt := "The $16 item is marked up 25%, then 20% off that. Price?", Choices := array{"$24", "$16", "$14", "$20"}, Answer := 1, Feedback := array{"Check the direction: tax and markups add, discounts take away.", "", "Check your arithmetic.", "There is a second step. Take the second percent of the new price too."}, Explanation := "25% is 1/4 of $16: $4; $16 + $4 = $20. 10% of $20 is $2, so 20% is $4; $20 − $4 = $16."},
        fnm_item{Id := "percent-problems/t5/019", Tier := 5, Prompt := "$20 jacket, 40% off, then 25% off the sale price. Price?", Choices := array{"$9", "$7", "$12", "$15"}, Answer := 0, Feedback := array{"", "Do one percent at a time. The second is of the new price, not the original.", "There is a second step. Take the second percent of the new price too.", "Check the direction: tax and markups add, discounts take away."}, Explanation := "10% of $20 is $2, so 40% is $8; $20 − $8 = $12. 25% is 1/4 of $12: $3; $12 − $3 = $9."},
        fnm_item{Id := "percent-problems/t5/020", Tier := 5, Prompt := "$50 coat, 40% off, then 20% tax. Cost?", Choices := array{"$24", "$30", "$40", "$36"}, Answer := 3, Feedback := array{"Check the direction: tax and markups add, discounts take away.", "There is a second step. Take the second percent of the new price too.", "Do one percent at a time. The second is of the new price, not the original.", ""}, Explanation := "10% of $50 is $5, so 40% is $20; $50 − $20 = $30. 10% of $30 is $3, so 20% is $6; $30 + $6 = $36."},
        fnm_item{Id := "percent-problems/t5/021", Tier := 5, Prompt := "Measured 10 cm. True length: 8 cm. Percent error?", Choices := array{"20%", "125%", "2%", "25%"}, Answer := 3, Feedback := array{"Percent error compares the miss with the ACTUAL value, not the guess.", "That is guess compared to actual. Percent error is only the miss.", "A change of 5 is not 5%. Divide the change by the original (or actual) value.", ""}, Explanation := "Miss: 10 − 8 = 2. Compare with the actual 8. 2 is 1/4 of 8, so 25%."},
