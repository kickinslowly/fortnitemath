        fnm_item{Id := "equations-inequalities/t5/029", Tier := 5, Prompt := "Rider age a must be at least 7 years. Which fits?", Choices := array{"a ≥ 7", "a ≤ 7", "a \> 7", "a \< 7"}, Answer := 0, Feedback := array{"", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "At least / at most include the number (≥ ≤). More / fewer than do not.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "7 or more: a ≥ 7. 7 itself counts, so the line goes under the sign."},
        fnm_item{Id := "equations-inequalities/t5/030", Tier := 5, Prompt := "Which is a solution of x \> 8?", Choices := array{"5", "10", "7", "8"}, Answer := 1, Feedback := array{"Plug it in: the statement comes out false. Pick from the other side.", "", "Plug it in: the statement comes out false. Pick from the other side.", "\< and \> leave out the number itself: 4 \< 4 is false."}, Explanation := "Try 10: 10 \> 8 is true. 8 \> 8 is false: 8 is not a solution."},
