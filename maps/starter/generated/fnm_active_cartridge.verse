        fnm_item{Id := "equations-inequalities/t5/034", Tier := 5, Prompt := "Which makes 9k \< 54 true?", Choices := array{"7", "8", "6", "4"}, Answer := 3, Feedback := array{"Plug it in: the statement comes out false. Pick from the other side.", "Plug it in: the statement comes out false. Pick from the other side.", "\< and \> leave out the number itself: 4 \< 4 is false.", ""}, Explanation := "Try 4: 9 × 4 = 36, and 36 \< 54 is true. 9 × 6 = 54, and 54 \< 54 is false."},
        fnm_item{Id := "equations-inequalities/t5/035", Tier := 5, Prompt := "Which makes 9 \< y true?", Choices := array{"9", "8", "12", "7"}, Answer := 2, Feedback := array{"\< and \> leave out the number itself: 4 \< 4 is false.", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more.", "", "Check the direction. Read from the letter: p ≥ 12 means p is 12 or more."}, Explanation := "9 \< y means y \> 9. Try 12: 9 \< 12 is true. 9 \> 9 is false: 9 is not a solution."},
