        fnm_item{Id := "fraction-division/t5/025", Tier := 5, Prompt := "How many 1/8 mi laps make a 3/4 mi run?", Choices := array{"3/32", "6", "1/6", "10 2/3"}, Answer := 1, Feedback := array{"You multiplied as is. To divide, multiply by the flipped divisor.", "", "Backwards: start with the amount you have, then divide it.", "Flip only the second fraction. The first one stays as it is."}, Explanation := "Groups of 1/8 in 3/4: 3/4 ÷ 1/8 = 3/4 × 8 = 24/4 = 6."},
